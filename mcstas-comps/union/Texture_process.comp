/*******************************************************************************
*
*  McStas, neutron ray-tracing package
*  Copyright(C) 2007 Risoe National Laboratory.
*
* Component: Texture_process
*
* %I
* Written by: Victor Laliena, and expanded upon by Daniel Lomholt Christensen
* Date: 2018-2019 and 2026-2027
* Origin: University of Zaragoza and subsequently the University of Copenhagen, funded by the ACTNXT program
*
* Component for simulating textured and strained mono-crystalline materials and polycrystalline materials in Union components
*
* %D
*
* Part of the Union components, a set of components that work together and thus
* seperates geometry and physics within McStas.
* The use of this component requires other components to be used.
*
* This component deals with the coherent elastic scattering on a textured material.
* The texture is described through the coefficients of the generalized Fourier transform
* of the Orientation Distribution Function (ODF).
* The component expects as input two files, one containing the Fourier coefficients of the
* ODF and another one with crystallographic and physical information.
*
*
* CIF and NCrystal inputs can give hundreds of reflections, and the tables use about 1 MB for
* each reflection, so set lambda_min, or dcutoff in the NCrystal cfg-string, to what the instrument reaches.
* An NCrystal material must have one crystalline phase and no orientation, as that is given by the
* placement of the component. CIF files are converted with ncrystal_cif2ncmat, which needs the Python
* modules gemmi and spglib and uses a Debye temperature of 300 K when it has no other atomic dynamics. Run
* ncrystal_cif2ncmat directly and use the resulting NCMAT file to set this. Each family of reflections is described by one of its members, so the
* ODF must have the crystal symmetry applied.
*
* The ODF rotates the Cartesian crystal axes into the axes of
* the component. By default the crystal axes are those of NCrystal: x || a, b in the xy plane,
* so z || c*. mtex_axes = 1 takes the default axes of MTEX instead: z || c, x || a*. Both are
* the same for cubic, tetragonal and orthorhombic lattices; for hexagonal and trigonal
* lattices they differ by 30 deg about c.
* ax, ay, az, bx, by, bz and cx, cy, cz place the crystal axes instead, as for a single crystal, by
* the directions in the component of two or three of the lattice vectors a, b and c; a vector that
* is not given is left 0. With two, the first of the two in the order a, b, c points along its
* direction, and the second lies in the plane of the two directions, at the angle from the first
* given by crystal_fn. With three, each lattice vector points along its direction; the angles between
* the directions must be those of crystal_fn within 1e-4 rad, and a, b, c must be right-handed.
* Only the directions are used, the lengths come from crystal_fn. With all of them 0, the NCrystal
* axes are used. For example, ax = 0, ay = 1, az = 0, bx = -1, by = 0, bz = 0 turns the crystal axes
* by 90 deg about z.
*
* The coefficients of an orientation list, e.g. from EBSD, or of orientations drawn from
* rotation expressions, are computed beforehand with share/texture-coefficients.py.
*
* Algorithm:
* Described elsewhere, see e.g. <a href="https://doi.org/10.3233/JNR-190117">https://doi.org/10.3233/JNR-190117</a>
* The calculations are detailed in V. Laliena, M. A. Vicente-Alvarez and J. Campo,
* J. Appl. Cryst. 53, 512-529 (2020), <a href="https://doi.org/10.1107/S1600576720002290">https://doi.org/10.1107/S1600576720002290</a>
*
* %P
* INPUT PARAMETERS:
* packing_factor:    [1]      How dense is the material compared to optimal 0-1
* interact_fraction: [1]      How large a part of the scattering events should use this process 0-1 (sum of all processes in material = 1)
* crystal_fn:        [s]      Crystallographic information: a reflection file (LAZ, LAU), a CIF file, or an NCrystal cfg-string (containing ".ncmat" or "::")
* fcoef_fn:          [s]      Path to a text file containing the Fourier coefficients of the ODF. It must have five columns: l m n Real(Clmn) Imag(Clmn)
* lmax_user:         [1]      Cut-off for the Fourier series. If negative, the program uses all the coefficients provided in the file fcoef_fn. Values above the lmax of fcoef_fn also use all of them.
* barns:             [1]      Flag to indicate if |F|^2 from 'crystal_fn' is in barns or fm^2. barns=1 for laz and isotropic constant elastic scattering (reflections=NULL), barns=0 for lau type files. Always barns for CIF files and NCrystal cfg-strings
* lambda_min:        [AA]     Reflections that only scatter below this wavelength are not used, which saves one table per l for each of them. 0 keeps all reflections
* mtex_axes:         [1]      0: crystal axes of NCrystal (x || a, b in the xy plane), 1: default crystal axes of MTEX (z || c, x || a*), for an ODF given in them
* ax:                [1]      x of the direction of the lattice vector a in the component. Give two or three of a, b and c, or none; not with mtex_axes = 1
* ay:                [1]      y of the direction of a
* az:                [1]      z of the direction of a
* bx:                [1]      x of the direction of the lattice vector b in the component
* by:                [1]      y of the direction of b
* bz:                [1]      z of the direction of b
* cx:                [1]      x of the direction of the lattice vector c in the component
* cy:                [1]      y of the direction of c
* cz:                [1]      z of the direction of c
* init:              [string]    Deprecated and unused. Accepted so that instruments written for McStas/McXtrace 3.8.7 and earlier, which name the Union_init component here, still compile.
*
* %L
* See <a href="https://doi.org/10.3233/JNR-190117">https://doi.org/10.3233/JNR-190117</a>
* V. Laliena, M. A. Vicente-Alvarez and J. Campo, "Monte Carlo simulation of neutron scattering by a textured polycrystal",
* J. Appl. Cryst. 53, 512-529 (2020), <a href="https://doi.org/10.1107/S1600576720002290">https://doi.org/10.1107/S1600576720002290</a>
*
* %E
******************************************************************************/

DEFINE COMPONENT Texture_process // Remember to change the name of process here

SETTING PARAMETERS(string crystal_fn=0, string fcoef_fn=0, int lmax_user=-1, int mtex_axes=0,
            ax=0, ay=0, az=0, bx=0, by=0, bz=0, cx=0, cy=0, cz=0,
            barns = 0, interact_fraction = -1, packing_factor = 1, lambda_min = 0,
	        string init="")


DEPENDENCY "@NCRYSTALFLAGS@"

SHARE
%{
  %include "union-lib"

  %include "read_table-lib"
  %include "special-functions-lib"
  %include "mccode-ncrystal-lib"

  #ifndef TEXTURE_PROCESS_DECL
  #define TEXTURE_PROCESS_DECL

  // azimuthal sampling table of kf for one reflection and one wavevector
  struct phiTable {
    int built;             // 0 until the table is computed for the wavevector of its cache entry
    Coords kih;            // unit vector of ki
    Coords t1, t2;         // complete kih to a right-handed basis (t1,t2,kih)
    double kim;            // modulus of ki
    double stheta, ctheta; // sine and cosine of the scattering angle
    double maxProb;
    double *aa, *bb;       // probability aa[j] + phi * bb[j] of the azimuth phi between points j and j + 1
  };

  // everything computed for one wavevector
  struct kiCache {
    Coords ki;
    int last_hkl;          // index of the last reflection below the Bragg cutoff, -1 if none
    double cohMu;          // linear attenuation coefficient (m^-1)
    double* XS_ki;         // cross section of each reflection alone
    struct phiTable* phi;  // sampling table of each reflection
  };

  struct fourier_coef {
    int lmax;
    double ***cr, ***ci;
  };

  struct legendre {
    int lmax;
    t_Table* Plm; // per l: scaled_associated_legendre on a uniform grid in x, with one column per m
    // axes of the pole density tables, uniform in cos(theta) and phi
    int n_ct, n_phi;
    double* ctAxis;
    double* phiAxis;
  };

  struct hkl_data_texture {
    int h, k, l;          // Indices for this reflection
    int mult;             // Multiplicity of the line
    double F2;            // Value of square of structure factor
    double G, Gct, Gphi;  // polar coordinates of G [Gct=cos(theta)]
    // total cross section: sum_m scaled_associated_legendre (l, m, kct) (Ac cos (m kphi) + As sin (m kphi)) at [l * (lmax + 1) + m], m >= 0
    double *Ac, *As;
    // To obtain cross sections
    int numV;
    int *lv, *mv;
    double *RV, *phiV;
    // to sample kprime
    // precomputed Q distribution
    t_Table probQ;
    double probQmax; // largest value of probQ
    // number of negative cross sections from the truncated series
    double numNegativeXS;
  };

  struct hkl_info_struct_texture {
    // data structures
    int num_hkl;                   // Number of reflections hkl taken into account
    struct hkl_data_texture* list; // Reflection array
    struct legendre* lgdr;         // structure with precomputed spherical harmonics
    int lmax;                      // cut-off for the Fourier expansion

    double V0;             // Unit cell volume (AA**3)
    Coords lat[3];         // direct lattice vectors (AA) in the Cartesian crystal frame
    int flag_barns;        // |F|^2 is in barns whatever the barns parameter is
    int use_mtex_axes;     // crystal axes z || c, x || a* instead of x || a, b in the xy plane
    Coords crys_axis[3];   // directions of the lattice vectors a, b, c in the component, (0, 0, 0) if not given
    double wavelength_min; // Reflections only scattering below this wavelength are not used

    // precomputed factors
    double xs2mu; // cross section to mu (in m^-1)

    double tol_V;        // terms of V with a smaller modulus are dropped
    double* sqn;         // sqrt ((l - m)! / (l + m)!) at [l * (lmax + 1) + m]
    double* plm;         // scaled_associated_legendre (l, m, kct) of the wavevector of the last cache fill, same index
    double *cm, *sm;     // cos (m kphi) and sin (m kphi) of that wavevector
    int n_phi_points;    // points of the azimuthal sampling tables of kf
    int phi_table;       // 1: azimuthal table of kf for each wavevector (lmax >= 20), 0: rejection on probQ directly
    int max_iter_reject; // tries of the rejection sampling of kf before giving up

    // everything computed for the last n_saved wavevectors, most recently used first,
    // so that the SPLIT copies of a neutron reuse it
    int n_saved;
    struct kiCache* saved;
  };

  /////////////////////////////////////////
  // auxiliary functions
  //////////////////////////////////////////

  int
  SX_list_compare_texture (void const* a, void const* b) {
    struct hkl_data_texture const* pa = a;
    struct hkl_data_texture const* pb = b;
    double s = pa->G - pb->G;

    if (!s) {
      return 0;
    } else {
      return (s < 0 ? -1 : 1);
    }
  } // SX_list_compare

  // Linear interpolation of scaled_associated_legendre in the table of order l
  double
  plmValue (int l, int m, double x, struct legendre* lgdr) {
    t_Table* table = lgdr->Plm + l;
    long nx = table->rows;
    long ncol = table->columns;
    double dx = 2.0 / (nx - 1);
    long j;

    x = fmin (1.0, fmax (-1.0, x));
    j = (long)((x + 1.0) / dx);
    if (j > nx - 2) {
      j = nx - 2;
    }
    return Table_Interp1d (x, -1.0 + j * dx, table->data[j * ncol + l + m], -1.0 + (j + 1) * dx, table->data[(j + 1) * ncol + l + m]);
  }

  // Bilinear interpolation in a pole density table
  double
  interp2D (double x, double y, struct legendre* lgdr, t_Table* table) {
    int i, j;
    double* xp = lgdr->ctAxis;
    double* yp = lgdr->phiAxis;
    double* f;

    i = (int)((x - xp[0]) / (xp[1] - xp[0]));
    j = (int)((y - yp[0]) / (yp[1] - yp[0]));

    if (i < 0 || i >= lgdr->n_ct - 1) {
      if (i == lgdr->n_ct - 1 && fabs (x - xp[i]) < 1.0e-6) {
        i = i - 1;
      } else {
        fprintf (stderr, "Texture_process: cos(theta) = %.16e outside the table. Exit!\n", x);
        exit (-1);
      }
    } else if (i > 0 && x < xp[i]) {
      i = i - 1;
    }

    if (j < 0 || j >= lgdr->n_phi - 1) {
      if (j == lgdr->n_phi - 1 && fabs (y - yp[j]) < 1.0e-6) {
        j = j - 1;
      } else {
        fprintf (stderr, "Texture_process: phi = %.16e outside the table. Exit!\n", y);
        exit (-1);
      }
    } else if (j > 0 && y < yp[j]) {
      j = j - 1;
    }

    f = table->data + i * lgdr->n_phi + j;
    return Table_Interp2d (x, y, xp[i], yp[j], xp[i + 1], yp[j + 1], f[0], f[1], f[lgdr->n_phi], f[lgdr->n_phi + 1]);
  }

  /////////////////////
  /// legendre     ////
  /////////////////////

  struct legendre*
  initLegendre (int lmax) {
    int j, l, m, nx;
    double x, dx;
    struct legendre* lgdr;

    lgdr = (struct legendre*)malloc (sizeof (struct legendre));
    if (!lgdr) {
      fprintf (stderr, "Texture_process: Failed struct malloc() in initLegendre. Exit!\n");
      exit (-1);
    }
    lgdr->lmax = lmax;
    lgdr->Plm = (t_Table*)malloc ((lmax + 1) * sizeof (t_Table));
    if (!lgdr->Plm) {
      fprintf (stderr, "Texture_process: Failed malloc() in initLegendre. Exit!\n");
      exit (-1);
    }
    for (l = 0; l <= lmax; l++) {
      nx = 100 * (l + 1);
      dx = 2.0 / (nx - 1);
      Table_Init (lgdr->Plm + l, nx, 2 * l + 1);
      for (j = 0; j < nx; j++) {
        x = (j < nx - 1 ? -1.0 + j * dx : 1.0);
        for (m = -l; m <= l; m++) {
          lgdr->Plm[l].data[j * (2 * l + 1) + l + m] = scaled_associated_legendre (l, m, x);
        }
      }
    }

    lgdr->n_ct = 201;
    lgdr->n_phi = 601;
    lgdr->ctAxis = (double*)malloc (lgdr->n_ct * sizeof (double));
    lgdr->phiAxis = (double*)malloc (lgdr->n_phi * sizeof (double));
    if (!lgdr->ctAxis || !lgdr->phiAxis) {
      fprintf (stderr, "Texture_process: Failed malloc() in initLegendre. Exit!\n");
      exit (-1);
    }
    dx = 2.0 / (lgdr->n_ct - 1);
    for (j = 0; j < lgdr->n_ct - 1; j++) {
      lgdr->ctAxis[j] = -1.0 + j * dx;
    }
    lgdr->ctAxis[lgdr->n_ct - 1] = 1.0;
    dx = (2.0 * PI) / (lgdr->n_phi - 1);
    for (j = 0; j < lgdr->n_phi - 1; j++) {
      lgdr->phiAxis[j] = -PI + j * dx;
    }
    lgdr->phiAxis[lgdr->n_phi - 1] = PI;

    return lgdr;
  }

  // end legendre

  /////////////////////////////
  ////// Cross sections     ///
  /////////////////////////////

  // Total cross section of L at wavevector modulus k, with info->plm, cm, sm filled for its direction
  double
  total_hkl_XS (double k, struct hkl_data_texture* L, struct hkl_info_struct_texture* info) {
    int l, m;
    int n = info->lmax + 1;
    double x = (L->G) / (2 * k);
    double XS, ul, pl, pl_prev, pl_next;
    double *Ac, *As, *plm;

    if (x > 1) {
      return 0;
    }

    // XS = 1 + sum_l P_l (x) Upsilon_l (kct, kphi), with the Legendre polynomials P_l from their recurrence
    XS = 1.0;
    pl_prev = 1.0;
    pl = x;
    for (l = 1; l <= info->lmax; l++) {
      Ac = L->Ac + l * n;
      As = L->As + l * n;
      plm = info->plm + l * n;
      ul = 0;
      for (m = 0; m <= l; m++) {
        ul += plm[m] * (Ac[m] * info->cm[m] + As[m] * info->sm[m]);
      }
      XS += pl * ul;
      pl_next = ((2 * l + 1) * x * pl - l * pl_prev) / (l + 1);
      pl_prev = pl;
      pl = pl_next;
    }

    if (XS < 0) {
      L->numNegativeXS += 1;
    }

    // this is not the cross section. A different name (reflectivity??)
    // would be appropriate
    // there is a missed factor N*(2*pi)**3/(v0*k**3), which is a constant
    // and then applied only at the end
    XS *= (L->mult) * (L->F2) / (4 * x);

    return XS;
  }

  // Ac, As of L from its V terms, with scaled_associated_legendre (l, -m) = (-1)^m scaled_associated_legendre (l, m)
  void
  xsCoefficients (struct hkl_data_texture* L, int lmax) {
    int i, l, m, ma;
    int n = lmax + 1;
    double s;

    L->Ac = (double*)calloc (n * n, sizeof (double));
    L->As = (double*)calloc (n * n, sizeof (double));
    if (!L->Ac || !L->As) {
      fprintf (stderr, "Texture_process: Failed malloc() in xsCoefficients. Exit!\n");
      exit (-1);
    }
    for (i = 0; i < L->numV; i++) {
      l = L->lv[i];
      m = L->mv[i];
      ma = abs (m);
      s = (m < 0 && ma % 2) ? -1 : 1;
      // cos (phiV - m kphi) = cos phiV cos (m kphi) + sin phiV sin (m kphi)
      L->Ac[l * n + ma] += s * L->RV[i] * cos (L->phiV[i]);
      L->As[l * n + ma] += s * (m < 0 ? -1 : 1) * L->RV[i] * sin (L->phiV[i]);
    }
  }

  int
  computeV (struct fourier_coef* fc, struct hkl_data_texture* L, double tol) {
    int i, l, m, n, numV;
    double Gct, Gphi, cnp, snp, pln, vr, vi;
    double **R, **Phi;

    int lmax = fc->lmax;

    Gct = L->Gct;
    Gphi = L->Gphi;

    R = (double**)malloc ((lmax + 1) * sizeof (double*));
    for (l = 0; l <= lmax; l++) {
      R[l] = (double*)malloc ((2 * l + 1) * sizeof (double));
    }
    Phi = (double**)malloc ((lmax + 1) * sizeof (double*));
    for (l = 0; l <= lmax; l++) {
      Phi[l] = (double*)malloc ((2 * l + 1) * sizeof (double));
    }

    // compute V

    numV = 0;
    for (l = 0; l <= lmax; l++) {
      for (m = -l; m <= l; m++) {
        vr = 0;
        vi = 0;
        for (n = -l; n <= l; n++) {
          pln = scaled_associated_legendre (l, n, Gct); // this can be interpolated from lgdr
          cnp = cos (n * Gphi);
          snp = sin (n * Gphi);
          vr += pln * ((fc->cr)[l][l + m][l + n] * cnp - (fc->ci)[l][l + m][l + n] * snp);
          vi += pln * ((fc->cr)[l][l + m][l + n] * snp + (fc->ci)[l][l + m][l + n] * cnp);
        }
        R[l][l + m] = sqrt (vr * vr + vi * vi);
        Phi[l][l + m] = atan2 (vi, vr);
        if (R[l][l + m] > tol) {
          numV++;
        }
      }
    }


    L->numV = numV;
    L->lv = (int*)malloc (numV * sizeof (int));
    L->mv = (int*)malloc (numV * sizeof (int));
    L->RV = (double*)malloc (numV * sizeof (double));
    L->phiV = (double*)malloc (numV * sizeof (double));

    i = -1;
    for (l = 0; l <= lmax; l++) {
      for (m = -l; m <= l; m++) {
        if (R[l][l + m] > tol) {
          i++;
          (L->lv)[i] = l;
          (L->mv)[i] = m;
          (L->RV)[i] = R[l][l + m];
          (L->phiV)[i] = Phi[l][l + m];
        }
      }
    }


    // free memory
    for (l = 0; l <= lmax; l++) {
      free (R[l]);
      free (Phi[l]);
    }
    free (R);
    free (Phi);


    return 0;
  }

  // end cross sections

  ////////////////////////////////
  /// Sampling                  //
  ////////////////////////////////

  // Unit vector of kf at azimuth phi around kih
  Coords
  kfDirection (struct phiTable* sp, double phi) {
    Coords cone = coords_add (coords_scale (sp->t1, sp->stheta * cos (phi)), coords_scale (sp->t2, sp->stheta * sin (phi)));
    return coords_add (cone, coords_scale (sp->kih, sp->ctheta));
  }

  // Samples kf for reflection L and wavevector ki by rejection on the pole density of q on the Bragg circle. With
  // info->phi_table, the density is tabulated at n points the first time sp is used for a wavevector and bounded by
  // its largest value there; otherwise it is read from probQ at each try and bounded by the largest value of probQ.
  int
  sampleKprime_hkl (double* kf, Coords ki, struct phiTable* sp, struct hkl_data_texture* L, struct hkl_info_struct_texture* info) {
    int it, j;
    int n = info->n_phi_points;
    double kdg, phi, p, p0, p1;
    double dphi = (2.0 * PI) / (n - 1);
    Coords q, kf_out;
    Coords dir = coords_set (0, 0, 0);

    kdg = coords_len (ki) / (L->G);
    if (!sp->built) {
      sp->built = 1;
      sp->kim = coords_len (ki);
      sp->kih = coords_scale (ki, 1.0 / sp->kim);

      sp->ctheta = 1.0 - 0.5 / (kdg * kdg);
      sp->stheta = sqrt (1.0 - sp->ctheta * sp->ctheta);

      // right-handed orthonormal triad
      normal_vec (&sp->t1.x, &sp->t1.y, &sp->t1.z, sp->kih.x, sp->kih.y, sp->kih.z);
      sp->t2 = coords_xp (sp->kih, sp->t1);

      if (info->phi_table) {
        // probability of the unitary scattering vector qh = kdg * (kih - kfh) at the n points, in aa
        sp->maxProb = -1.0e99;
        phi = -PI;
        for (j = 0; j < n - 1; j++) {
          q = coords_scale (coords_sub (sp->kih, kfDirection (sp, phi)), kdg);
          sp->aa[j] = interp2D (q.z, atan2 (q.y, q.x), info->lgdr, &L->probQ);
          if (sp->aa[j] > sp->maxProb) {
            sp->maxProb = sp->aa[j];
          }
          phi += dphi;
        }
        sp->aa[n - 1] = sp->aa[0];

        // linear interpolation between the points
        phi = -PI;
        for (j = 0; j < n - 1; j++) {
          p0 = sp->aa[j];
          p1 = sp->aa[j + 1];
          sp->aa[j] = p0 - phi * (p1 - p0) / dphi;
          sp->bb[j] = (p1 - p0) / dphi;
          phi += dphi;
        }
      }
    }

    // rejection method
    for (it = 0; it < info->max_iter_reject; it++) {
      phi = -PI + 2 * PI * rand01 ();
      if (info->phi_table) {
        j = (int)((PI + phi) / dphi);
        p = sp->aa[j] + phi * sp->bb[j];
        if (p / sp->maxProb > rand01 ()) {
          dir = kfDirection (sp, phi);
          break;
        }
      } else {
        dir = kfDirection (sp, phi);
        q = coords_scale (coords_sub (sp->kih, dir), kdg);
        p = interp2D (q.z, atan2 (q.y, q.x), info->lgdr, &L->probQ);
        if (p > rand01 () * L->probQmax) {
          break;
        }
      }
    }
    if (it == info->max_iter_reject) {
      fprintf (stderr, "Texture_process: too many iterations sampling hkl %d %d %d. Exit!\n", L->h, L->k, L->l);
      exit (-1);
    }

    kf_out = coords_scale (dir, sp->kim);
    kf[0] = kf_out.x;
    kf[1] = kf_out.y;
    kf[2] = kf_out.z;
    return 0;
  }

  // Pole density series at (ct, phi)
  double
  poleSeries (double ct, double phi, struct hkl_data_texture* L, struct legendre* lgdr) {
    int i;
    double plm;
    double sum = 0;

    for (i = 0; i < L->numV; i++) {
      plm = plmValue (L->lv[i], L->mv[i], ct, lgdr);
      sum += L->RV[i] * plm * cos (L->phiV[i] - L->mv[i] * phi);
    }

    return sum;
  }

  // Allocates and fills a table of poleSeries on the axes of the pole density tables
  void
  fillPoleTable (t_Table* table, struct hkl_data_texture* L, struct legendre* lgdr) {
    int i, j;

    Table_Init (table, lgdr->n_ct, lgdr->n_phi);
    for (i = 0; i < lgdr->n_ct; i++) {
      for (j = 0; j < lgdr->n_phi; j++) {
        table->data[i * lgdr->n_phi + j] = poleSeries (lgdr->ctAxis[i], lgdr->phiAxis[j], L, lgdr);
      }
    }
  }

  // end sampling

  ///////////////////////////
  //// Input - Output      //
  ///////////////////////////

  // Converts a CIF file to a temporary NCMAT file with ncrystal_cif2ncmat, and returns its name
  char*
  cif2ncmat_texture (char* infile) {
    char cmd[3200];
    char inpath[1024];
    FILE* file = Open_File (infile, "r", inpath);
    char* outfile = (char*)malloc (1024);

    if (!file || !outfile) {
      fprintf (stderr, "Texture: Error: Could not open %s\n", infile);
      if (file) {
        fclose (file);
      }
      free (outfile);
      return NULL;
    }
    fclose (file);

    snprintf (outfile, 1024, "%s.ncmat", tmpnam (NULL));
    snprintf (cmd, sizeof (cmd), "ncrystal_cif2ncmat \"%s\" --output \"%s\" --quiet", inpath, outfile);
    if (system (cmd) != 0) {
      fprintf (stderr, "Texture: Error: Could not convert %s with ncrystal_cif2ncmat, which needs the Python modules gemmi and spglib\n", infile);
      free (outfile);
      return NULL;
    }
    return outfile;
  }

  // Fills a table with one row per family of reflections of an NCrystal material
  // and the header of a reflection file: h, k, l, |F|^2 in barns, multiplicity
  void
  read_hkl_table_ncrystal_texture (const char* cfgstr, t_Table* table) {
    unsigned spacegroup, n_atoms;
    double lattice_a, lattice_b, lattice_c, alpha, beta, gamma, cell_volume, dsp, fsq, F2_scale;
    int idx, h, k, l, mult, nhkl, nonoriented;
    ncrystal_scatter_t scat;
    ncrystal_info_t ncobj;

    mccode_setup_ncrystal_search_paths ();
    scat = ncrystal_create_scatter (cfgstr);
    nonoriented = ncrystal_isnonoriented (ncrystal_cast_scat2proc (scat));
    ncrystal_unref (&scat);
    if (!nonoriented) {
      fprintf (stderr, "Texture_process: The NCrystal cfg-string \"%s\" must not specify a crystal orientation. Exit!\n", cfgstr);
      exit (-1);
    }

    ncobj = ncrystal_create_info (cfgstr);
    nhkl = ncrystal_info_nphases (ncobj) > 0 ? 0 : ncrystal_info_nhkl (ncobj);
    if (nhkl <= 0 || !ncrystal_info_getstructure (ncobj, &spacegroup, &lattice_a, &lattice_b, &lattice_c, &alpha, &beta, &gamma, &cell_volume, &n_atoms)) {
      fprintf (stderr, "Texture_process: The NCrystal material \"%s\" must have one crystalline phase with reflections. Exit!\n", cfgstr);
      exit (-1);
    }

    // The cross sections assume the density implied by the unit cell
    F2_scale = ncrystal_info_getnumberdensity (ncobj) * cell_volume / n_atoms;

    if (!Table_Init (table, nhkl, 5)) {
      fprintf (stderr, "Texture_process: Could not allocate reflection table for \"%s\". Exit!\n", cfgstr);
      exit (-1);
    }
    for (idx = 0; idx < nhkl; idx++) {
      ncrystal_info_gethkl (ncobj, idx, &h, &k, &l, &mult, &dsp, &fsq);
      if (h == 0 && k == 0 && l == 0) {
        fprintf (stderr, "Texture_process: The NCrystal material \"%s\" does not provide hkl indices. Exit!\n", cfgstr);
        exit (-1);
      }
      table->data[idx * 5 + 0] = h;
      table->data[idx * 5 + 1] = k;
      table->data[idx * 5 + 2] = l;
      table->data[idx * 5 + 3] = fsq * F2_scale;
      table->data[idx * 5 + 4] = mult;
    }

    table->header = (char*)malloc (1024);
    if (!table->header) {
      fprintf (stderr, "Texture_process: Failed malloc() reading \"%s\". Exit!\n", cfgstr);
      exit (-1);
    }
    snprintf (table->header, 1024,
              "# lattice_a %.17g\n# lattice_b %.17g\n# lattice_c %.17g\n"
              "# lattice_aa %.17g\n# lattice_bb %.17g\n# lattice_cc %.17g\n"
              "# column_h 1\n# column_k 2\n# column_l 3\n# column_F2 4\n# column_j 5\n",
              lattice_a, lattice_b, lattice_c, alpha, beta, gamma);

    ncrystal_unref (&ncobj);
  }

  // Right-handed orthonormal basis: e[0] || v1, e[1] in the plane of v1 and v2
  int
  directionBasis (Coords v1, Coords v2, Coords* e) {
    Coords n = coords_xp (v1, v2);
    if (coords_len (v1) == 0 || coords_len (n) < 1e-12 * coords_len (v1) * coords_len (v2)) {
      return 0;
    }
    e[0] = coords_scale (v1, 1.0 / coords_len (v1));
    e[2] = coords_scale (n, 1.0 / coords_len (n));
    e[1] = coords_xp (e[2], e[0]);
    return 1;
  }

  // Rotation R that takes crystal direction c1 onto component direction l1, and c2 into the plane of l1 and l2
  void
  directionRotation (Coords c1, Coords c2, Coords l1, Coords l2, Rotation R) {
    Coords e[3], f[3];
    double ea[3][3], fa[3][3];
    int i, j, k;

    if (!directionBasis (c1, c2, e) || !directionBasis (l1, l2, f)) {
      fprintf (stderr, "Texture_process: the directions of the two lattice vectors must be nonzero and not parallel. Exit!\n");
      exit (-1);
    }
    for (k = 0; k < 3; k++) {
      coords_get (e[k], ea[k], ea[k] + 1, ea[k] + 2);
      coords_get (f[k], fa[k], fa[k] + 1, fa[k] + 2);
    }
    // R = sum_k f_k e_k^T
    for (i = 0; i < 3; i++) {
      for (j = 0; j < 3; j++) {
        R[i][j] = fa[0][i] * ea[0][j] + fa[1][i] * ea[1][j] + fa[2][i] * ea[2][j];
      }
    }
  }

  // Lattice vectors along the three directions crys_axis, with the lengths of lat. The angles between the directions
  // must be those between the lattice vectors, and the directions must be right-handed.
  void
  latticeAlongAxes (struct hkl_info_struct_texture* info) {
    double tol = 1e-4; // rad
    double angle_lat, angle_dir;
    Coords dir[3];
    int i, i_next, i_last;
    char name[3] = { 'a', 'b', 'c' };

    for (i = 0; i < 3; i++) {
      dir[i] = coords_scale (info->crys_axis[i], 1.0 / coords_len (info->crys_axis[i]));
    }
    for (i = 0; i < 3; i++) {
      i_next = (i + 1) % 3;
      i_last = (i + 2) % 3;
      angle_lat = acos (coords_sp (info->lat[i_next], info->lat[i_last]) / (coords_len (info->lat[i_next]) * coords_len (info->lat[i_last])));
      angle_dir = acos (fmax (-1.0, fmin (1.0, coords_sp (dir[i_next], dir[i_last]))));
      if (fabs (angle_dir - angle_lat) > tol) {
        fprintf (stderr, "Texture_process: the directions of %c and %c are %g deg apart, but %g deg in the lattice of crystal_fn. Exit!\n", name[i_next],
                 name[i_last], angle_dir * RAD2DEG, angle_lat * RAD2DEG);
        exit (-1);
      }
    }
    if (coords_sp (dir[0], coords_xp (dir[1], dir[2])) <= 0) {
      fprintf (stderr, "Texture_process: the directions of a, b and c must be right-handed. Exit!\n");
      exit (-1);
    }
    for (i = 0; i < 3; i++) {
      info->lat[i] = coords_scale (dir[i], coords_len (info->lat[i]));
    }
  }

  int
  read_hkl_data_texture (char* SC_file, struct hkl_info_struct_texture* info) {
    struct hkl_data_texture* list = NULL;
    int size = 0;
    t_Table sTable; //
    int i = 0;
    double tmp_x, tmp_y, tmp_z;
    char** parsing;
    double h = 0, k = 0, l = 0, F2 = 0;
    double Gx, Gy, Gz;
    int mult = -1;
    // columns of h, k, l, F, F2, j, counted from 1
    int column_order[6] = { 1, 2, 3, 0, 7, 4 };
    double m_a = 0, m_b = 0, m_c = 0;    // lattice parameter lengths
    double m_aa = 0, m_bb = 0, m_cc = 0; // lattice angles
    double m_ax, m_ay, m_az;             // First unit cell axis (direct space, AA)
    double m_bx, m_by, m_bz;             // Second unit cell axis
    double m_cx, m_cy, m_cz;             // Third unit cell axis
    double asx, asy, asz;                // First reciprocal lattice axis (1/AA)
    double bsx, bsy, bsz;                // Second reciprocal lattice axis
    double csx, csy, csz;                // Third reciprocal lattice axis
    char* filename;
    char* ext;
    int i_first, i_second; // the first two lattice vectors placed by crys_axis
    int n_given;           // number of lattice vectors placed by crys_axis
    Rotation R;

    if (!SC_file || !strlen (SC_file) || !strcmp (SC_file, "NULL") || !strcmp (SC_file, "0")) {
      info->num_hkl = 0;
      return -1;
    }

    // Read the table

    ext = strrchr (SC_file, '.');
    if (ext && !strcasecmp (ext, ".cif")) {
      filename = cif2ncmat_texture (SC_file);
      if (!filename) {
        return 0;
      }
      read_hkl_table_ncrystal_texture (filename, &sTable);
      remove (filename);
      free (filename);
      info->flag_barns = 1;
    } else if (strstr (SC_file, ".ncmat") != NULL || strstr (SC_file, "::") != NULL) {
      read_hkl_table_ncrystal_texture (SC_file, &sTable);
      info->flag_barns = 1;
    } else if (Table_Read (&sTable, SC_file, 1) <= 0) { // read 1st block data from SC_file into sTable
      fprintf (stderr, "Texture: Error: Could not read reflections from %s\n", SC_file);
      return 0;
    }
    if (sTable.columns < 5) {
      fprintf (stderr, "Texture: Error: The number of columns in %s should be", SC_file);
      fprintf (stderr, " at least %d for [h,k,l,F2,j]\n", 5);
      Table_Free (&sTable);
      return (0);
    }
    if (!sTable.rows) {
      fprintf (stderr, "Texture: Error: The number of rows in %s should be at least %d\n", SC_file, 1);
      Table_Free (&sTable);
      return 0;
    } else {
      size = sTable.rows;
    }

    // parsing of header
    parsing = Table_ParseHeader (sTable.header, "column_h", "column_k", "column_l", "column_F ", "column_F2", "column_j", "lattice_a ", "lattice_b ", "lattice_c ",
                                 "lattice_aa", "lattice_bb", "lattice_cc", NULL);

    if (parsing) {
      for (i = 0; i < 6; i++) {
        if (parsing[i])
          column_order[i] = atoi (parsing[i]);
      }
      if (parsing[6])
        m_a = atof (parsing[6]);
      if (parsing[7])
        m_b = atof (parsing[7]);
      if (parsing[8])
        m_c = atof (parsing[8]);
      if (parsing[9])
        m_aa = atof (parsing[9]);
      if (parsing[10])
        m_bb = atof (parsing[10]);
      if (parsing[11])
        m_cc = atof (parsing[11]);
      for (i = 0; i < 12; i++) {
        if (parsing[i]) {
          free (parsing[i]);
        }
      }
      free (parsing);
    }

    // parameters consistency checks
    if (!m_a) {
      fprintf (stderr, "Texture: Error: Wrong a lattice vector definition\n");
      Table_Free (&sTable);
      return (0);
    }

    // lengths and angles missing from the data file
    if (!m_b) {
      m_b = m_a;
    }
    if (!m_c) {
      m_c = m_b;
    }
    if (!m_aa) {
      m_aa = 90;
    }
    if (!m_bb) {
      m_bb = m_aa;
    }
    if (!m_cc) {
      m_cc = m_bb;
    }

    // NCrystal: x || a and b in the xy plane, so z || c*
    m_cx = m_c * cos (m_bb * DEG2RAD);
    m_cy = m_c * (cos (m_aa * DEG2RAD) - cos (m_bb * DEG2RAD) * cos (m_cc * DEG2RAD)) / sin (m_cc * DEG2RAD);
    info->lat[0] = coords_set (m_a, 0, 0);
    info->lat[1] = coords_set (m_b * cos (m_cc * DEG2RAD), m_b * sin (m_cc * DEG2RAD), 0);
    info->lat[2] = coords_set (m_cx, m_cy, sqrt (m_c * m_c - m_cx * m_cx - m_cy * m_cy));

    // place the lattice along the given directions of crys_axis, or rotate it to the MTEX axes z || c and x || a*
    i_first = -1;
    i_second = -1;
    n_given = 0;
    for (i = 0; i < 3; i++) {
      if (coords_len (info->crys_axis[i]) > 0) {
        n_given++;
        if (i_first < 0) {
          i_first = i;
        } else if (i_second < 0) {
          i_second = i;
        }
      }
    }
    if (n_given == 3) {
      latticeAlongAxes (info);
    } else if (info->use_mtex_axes || n_given == 2) {
      if (info->use_mtex_axes) {
        directionRotation (info->lat[2], coords_xp (info->lat[1], info->lat[2]), coords_set (0, 0, 1), coords_set (1, 0, 0), R);
      } else {
        directionRotation (info->lat[i_first], info->lat[i_second], info->crys_axis[i_first], info->crys_axis[i_second], R);
      }
      for (i = 0; i < 3; i++) {
        info->lat[i] = rot_apply (R, info->lat[i]);
      }
    }
    coords_get (info->lat[0], &m_ax, &m_ay, &m_az);
    coords_get (info->lat[1], &m_bx, &m_by, &m_bz);
    coords_get (info->lat[2], &m_cx, &m_cy, &m_cz);

    // Compute reciprocal lattice vectors.
    vec_prod (tmp_x, tmp_y, tmp_z, m_bx, m_by, m_bz, m_cx, m_cy, m_cz);
    info->V0 = fabs (scalar_prod (m_ax, m_ay, m_az, tmp_x, tmp_y, tmp_z));
    asx = 2 * PI / info->V0 * tmp_x;
    asy = 2 * PI / info->V0 * tmp_y;
    asz = 2 * PI / info->V0 * tmp_z;

    vec_prod (tmp_x, tmp_y, tmp_z, m_cx, m_cy, m_cz, m_ax, m_ay, m_az);
    bsx = 2 * PI / info->V0 * tmp_x;
    bsy = 2 * PI / info->V0 * tmp_y;
    bsz = 2 * PI / info->V0 * tmp_z;

    vec_prod (tmp_x, tmp_y, tmp_z, m_ax, m_ay, m_az, m_bx, m_by, m_bz);
    csx = 2 * PI / info->V0 * tmp_x;
    csy = 2 * PI / info->V0 * tmp_y;
    csz = 2 * PI / info->V0 * tmp_z;

    if (!column_order[0] || !column_order[1] || !column_order[2]) {
      fprintf (stderr, "Texture: Error: Wrong h,k,l column definition\n");
      Table_Free (&sTable);
      return (0);
    }
    if (!column_order[3] && !column_order[4]) {
      fprintf (stderr, "Texture: Error: Wrong F,F2 column definition\n");
      Table_Free (&sTable);
      return (0);
    }

    // allocate hkl_data array
    list = (struct hkl_data_texture*)malloc (size * sizeof (struct hkl_data_texture));

    // write the data to data structures
    for (i = 0; i < size; i++) {
      h = Table_Index (sTable, i, column_order[0] - 1);
      k = Table_Index (sTable, i, column_order[1] - 1);
      l = Table_Index (sTable, i, column_order[2] - 1);
      if (column_order[3]) {
        F2 = Table_Index (sTable, i, column_order[3] - 1);
        F2 *= F2;
      } else if (column_order[4]) {
        F2 = Table_Index (sTable, i, column_order[4] - 1);
      }
      mult = Table_Index (sTable, i, column_order[5] - 1);
      list[i].h = h;
      list[i].k = k;
      list[i].l = l;
      list[i].F2 = F2;
      list[i].mult = mult;
      Gx = h * asx + k * bsx + l * csx;
      Gy = h * asy + k * bsy + l * csy;
      Gz = h * asz + k * bsz + l * csz;
      list[i].G = sqrt (Gx * Gx + Gy * Gy + Gz * Gz);
      list[i].Gct = Gz / list[i].G;
      list[i].Gphi = atan2 (Gy / list[i].G, Gx / list[i].G);
    }

    Table_Free (&sTable);

    // sort the list with increasing G
    qsort (list, i, sizeof (struct hkl_data_texture), SX_list_compare_texture);

    // Reflections with G > 2k cannot scatter
    while (info->wavelength_min > 0 && i > 0 && list[i - 1].G > 4 * PI / info->wavelength_min) {
      i--;
    }

    info->list = list;
    info->num_hkl = i;


    return info->num_hkl;
  } // read_hkl_data

  void
  allocateFourierCoef (int lmax, struct fourier_coef* c) {
    int l, m;
    if (lmax >= 0) {
      c->lmax = lmax;
      c->cr = (double***)malloc ((lmax + 1) * sizeof (double**));
      c->ci = (double***)malloc ((lmax + 1) * sizeof (double**));
      for (l = 0; l <= lmax; l++) {
        (c->cr)[l] = (double**)malloc ((2 * l + 1) * sizeof (double*));
        (c->ci)[l] = (double**)malloc ((2 * l + 1) * sizeof (double*));
        for (m = -l; m <= l; m++) {
          (c->cr)[l][m + l] = (double*)malloc ((2 * l + 1) * sizeof (double));
          (c->ci)[l][m + l] = (double*)malloc ((2 * l + 1) * sizeof (double));
        }
      }
    } else {
      c->lmax = -1;
      c->cr = NULL;
      c->ci = NULL;
    }
  } // allocateFourierCoef

  void
  readFourierCoef (char* filename, struct fourier_coef* c) {
    int i, lmax, np, l, m, n, smn, sg;
    double x1, x2, x3, x4, x5, rmax;
    t_Table table;

    // Note: if the coeeficients have been obtained from mtex
    // with l2-normalization option, they have to be multiplied
    // by sqrt(2*l+1)

    Table_Read (&table, filename, 1);
    if (table.rows < 1 || table.columns != 5) {
      fprintf (stderr, "Texture_process: %s must have five columns: l m n Real(Clmn) Imag(Clmn). Exit!\n", filename);
      exit (-1);
    }

    lmax = (int)round (Table_Index (table, table.rows - 1, 0));
    np = (lmax + 1) * (2 * lmax + 1) * (2 * lmax + 3) / 3;
    if (lmax < 0 || np != table.rows) {
      fprintf (stderr, "Texture_process: %s has %ld rows, but lmax = %d needs %d. Exit!\n", filename, table.rows, lmax, np);
      exit (-1);
    }

    if (c->lmax >= 0 && lmax > c->lmax) {
      lmax = c->lmax;
    }

    allocateFourierCoef (lmax, c);

    np = (lmax + 1) * (2 * lmax + 1) * (2 * lmax + 3) / 3;
    for (i = 0; i < np; i++) {
      l = (int)round (Table_Index (table, i, 0));
      n = (int)round (Table_Index (table, i, 1)); // TRANSPOSEE
      m = (int)round (Table_Index (table, i, 2)); // TRANSPOSEE
      smn = ((m < 0 ? -m : 0) + (n < 0 ? -n : 0)) % 2 ? -1 : 1;
      (c->cr)[l][l + m][l + n] = smn * Table_Index (table, i, 3);
      (c->ci)[l][l + m][l + n] = smn * -Table_Index (table, i, 4); // conjugate
    }
    Table_Free (&table);

    // check reality of ODF
    rmax = 0;
    for (l = 0; l <= lmax; l++) {
      for (m = -l; m <= l; m++) {
        for (n = -l; n <= l; n++) {
          x1 = (c->cr)[l][l + m][l + n];
          x2 = (c->ci)[l][l + m][l + n];
          x3 = (c->cr)[l][l - m][l - n];
          x4 = (c->ci)[l][l - m][l - n];
          if (abs (m - n) % 2) {
            x3 = -x3;
            x4 = -x4;
          }
          x5 = sqrt (pow (x1 - x3, 2) + pow (-x2 - x4, 2));
          if (x5 > rmax) {
            rmax = x5;
          }
        }
      }
    }

    if (rmax > 1.0e-6) {
      printf ("Texture_process: %s does not satisfy the reality condition of the ODF (%.6e). Imposing it.\n", filename, rmax);
      for (l = 0; l <= lmax; l++) {
        (c->ci)[l][l][l] = 0;
        for (m = 0; m <= l; m++) {
          for (n = (m ? -l : 1); n <= l; n++) {
            sg = abs (m - n) % 2 ? -1 : 1;
            (c->cr)[l][l - m][l - n] = sg * (c->cr)[l][l + m][l + n];
            (c->ci)[l][l - m][l - n] = -sg * (c->ci)[l][l + m][l + n];
          }
        }
      }
    }
  } // readFourierCoef

  void
  freeFourierCoef (struct fourier_coef* c) {
    int l, m;
    if (c->cr != NULL) {
      for (l = 0; l <= (c->lmax); l++) {
        for (m = -l; m <= l; m++) {
          free (c->cr[l][m + l]);
          free (c->ci[l][m + l]);
        }
        free (c->cr[l]);
        free (c->ci[l]);
      }
      free (c->cr);
      free (c->ci);
    }
  } // freeFourierCoef

  // end Input - Output

  ////////////////////////////////////////
  ////// initialization             //////
  ////////////////////////////////////////

  int
  initData (char* coef_fn, char* crystal_fn, struct hkl_info_struct_texture* info) {
    int i, i_saved, nread;
    long j;
    struct fourier_coef* fc;
    struct hkl_data_texture* L;
    struct kiCache* e;
    int use_coef = coef_fn && strlen (coef_fn) && strcmp (coef_fn, "0") && strcmp (coef_fn, "NULL");

    if (!use_coef) {
      fprintf (stderr, "Texture_process: give the Fourier coefficients of the texture in fcoef_fn. Exit!\n");
      exit (-1);
    }

    info->tol_V = 1.0e-6;
    info->n_phi_points = 120;
    info->max_iter_reject = 3000;

    // crystallographic data
    nread = read_hkl_data_texture (crystal_fn, info);
    if (!nread) {
      printf ("initData: read_hkl_data_texture returns error\n");
      return 1;
    }

    // get fourier coefficients of texture
    fc = (struct fourier_coef*)malloc (sizeof (struct fourier_coef));
    fc->lmax = info->lmax;
    readFourierCoef (coef_fn, fc);
    // the cut-off actually used: the file's lmax, or lmax_user if that is smaller
    info->lmax = fc->lmax;

    // precompute legendre associated functions
    info->lgdr = initLegendre (fc->lmax);

    // below lmax = 20 the pole density of kf is read from probQ at each try instead of tabulated for each wavevector
    info->phi_table = info->lmax >= 20;

    // cache of the wavevectors; an empty entry has ki = 0, which no neutron has
    info->n_saved = 4;
    info->saved = (struct kiCache*)calloc (info->n_saved, sizeof (struct kiCache));
    if (!info->saved) {
      fprintf (stderr, "Texture_process: Failed malloc() in initData. Exit!\n");
      exit (-1);
    }
    for (i_saved = 0; i_saved < info->n_saved; i_saved++) {
      e = info->saved + i_saved;
      e->ki = coords_set (0, 0, 0);
      e->XS_ki = (double*)calloc (info->num_hkl, sizeof (double));
      e->phi = (struct phiTable*)calloc (info->num_hkl, sizeof (struct phiTable));
      if (info->num_hkl > 0 && (!e->XS_ki || !e->phi)) {
        fprintf (stderr, "Texture_process: Failed malloc() in initData. Exit!\n");
        exit (-1);
      }
      for (i = 0; i < info->num_hkl && info->phi_table; i++) {
        e->phi[i].aa = (double*)malloc (info->n_phi_points * sizeof (double));
        e->phi[i].bb = (double*)malloc (info->n_phi_points * sizeof (double));
        if (!e->phi[i].aa || !e->phi[i].bb) {
          fprintf (stderr, "Texture_process: Failed malloc() in initData. Exit!\n");
          exit (-1);
        }
      }
    }

    L = info->list;
    for (i = 0; i < info->num_hkl; i++) {
      L[i].numNegativeXS = 0;
    }

    // V matrices for cross sections
    L = info->list;
    for (i = 0; i < info->num_hkl; i++) {
      computeV (fc, L + i, info->tol_V);
    }

    // precompute the probability distribution of Q
    L = info->list;
    for (i = 0; i < info->num_hkl; i++) {
      fillPoleTable (&L[i].probQ, L + i, info->lgdr);
      L[i].probQmax = L[i].probQ.data[0];
      for (j = 1; j < L[i].probQ.rows * L[i].probQ.columns; j++) {
        L[i].probQmax = fmax (L[i].probQmax, L[i].probQ.data[j]);
      }
    }

    // coefficients of the total cross sections, and the harmonics of one wavevector
    L = info->list;
    for (i = 0; i < info->num_hkl; i++) {
      xsCoefficients (L + i, info->lmax);
    }
    info->sqn = (double*)malloc ((info->lmax + 1) * (info->lmax + 1) * sizeof (double));
    info->plm = (double*)malloc ((info->lmax + 1) * (info->lmax + 1) * sizeof (double));
    info->cm = (double*)malloc ((info->lmax + 1) * sizeof (double));
    info->sm = (double*)malloc ((info->lmax + 1) * sizeof (double));
    if (!info->sqn || !info->plm || !info->cm || !info->sm) {
      fprintf (stderr, "Texture_process: Failed malloc() in initData. Exit!\n");
      exit (-1);
    }
    legendre_scale_factors (info->lmax, info->sqn);

    // free memory of fourier coefficient, not needed anymore
    freeFourierCoef (fc);
    free (fc);

    return 0;
  }

  // end initialization

  ////////////////////////////////////
  ///  free memory                ////
  ////////////////////////////////////

  int
  free_legendre (struct legendre* lgdr) {
    int l;

    if (lgdr == NULL) {
      return 0;
    }

    for (l = 0; l <= lgdr->lmax; l++) {
      Table_Free (lgdr->Plm + l);
    }
    free (lgdr->Plm);
    free (lgdr->ctAxis);
    free (lgdr->phiAxis);

    return 0;
  }

  int
  free_hkl_data_texture (struct hkl_data_texture* L) {
    if (L == NULL) {
      return 0;
    }

    free (L->lv);
    free (L->mv);
    free (L->RV);
    free (L->phiV);

    Table_Free (&L->probQ);
    free (L->Ac);
    free (L->As);

    return 0;
  }

  int
  free_texture (struct hkl_info_struct_texture* hkl_info) {
    int i, i_saved;

    if (hkl_info == NULL) {
      return 0;
    }

    free_legendre (hkl_info->lgdr);
    free (hkl_info->lgdr);
    for (i = 0; i < hkl_info->num_hkl; i++) {
      free_hkl_data_texture (hkl_info->list + i);
    }
    free (hkl_info->list);
    for (i_saved = 0; i_saved < hkl_info->n_saved; i_saved++) {
      for (i = 0; i < hkl_info->num_hkl; i++) {
        free (hkl_info->saved[i_saved].phi[i].aa);
        free (hkl_info->saved[i_saved].phi[i].bb);
      }
      free (hkl_info->saved[i_saved].phi);
      free (hkl_info->saved[i_saved].XS_ki);
    }
    free (hkl_info->saved);
    free (hkl_info->sqn);
    free (hkl_info->plm);
    free (hkl_info->cm);
    free (hkl_info->sm);

    return 0;
  }

  // end free memory

  // Cache entry of the wavevector k, moved to the front of info->saved. When k is not in the cache, the
  // least recently used entry is overwritten with the cross sections of k, and its sampling tables are reset.
  struct kiCache*
  kiEntry (double* k, struct hkl_info_struct_texture* info) {
    int i, i_saved;
    int i_hit = -1; // entry of saved that holds k, -1 if none
    int i_entry;    // entry of saved that is used and moved to the front
    int m;
    double ki, kict, kiphi, cohXS;
    struct kiCache entry;
    struct kiCache* sv = info->saved;
    struct kiCache* e;
    struct hkl_data_texture* L = info->list;

    for (i_saved = 0; i_saved < info->n_saved; i_saved++) {
      if (k[0] == sv[i_saved].ki.x && k[1] == sv[i_saved].ki.y && k[2] == sv[i_saved].ki.z) {
        i_hit = i_saved;
        break;
      }
    }

    if (i_hit >= 0) {
      // k is in the cache: reuse its cross sections and sampling tables
      i_entry = i_hit;
    } else {
      i_entry = info->n_saved - 1;
      e = sv + i_entry;
      e->ki = coords_set (k[0], k[1], k[2]);

      // polar coordinates of the wavevector
      ki = sqrt (k[0] * k[0] + k[1] * k[1] + k[2] * k[2]);
      kict = k[2] / ki;
      kiphi = atan2 (k[1], k[0]);
      all_scaled_associated_legendre (info->lmax, fmin (1.0, fmax (-1.0, kict)), info->sqn, info->plm);
      for (m = 0; m <= info->lmax; m++) {
        info->cm[m] = cos (m * kiphi);
        info->sm[m] = sin (m * kiphi);
      }

      // reflections with G > 2 ki cannot scatter
      e->last_hkl = -1;
      cohXS = 0;
      for (i = 0; i < info->num_hkl && L[i].G <= 2 * ki; i++) {
        e->last_hkl = i;
        e->XS_ki[i] = total_hkl_XS (ki, L + i, info);
        e->phi[i].built = 0;
        cohXS += e->XS_ki[i];
      }

      // multiply by the appropriate factors to get the linear attenuation coefficient cohMu (in m^-1)
      e->cohMu = cohXS * (info->xs2mu) * pow ((2 * PI) / ki, 3) / (info->V0);
    }

    // move the used entry to the front
    entry = sv[i_entry];
    memmove (sv + 1, sv, i_entry * sizeof (struct kiCache));
    sv[0] = entry;

    return sv;
  }


  #endif /* !TEXTURE_PROCESS_DECL */

  // Very important to add a pointer to this struct in the union-lib.h file
  struct Texture_physics_storage_struct {
    // Variables that needs to be transfered between any of the following places:
    // The initialize in this component
    // The function for calculating my
    // The function for calculating scattering

    // Avoid duplicates of output parameters and setting parameters in naming

    struct hkl_info_struct_texture* hkl_info_storage; // struct containing all necessary info for SC
  };

  // Function for calculating my, the inverse penetration depth (for only this scattering process).
  // The input for this function and its order may not be changed, but the names may be updated.
  int
  Texture_physics_my (double* my, double* k_initial, union data_transfer_union data_transfer, struct focus_data_struct* focus_data, _class_particle* _particle) {
    // k_initial is a pointer to a simple vector with 3 doubles, k[0], k[1], k[2] (wavevector)
    struct hkl_info_struct_texture* hkl_info = data_transfer.pointer_to_a_Texture_physics_storage_struct->hkl_info_storage;

    // with SPLIT, the copies of a neutron enter with the same wavevector: kiEntry reuses its cross sections
    *my = kiEntry (k_initial, hkl_info)->cohMu;

    return 1;
  };

  // Function that provides description of a basic scattering event.
  int
  Texture_physics_scattering (double* k_final, double* k_initial, double* weight, union data_transfer_union data_transfer, struct focus_data_struct* focus_data,
                              _class_particle* _particle) {
    int i, j;
    double r, sum, accum; /* Locals */
    double kf[3];                       /* Final wave vector (local) */

    struct hkl_info_struct_texture* hkl_info = data_transfer.pointer_to_a_Texture_physics_storage_struct->hkl_info_storage;

    struct hkl_data_texture* L = hkl_info->list; // hkl list
    // cross sections of this wavevector, normally the front entry left by Texture_physics_my
    struct kiCache* e = kiEntry (k_initial, hkl_info);

    // This can be removed, since this component deals only with coherent scattering
    // (instead here the Bragg cutoff may be implemented)
    if (e->last_hkl < 0 || e->cohMu <= 0) {
      k_final[0] = k_initial[0];
      k_final[1] = k_initial[1];
      k_final[2] = k_initial[2];
      return 0; // Return 0 will use ABSORB in main component (as it is not allowed in a function)
    }

    // e->last_hkl implements Bragg cutoff
    sum = 0;
    for (i = 0; i <= e->last_hkl; i++) {
      sum += e->XS_ki[i];
    }

    j = -1;
    r = rand01 ();
    accum = 0;
    for (i = 0; i <= e->last_hkl; i++) {
      accum += e->XS_ki[i] / sum;
      if (r < accum) {
        j = i;
        break;
      }
    }

    if (j == -1) {
      fprintf (stderr, "Texture_process: no plane selected for k = %g %g %g. Exit!\n", k_initial[0], k_initial[1], k_initial[2]);
      exit (-1);
    }

    // sampling kprime
    sampleKprime_hkl (kf, e->ki, e->phi + j, L + j, hkl_info);



    // return the scattered wave vector
    k_final[0] = kf[0];
    k_final[1] = kf[1];
    k_final[2] = kf[2];

    return 1;
  };

  #ifndef PROCESS_DETECTOR
  #define PROCESS_DETECTOR dummy
  #endif

  #ifndef PROCESS_TEXTURE_DETECTOR
  #define PROCESS_TEXTURE_DETECTOR dummy
  #endif

  // Register this process with the Union_master dispatch (see union-lib.h)
  #undef UNION_CASE_PHYSICS_MY_TEXTURE
  #define UNION_CASE_PHYSICS_MY_TEXTURE(out, ...) case Texture: out = Texture_physics_my(__VA_ARGS__); break;
  #undef UNION_CASE_PHYSICS_SCATTERING_TEXTURE
  #define UNION_CASE_PHYSICS_SCATTERING_TEXTURE(out, ...) case Texture: out = Texture_physics_scattering(__VA_ARGS__); break;
%}

DECLARE
%{
  // Declare for this component, to do calculations on the input / store in the transported data
  struct Texture_physics_storage_struct Texture_storage;

  // Variables needed in initialize of this function.
  struct hkl_info_struct_texture hkl_info_texture;

  // Needed for transport to the main component, will be the same for all processes
  struct global_process_element_struct global_process_element;
  struct scattering_process_struct This_process;
%}

INITIALIZE
%{
  struct union_state_struct* union_state_p = union_acquire ();
  int n_axes, i_axis;
  // Texture initialize

  hkl_info_texture.flag_barns = 0;
  hkl_info_texture.wavelength_min = lambda_min;
  hkl_info_texture.use_mtex_axes = mtex_axes;
  hkl_info_texture.crys_axis[0] = coords_set (ax, ay, az);
  hkl_info_texture.crys_axis[1] = coords_set (bx, by, bz);
  hkl_info_texture.crys_axis[2] = coords_set (cx, cy, cz);
  n_axes = 0;
  for (i_axis = 0; i_axis < 3; i_axis++) {
    if (coords_len (hkl_info_texture.crys_axis[i_axis]) > 0) {
      n_axes++;
    }
  }
  if (n_axes == 1) {
    fprintf (stderr, "Texture_process: %s: give the directions of two or three of the lattice vectors a, b and c, or none. Exit!\n", NAME_CURRENT_COMP);
    exit (-1);
  }
  if (n_axes && mtex_axes) {
    fprintf (stderr, "Texture_process: %s: the directions of the lattice vectors cannot be combined with mtex_axes = 1. Exit!\n", NAME_CURRENT_COMP);
    exit (-1);
  }

  // cut-off for l. If negative, take the cut-off provided in the Fourier coeff file
  hkl_info_texture.lmax = lmax_user;

  // initialize data
  if (initData (fcoef_fn, crystal_fn, &hkl_info_texture)) {
    printf ("Texture_process: %s: Error in initData: Aborting.\n", NAME_CURRENT_COMP);
    exit (-1);
  }

  // precomputed factors
  hkl_info_texture.xs2mu = packing_factor / hkl_info_texture.V0;
  // Cross-sections are in barns = 10**-28 m**2, and unit cell volumes are
  // in AA**3 = 10**-30 m**3. Hence a factor of 100 is used to convert
  // scattering lengths to m**-1
  if (barns || hkl_info_texture.flag_barns) {
    hkl_info_texture.xs2mu *= 100;
  }

  if (hkl_info_texture.num_hkl) {
    printf ("Texture_process: %s: Read %d reflections from file '%s'\n", NAME_CURRENT_COMP, hkl_info_texture.num_hkl, crystal_fn);
  } else {
    printf ("Texture_process: %s: No reflections read from file. No scattering will take place.\n", NAME_CURRENT_COMP);
  }

  // Initialize done in the component
  Texture_storage.hkl_info_storage = &hkl_info_texture;

  // First initialise This_process with default values:
  scattering_process_struct_init (&This_process);

  // Need to specify if this process is isotropic
  This_process.non_isotropic_rot_index = 1; // No (single crystal or texture)

  // Need to specify if this process need to use focusing in calculation of inverse penetration depth (physics_my)
  This_process.needs_cross_section_focus = -1; // No

  // The type of the process must be saved in the global enum process
  This_process.eProcess = Texture;

  // Packing the data into a structure that is transported to the main component
  This_process.data_transfer.pointer_to_a_Texture_physics_storage_struct = &Texture_storage;
  This_process.probability_for_scattering_function = &Texture_physics_my;
  This_process.scattering_function = &Texture_physics_scattering;

  // This will be the same for all process's, and can thus be moved to an include.
  This_process.process_p_interact = interact_fraction;
  sprintf (This_process.name, "%s", NAME_CURRENT_COMP);
  rot_copy (This_process.rotation_matrix, ROT_A_CURRENT_COMP);
  sprintf (global_process_element.name, "%s", NAME_CURRENT_COMP);
  global_process_element.component_index = INDEX_CURRENT_COMP;
  global_process_element.p_scattering_process = &This_process;

  struct pointer_to_global_process_list* global_process_list = &union_state_p->u_process_list;
  add_element_to_process_list (global_process_list, global_process_element);
 %}

TRACE
%{
  // Trace should be empty, the simulation is done in Union_master
%}

FINALLY
%{
  int i;
  struct hkl_info_struct_texture* hkl_info = This_process.data_transfer.pointer_to_a_Texture_physics_storage_struct->hkl_info_storage;
  double numNegativeXS = 0;
  for (i = 0; i < hkl_info->num_hkl; i++) {
    numNegativeXS += hkl_info->list[i].numNegativeXS;
  }
  if (numNegativeXS > 0) {
    printf ("Texture_process %s WARNING: the truncated series gave %g negative cross sections.\n", NAME_CURRENT_COMP, numNegativeXS);
  }
  // deallocate allocated memory, etc.
  free_texture (hkl_info);
  union_release (NAME_CURRENT_COMP);
%}

END
