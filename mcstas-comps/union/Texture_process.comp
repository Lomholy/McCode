/*******************************************************************************
*
*  McStas, neutron ray-tracing package
*  Copyright(C) 2007 Risoe National Laboratory.
*
* Component: Texture_process
*
* %I
* Written by: Victor Laliena, and expanded upon by Daniel Lomholt Christensen
* Date: 2018-2019 and 2026-2027
* Origin: University of Zaragoza and subsequently the University of Copenhagen, funded by the ACTNXT program
*
* Component for simulating textured and strained mono-crystalline materials and polycrystalline materials in Union components
*
* %D
*
* Part of the Union components, a set of components that work together and thus
* seperates geometry and physics within McStas.
* The use of this component requires other components to be used.
*
* This component deals with the coherent elastic scattering on a textured material.
* The texture is described through the coefficients of the generalized Fourier transform
* of the Orientation Distribution Function (ODF).
* The component expects as input two files, one containing the Fourier coefficients of the
* ODF and another one with crystallographic and physical information.
*
*
* CIF and NCrystal inputs can give hundreds of reflections, and the tables use about 1 MB for
* each reflection, so set lambda_min, or dcutoff in the NCrystal cfg-string, to what the instrument reaches.
* An NCrystal material must have one crystalline phase and no orientation, as that is given by the
* placement of the component. CIF files are converted with ncrystal_cif2ncmat, which needs the Python
* modules gemmi and spglib and uses a Debye temperature of 300 K when it has no other atomic dynamics. Run
* ncrystal_cif2ncmat directly and use the resulting NCMAT file to set this. Each family of reflections is described by one of its members, so the
* ODF must have the crystal symmetry applied.
*
* The ODF rotates the Cartesian crystal axes into the axes of
* the component. By default the crystal axes are those of NCrystal: x || a, b in the xy plane,
* so z || c*. mtex_axes = 1 takes the default axes of MTEX instead: z || c, x || a*. Both are
* the same for cubic, tetragonal and orthorhombic lattices; for hexagonal and trigonal
* lattices they differ by 30 deg about c.
* ax, ay, az, bx, by, bz and cx, cy, cz place the crystal axes instead, as for a single crystal, by
* the directions in the component of two or three of the lattice vectors a, b and c; a vector that
* is not given is left 0. With two, the first of the two in the order a, b, c points along its
* direction, and the second lies in the plane of the two directions, at the angle from the first
* given by crystal_fn. With three, each lattice vector points along its direction; the angles between
* the directions must be those of crystal_fn within 1e-4 rad, and a, b, c must be right-handed.
* Only the directions are used, the lengths come from crystal_fn. With all of them 0, the NCrystal
* axes are used. For example, ax = 0, ay = 1, az = 0, bx = -1, by = 0, bz = 0 turns the crystal axes
* by 90 deg about z.
*
* The coefficients of an orientation list, e.g. from EBSD, or of orientations drawn from
* rotation expressions, are computed beforehand with share/texture-coefficients.py.
*
* fcoef_fn is a text file with the five columns l m n Real(Clmn) Imag(Clmn), or, with the
* extension .bin, a binary file of the same coefficients that is about 3.5 times smaller.
* The binary file holds only Real(Clmn) and Imag(Clmn) of each row, as two little-endian 8-byte
* doubles, without header, in the row order of the text file: l = 0 ... lmax, and for each l
* the second column from -l to l, and for each of those the third column from -l to l. lmax
* follows from the file size, 16 (lmax + 1) (2 lmax + 1) (2 lmax + 3) / 3 bytes.
* texture-coefficients.py writes it when --out ends in .bin.
*
* Algorithm:
* Described elsewhere, see e.g. <a href="https://doi.org/10.3233/JNR-190117">https://doi.org/10.3233/JNR-190117</a>
* The calculations are detailed in V. Laliena, M. A. Vicente-Alvarez and J. Campo,
* J. Appl. Cryst. 53, 512-529 (2020), <a href="https://doi.org/10.1107/S1600576720002290">https://doi.org/10.1107/S1600576720002290</a>
*
* %P
* INPUT PARAMETERS:
* packing_factor:    [1]      How dense is the material compared to optimal 0-1
* interact_fraction: [1]      How large a part of the scattering events should use this process 0-1 (sum of all processes in material = 1)
* crystal_fn:        [s]      Crystallographic information: a reflection file (LAZ, LAU), a CIF file, or an NCrystal cfg-string (containing ".ncmat" or "::")
* fcoef_fn:          [s]      Path to a file containing the Fourier coefficients of the ODF: a text file with the five columns l m n Real(Clmn) Imag(Clmn), or a binary file with the extension .bin, see above
* lmax_user:         [1]      Cut-off for the Fourier series. If negative, the program uses all the coefficients provided in the file fcoef_fn. Values above the lmax of fcoef_fn also use all of them.
* barns:             [1]      Flag to indicate if |F|^2 from 'crystal_fn' is in barns or fm^2. barns=1 for laz and isotropic constant elastic scattering (reflections=NULL), barns=0 for lau type files. Always barns for CIF files and NCrystal cfg-strings
* lambda_min:        [AA]     Reflections that only scatter below this wavelength are not used, which saves one table per l for each of them. 0 keeps all reflections
* mtex_axes:         [1]      0: crystal axes of NCrystal (x || a, b in the xy plane), 1: default crystal axes of MTEX (z || c, x || a*), for an ODF given in them
* ax:                [1]      x of the direction of the lattice vector a in the component. Give two or three of a, b and c, or none; not with mtex_axes = 1
* ay:                [1]      y of the direction of a
* az:                [1]      z of the direction of a
* bx:                [1]      x of the direction of the lattice vector b in the component
* by:                [1]      y of the direction of b
* bz:                [1]      z of the direction of b
* cx:                [1]      x of the direction of the lattice vector c in the component
* cy:                [1]      y of the direction of c
* cz:                [1]      z of the direction of c
* init:              [string]    Deprecated and unused. Accepted so that instruments written for McStas/McXtrace 3.8.7 and earlier, which name the Union_init component here, still compile.
*
* %L
* See <a href="https://doi.org/10.3233/JNR-190117">https://doi.org/10.3233/JNR-190117</a>
* V. Laliena, M. A. Vicente-Alvarez and J. Campo, "Monte Carlo simulation of neutron scattering by a textured polycrystal",
* J. Appl. Cryst. 53, 512-529 (2020), <a href="https://doi.org/10.1107/S1600576720002290">https://doi.org/10.1107/S1600576720002290</a>
*
* %E
******************************************************************************/

DEFINE COMPONENT Texture_process // Remember to change the name of process here

SETTING PARAMETERS(string crystal_fn=0, string fcoef_fn=0, int lmax_user=-1, int mtex_axes=0,
            ax=0, ay=0, az=0, bx=0, by=0, bz=0, cx=0, cy=0, cz=0,
            barns = 0, interact_fraction = -1, packing_factor = 1, lambda_min = 0,
	        string init="")


DEPENDENCY "@NCRYSTALFLAGS@"

SHARE
%{
  %include "union-lib"

  %include "read_table-lib"
  %include "special-functions-lib"
  %include "mccode-ncrystal-lib"

  #ifndef TEXTURE_PROCESS_DECL
  #define TEXTURE_PROCESS_DECL

  // azimuthal sampling table of kf for one reflection and one wavevector
  struct kf_phi_table {
    int built;                                         // 0 until the table is computed for the wavevector of its cache entry
    Coords ki_unit;                                    // unit vector of ki
    Coords perp_1, perp_2;                             // complete ki_unit to a right-handed basis (perp_1, perp_2, ki_unit)
    double ki_modulus;                                 // modulus of ki
    double sin_scattering_angle, cos_scattering_angle; // sine and cosine of the scattering angle
    double max_probability;
    double *prob_offset, *prob_slope; // probability prob_offset[j] + phi * prob_slope[j] of the azimuth phi between points j and j + 1
  };

  // everything computed for one wavevector
  struct ki_cache_entry {
    Coords ki;
    int last_hkl;                    // index of the last reflection below the Bragg cutoff, -1 if none
    double coherent_mu;              // linear attenuation coefficient (m^-1)
    double* XS_ki;                   // cross section of each reflection alone
    struct kf_phi_table* phi_tables; // sampling table of each reflection
  };

  struct odf_coefficients {
    int lmax;
    double ***coef_real, ***coef_imag;
  };

  struct legendre_tables {
    int lmax;
    t_Table* plm_tables; // per l: scaled_associated_legendre on a uniform grid in x, with one column per m
    // axes of the pole density tables, uniform in cos(theta) and phi
    int n_cos_theta, n_phi;
    double* cos_theta_axis;
    double* phi_axis;
  };

  struct hkl_data_texture {
    int h, k, l;                  // Indices for this reflection
    int multiplicity;             // Multiplicity of the line
    double F2;                    // Value of square of structure factor
    double G, G_cos_theta, G_phi; // polar coordinates of G
    // total cross section: sum_m scaled_associated_legendre (l, m, kct) (XS_cos_coef cos (m kphi) + XS_sin_coef sin (m kphi)) at [l * (lmax + 1) + m], m >= 0
    double *XS_cos_coef, *XS_sin_coef;
    // V terms above V_tolerance, which give the cross sections: order l, m, modulus and phase of each
    int n_V;
    int *V_l, *V_m;
    double *V_modulus, *V_phase;
    // to sample kprime
    // precomputed Q distribution
    t_Table pole_density;
    double pole_density_max; // largest value of pole_density
    // number of negative cross sections from the truncated series
    double n_negative_XS;
  };

  struct hkl_info_struct_texture {
    // data structures
    int num_hkl;                                     // Number of reflections hkl taken into account
    struct hkl_data_texture* hkl_list;               // Reflection array
    struct legendre_tables* legendre_ass_polynomial; // structure with precomputed spherical harmonics
    int lmax;                                        // cut-off for the Fourier expansion

    double cell_volume;           // Unit cell volume (AA**3)
    Coords lattice_vectors[3];    // direct lattice vectors (AA) in the Cartesian crystal frame
    int F2_in_barns;              // |F|^2 is in barns whatever the barns parameter is
    int use_mtex_axes;            // crystal axes z || c, x || a* instead of x || a, b in the xy plane
    Coords lattice_directions[3]; // directions of the lattice vectors a, b, c in the component, (0, 0, 0) if not given
    double wavelength_min;        // Reflections only scattering below this wavelength are not used

    // precomputed factors
    double XS_to_mu; // cross section to mu (in m^-1)

    double V_tolerance;            // terms of V with a smaller modulus are dropped
    double* legendre_norm;         // sqrt ((l - m)! / (l + m)!) at [l * (lmax + 1) + m]
    double* plm_ki;                // scaled_associated_legendre (l, m, kct) of the wavevector of the last cache fill, same index
    double *cos_m_phi, *sin_m_phi; // cos (m kphi) and sin (m kphi) of that wavevector
    int n_phi_points;              // points of the azimuthal sampling tables of kf
    int use_phi_table;             // 1: azimuthal table of kf for each wavevector (lmax >= 20), 0: rejection on pole_density directly
    int max_iter_reject;           // tries of the rejection sampling of kf before giving up

    // everything computed for the last n_cached wavevectors, most recently used first,
    // so that the SPLIT copies of a neutron reuse it
    int n_cached;
    struct ki_cache_entry* ki_cache;
  };

  /////////////////////////////////////////
  // auxiliary functions
  //////////////////////////////////////////

  int
  SX_list_compare_texture (void const* a, void const* b) {
    struct hkl_data_texture const* pa = a;
    struct hkl_data_texture const* pb = b;
    double s = pa->G - pb->G;

    if (!s) {
      return 0;
    } else {
      return (s < 0 ? -1 : 1);
    }
  } // SX_list_compare

  // Linear interpolation of scaled_associated_legendre in the table of order l
  double
  plmValue (int l, int m, double x, struct legendre_tables* legendre) {
    t_Table* table = legendre->plm_tables + l;
    long nx = table->rows;
    long ncol = table->columns;
    double dx = 2.0 / (nx - 1);
    long j;

    x = fmin (1.0, fmax (-1.0, x));
    j = (long)((x + 1.0) / dx);
    if (j > nx - 2) {
      j = nx - 2;
    }
    return Table_Interp1d (x, -1.0 + j * dx, table->data[j * ncol + l + m], -1.0 + (j + 1) * dx, table->data[(j + 1) * ncol + l + m]);
  }

  // Bilinear interpolation in a pole density table
  double
  interp2D (double x, double y, struct legendre_tables* legendre, t_Table* table) {
    int i, j;
    double* cos_theta_axis = legendre->cos_theta_axis;
    double* phi_axis = legendre->phi_axis;
    double* corner;

    i = (int)((x - cos_theta_axis[0]) / (cos_theta_axis[1] - cos_theta_axis[0]));
    j = (int)((y - phi_axis[0]) / (phi_axis[1] - phi_axis[0]));

    if (i < 0 || i >= legendre->n_cos_theta - 1) {
      if (i == legendre->n_cos_theta - 1 && fabs (x - cos_theta_axis[i]) < 1.0e-6) {
        i = i - 1;
      } else {
        fprintf (stderr, "Texture_process: cos(theta) = %.16e outside the table. Exit!\n", x);
        exit (-1);
      }
    } else if (i > 0 && x < cos_theta_axis[i]) {
      i = i - 1;
    }

    if (j < 0 || j >= legendre->n_phi - 1) {
      if (j == legendre->n_phi - 1 && fabs (y - phi_axis[j]) < 1.0e-6) {
        j = j - 1;
      } else {
        fprintf (stderr, "Texture_process: phi = %.16e outside the table. Exit!\n", y);
        exit (-1);
      }
    } else if (j > 0 && y < phi_axis[j]) {
      j = j - 1;
    }

    corner = table->data + i * legendre->n_phi + j;
    return Table_Interp2d (x, y, cos_theta_axis[i], phi_axis[j], cos_theta_axis[i + 1], phi_axis[j + 1], corner[0], corner[1], corner[legendre->n_phi], corner[legendre->n_phi + 1]);
  }

  /////////////////////
  /// legendre     ////
  /////////////////////

  struct legendre_tables*
  initLegendre (int lmax) {
    int j, l, m, nx;
    double x, dx;
    struct legendre_tables* legendre;

    legendre = (struct legendre_tables*)malloc (sizeof (struct legendre_tables));
    if (!legendre) {
      fprintf (stderr, "Texture_process: Failed struct malloc() in initLegendre. Exit!\n");
      exit (-1);
    }
    legendre->lmax = lmax;
    legendre->plm_tables = (t_Table*)malloc ((lmax + 1) * sizeof (t_Table));
    if (!legendre->plm_tables) {
      fprintf (stderr, "Texture_process: Failed malloc() in initLegendre. Exit!\n");
      exit (-1);
    }
    for (l = 0; l <= lmax; l++) {
      nx = 100 * (l + 1);
      dx = 2.0 / (nx - 1);
      Table_Init (legendre->plm_tables + l, nx, 2 * l + 1);
      for (j = 0; j < nx; j++) {
        x = (j < nx - 1 ? -1.0 + j * dx : 1.0);
        for (m = -l; m <= l; m++) {
          legendre->plm_tables[l].data[j * (2 * l + 1) + l + m] = scaled_associated_legendre (l, m, x);
        }
      }
    }

    legendre->n_cos_theta = 201;
    legendre->n_phi = 601;
    legendre->cos_theta_axis = (double*)malloc (legendre->n_cos_theta * sizeof (double));
    legendre->phi_axis = (double*)malloc (legendre->n_phi * sizeof (double));
    if (!legendre->cos_theta_axis || !legendre->phi_axis) {
      fprintf (stderr, "Texture_process: Failed malloc() in initLegendre. Exit!\n");
      exit (-1);
    }
    dx = 2.0 / (legendre->n_cos_theta - 1);
    for (j = 0; j < legendre->n_cos_theta - 1; j++) {
      legendre->cos_theta_axis[j] = -1.0 + j * dx;
    }
    legendre->cos_theta_axis[legendre->n_cos_theta - 1] = 1.0;
    dx = (2.0 * PI) / (legendre->n_phi - 1);
    for (j = 0; j < legendre->n_phi - 1; j++) {
      legendre->phi_axis[j] = -PI + j * dx;
    }
    legendre->phi_axis[legendre->n_phi - 1] = PI;

    return legendre;
  }

  // end legendre

  /////////////////////////////
  ////// Cross sections     ///
  /////////////////////////////

  // Total cross section of hkl at wavevector modulus k, with texture->plm_ki, cos_m_phi, sin_m_phi filled for its direction
  double
  total_hkl_XS (double k, struct hkl_data_texture* hkl, struct hkl_info_struct_texture* texture) {
    int l, m;
    int n = texture->lmax + 1;
    double x = (hkl->G) / (2 * k);
    double XS, upsilon_l, p_l, p_l_prev, p_l_next;
    double *XS_cos_coef, *XS_sin_coef, *plm_l;

    if (x > 1) {
      return 0;
    }

    // XS = 1 + sum_l P_l (x) Upsilon_l (kct, kphi), with the Legendre polynomials P_l from their recurrence
    XS = 1.0;
    p_l_prev = 1.0;
    p_l = x;
    for (l = 1; l <= texture->lmax; l++) {
      XS_cos_coef = hkl->XS_cos_coef + l * n;
      XS_sin_coef = hkl->XS_sin_coef + l * n;
      plm_l = texture->plm_ki + l * n;
      upsilon_l = 0;
      for (m = 0; m <= l; m++) {
        upsilon_l += plm_l[m] * (XS_cos_coef[m] * texture->cos_m_phi[m] + XS_sin_coef[m] * texture->sin_m_phi[m]);
      }
      XS += p_l * upsilon_l;
      p_l_next = ((2 * l + 1) * x * p_l - l * p_l_prev) / (l + 1);
      p_l_prev = p_l;
      p_l = p_l_next;
    }

    if (XS < 0) {
      hkl->n_negative_XS += 1;
    }

    // this is not the cross section. A different name (reflectivity??)
    // would be appropriate
    // there is a missed factor N*(2*pi)**3/(v0*k**3), which is a constant
    // and then applied only at the end
    XS *= (hkl->multiplicity) * (hkl->F2) / (4 * x);

    return XS;
  }

  // XS_cos_coef, XS_sin_coef of hkl from its V terms, with scaled_associated_legendre (l, -m) = (-1)^m scaled_associated_legendre (l, m)
  void
  xsCoefficients (struct hkl_data_texture* hkl, int lmax) {
    int i, l, m, m_abs;
    int n = lmax + 1;
    double sign;

    hkl->XS_cos_coef = (double*)calloc (n * n, sizeof (double));
    hkl->XS_sin_coef = (double*)calloc (n * n, sizeof (double));
    if (!hkl->XS_cos_coef || !hkl->XS_sin_coef) {
      fprintf (stderr, "Texture_process: Failed malloc() in xsCoefficients. Exit!\n");
      exit (-1);
    }
    for (i = 0; i < hkl->n_V; i++) {
      l = hkl->V_l[i];
      m = hkl->V_m[i];
      m_abs = abs (m);
      sign = (m < 0 && m_abs % 2) ? -1 : 1;
      // cos (V_phase - m kphi) = cos V_phase cos (m kphi) + sin V_phase sin (m kphi)
      hkl->XS_cos_coef[l * n + m_abs] += sign * hkl->V_modulus[i] * cos (hkl->V_phase[i]);
      hkl->XS_sin_coef[l * n + m_abs] += sign * (m < 0 ? -1 : 1) * hkl->V_modulus[i] * sin (hkl->V_phase[i]);
    }
  }

  int
  computeV (struct odf_coefficients* odf, struct hkl_data_texture* hkl, double V_tolerance) {
    int i, l, m, n, n_V;
    double G_cos_theta, G_phi, cos_nphi, sin_nphi, plm_n, V_real, V_imag;
    double **V_modulus, **V_phase;

    int lmax = odf->lmax;

    G_cos_theta = hkl->G_cos_theta;
    G_phi = hkl->G_phi;

    V_modulus = (double**)malloc ((lmax + 1) * sizeof (double*));
    for (l = 0; l <= lmax; l++) {
      V_modulus[l] = (double*)malloc ((2 * l + 1) * sizeof (double));
    }
    V_phase = (double**)malloc ((lmax + 1) * sizeof (double*));
    for (l = 0; l <= lmax; l++) {
      V_phase[l] = (double*)malloc ((2 * l + 1) * sizeof (double));
    }

    // compute V

    n_V = 0;
    for (l = 0; l <= lmax; l++) {
      for (m = -l; m <= l; m++) {
        V_real = 0;
        V_imag = 0;
        for (n = -l; n <= l; n++) {
          plm_n = scaled_associated_legendre (l, n, G_cos_theta); // this can be interpolated from legendre_ass_polynomial
          cos_nphi = cos (n * G_phi);
          sin_nphi = sin (n * G_phi);
          V_real += plm_n * ((odf->coef_real)[l][l + m][l + n] * cos_nphi - (odf->coef_imag)[l][l + m][l + n] * sin_nphi);
          V_imag += plm_n * ((odf->coef_real)[l][l + m][l + n] * sin_nphi + (odf->coef_imag)[l][l + m][l + n] * cos_nphi);
        }
        V_modulus[l][l + m] = sqrt (V_real * V_real + V_imag * V_imag);
        V_phase[l][l + m] = atan2 (V_imag, V_real);
        if (V_modulus[l][l + m] > V_tolerance) {
          n_V++;
        }
      }
    }


    hkl->n_V = n_V;
    hkl->V_l = (int*)malloc (n_V * sizeof (int));
    hkl->V_m = (int*)malloc (n_V * sizeof (int));
    hkl->V_modulus = (double*)malloc (n_V * sizeof (double));
    hkl->V_phase = (double*)malloc (n_V * sizeof (double));

    i = -1;
    for (l = 0; l <= lmax; l++) {
      for (m = -l; m <= l; m++) {
        if (V_modulus[l][l + m] > V_tolerance) {
          i++;
          (hkl->V_l)[i] = l;
          (hkl->V_m)[i] = m;
          (hkl->V_modulus)[i] = V_modulus[l][l + m];
          (hkl->V_phase)[i] = V_phase[l][l + m];
        }
      }
    }


    // free memory
    for (l = 0; l <= lmax; l++) {
      free (V_modulus[l]);
      free (V_phase[l]);
    }
    free (V_modulus);
    free (V_phase);


    return 0;
  }

  // end cross sections

  ////////////////////////////////
  /// Sampling                  //
  ////////////////////////////////

  // Unit vector of kf at azimuth phi around ki_unit
  Coords
  kfDirection (struct kf_phi_table* phi_table, double phi) {
    Coords cone = coords_add (coords_scale (phi_table->perp_1, phi_table->sin_scattering_angle * cos (phi)), coords_scale (phi_table->perp_2, phi_table->sin_scattering_angle * sin (phi)));
    return coords_add (cone, coords_scale (phi_table->ki_unit, phi_table->cos_scattering_angle));
  }

  // Samples kf for reflection hkl and wavevector ki by rejection on the pole density of q on the Bragg circle. With
  // texture->use_phi_table, the density is tabulated at n points the first time phi_table is used for a wavevector and bounded by
  // its largest value there; otherwise it is read from pole_density at each try and bounded by pole_density_max.
  int
  sampleKprime_hkl (double* kf, Coords ki, struct kf_phi_table* phi_table, struct hkl_data_texture* hkl, struct hkl_info_struct_texture* texture) {
    int i_try, j;
    int n = texture->n_phi_points;
    double k_over_G, phi, prob, prob_0, prob_1;
    double dphi = (2.0 * PI) / (n - 1);
    Coords q_unit, kf_out;
    Coords kf_unit = coords_set (0, 0, 0);

    k_over_G = coords_len (ki) / (hkl->G);
    if (!phi_table->built) {
      phi_table->built = 1;
      phi_table->ki_modulus = coords_len (ki);
      phi_table->ki_unit = coords_scale (ki, 1.0 / phi_table->ki_modulus);

      phi_table->cos_scattering_angle = 1.0 - 0.5 / (k_over_G * k_over_G);
      phi_table->sin_scattering_angle = sqrt (1.0 - phi_table->cos_scattering_angle * phi_table->cos_scattering_angle);

      // right-handed orthonormal triad
      normal_vec (&phi_table->perp_1.x, &phi_table->perp_1.y, &phi_table->perp_1.z, phi_table->ki_unit.x, phi_table->ki_unit.y, phi_table->ki_unit.z);
      phi_table->perp_2 = coords_xp (phi_table->ki_unit, phi_table->perp_1);

      if (texture->use_phi_table) {
        // probability of the unit scattering vector q_unit = k_over_G * (ki_unit - kf_unit) at the n points, in prob_offset
        phi_table->max_probability = -1.0e99;
        phi = -PI;
        for (j = 0; j < n - 1; j++) {
          q_unit = coords_scale (coords_sub (phi_table->ki_unit, kfDirection (phi_table, phi)), k_over_G);
          phi_table->prob_offset[j] = interp2D (q_unit.z, atan2 (q_unit.y, q_unit.x), texture->legendre_ass_polynomial, &hkl->pole_density);
          if (phi_table->prob_offset[j] > phi_table->max_probability) {
            phi_table->max_probability = phi_table->prob_offset[j];
          }
          phi += dphi;
        }
        phi_table->prob_offset[n - 1] = phi_table->prob_offset[0];

        // linear interpolation between the points
        phi = -PI;
        for (j = 0; j < n - 1; j++) {
          prob_0 = phi_table->prob_offset[j];
          prob_1 = phi_table->prob_offset[j + 1];
          phi_table->prob_offset[j] = prob_0 - phi * (prob_1 - prob_0) / dphi;
          phi_table->prob_slope[j] = (prob_1 - prob_0) / dphi;
          phi += dphi;
        }
      }
    }

    // rejection method
    for (i_try = 0; i_try < texture->max_iter_reject; i_try++) {
      phi = -PI + 2 * PI * rand01 ();
      if (texture->use_phi_table) {
        j = (int)((PI + phi) / dphi);
        prob = phi_table->prob_offset[j] + phi * phi_table->prob_slope[j];
        if (prob / phi_table->max_probability > rand01 ()) {
          kf_unit = kfDirection (phi_table, phi);
          break;
        }
      } else {
        kf_unit = kfDirection (phi_table, phi);
        q_unit = coords_scale (coords_sub (phi_table->ki_unit, kf_unit), k_over_G);
        prob = interp2D (q_unit.z, atan2 (q_unit.y, q_unit.x), texture->legendre_ass_polynomial, &hkl->pole_density);
        if (prob > rand01 () * hkl->pole_density_max) {
          break;
        }
      }
    }
    if (i_try == texture->max_iter_reject) {
      fprintf (stderr, "Texture_process: too many iterations sampling hkl %d %d %d. Exit!\n", hkl->h, hkl->k, hkl->l);
      exit (-1);
    }

    kf_out = coords_scale (kf_unit, phi_table->ki_modulus);
    kf[0] = kf_out.x;
    kf[1] = kf_out.y;
    kf[2] = kf_out.z;
    return 0;
  }

  // Allocates and fills the pole density of hkl on the axes of the pole density tables,
  //   sum_i V_modulus_i plm (V_l_i, V_m_i, cos_theta) cos (V_phase_i - V_m_i phi)
  //   = sum_{m >= 0} cos_coef_m (cos_theta) cos (m phi) + sin_coef_m (cos_theta) sin (m phi),
  // with the V terms of m and -m summed into cos_coef_m and sin_coef_m for each cos_theta
  void
  fillPoleTable (t_Table* table, struct hkl_data_texture* hkl, struct legendre_tables* legendre) {
    int i_cos_theta, i_phi, i_V, m, m_abs;
    int n_m = legendre->lmax + 1; // m = 0 ... lmax
    double sign, weight, density;
    double* cos_V_phase = (double*)malloc (hkl->n_V * sizeof (double));
    double* sin_V_phase = (double*)malloc (hkl->n_V * sizeof (double));
    double* cos_coef = (double*)malloc (n_m * sizeof (double));
    double* sin_coef = (double*)malloc (n_m * sizeof (double));
    double* cos_m_phi = (double*)malloc (n_m * legendre->n_phi * sizeof (double)); // at [i_phi * n_m + m]
    double* sin_m_phi = (double*)malloc (n_m * legendre->n_phi * sizeof (double));

    if ((hkl->n_V > 0 && (!cos_V_phase || !sin_V_phase)) || !cos_coef || !sin_coef || !cos_m_phi || !sin_m_phi) {
      fprintf (stderr, "Texture_process: Failed malloc() in fillPoleTable. Exit!\n");
      exit (-1);
    }
    for (i_V = 0; i_V < hkl->n_V; i_V++) {
      cos_V_phase[i_V] = cos (hkl->V_phase[i_V]);
      sin_V_phase[i_V] = sin (hkl->V_phase[i_V]);
    }
    for (i_phi = 0; i_phi < legendre->n_phi; i_phi++) {
      for (m = 0; m < n_m; m++) {
        cos_m_phi[i_phi * n_m + m] = cos (m * legendre->phi_axis[i_phi]);
        sin_m_phi[i_phi * n_m + m] = sin (m * legendre->phi_axis[i_phi]);
      }
    }

    Table_Init (table, legendre->n_cos_theta, legendre->n_phi);
    for (i_cos_theta = 0; i_cos_theta < legendre->n_cos_theta; i_cos_theta++) {
      for (m = 0; m < n_m; m++) {
        cos_coef[m] = 0;
        sin_coef[m] = 0;
      }
      // cos (V_phase - V_m phi) = cos V_phase cos (V_m phi) + sin V_phase sin (V_m phi), and sin (-m phi) = -sin (m phi)
      for (i_V = 0; i_V < hkl->n_V; i_V++) {
        m_abs = abs (hkl->V_m[i_V]);
        sign = 1;
        if (hkl->V_m[i_V] < 0) {
          sign = -1;
        }
        weight = hkl->V_modulus[i_V] * plmValue (hkl->V_l[i_V], hkl->V_m[i_V], legendre->cos_theta_axis[i_cos_theta], legendre);
        cos_coef[m_abs] += weight * cos_V_phase[i_V];
        sin_coef[m_abs] += sign * weight * sin_V_phase[i_V];
      }
      for (i_phi = 0; i_phi < legendre->n_phi; i_phi++) {
        density = 0;
        for (m = 0; m < n_m; m++) {
          density += cos_coef[m] * cos_m_phi[i_phi * n_m + m] + sin_coef[m] * sin_m_phi[i_phi * n_m + m];
        }
        table->data[i_cos_theta * legendre->n_phi + i_phi] = density;
      }
    }

    free (cos_V_phase);
    free (sin_V_phase);
    free (cos_coef);
    free (sin_coef);
    free (cos_m_phi);
    free (sin_m_phi);
  }

  // end sampling

  ///////////////////////////
  //// Input - Output      //
  ///////////////////////////

  // Converts a CIF file to a temporary NCMAT file with ncrystal_cif2ncmat, and returns its name
  char*
  cif2ncmat_texture (char* infile) {
    char cmd[3200];
    char inpath[1024];
    FILE* file = Open_File (infile, "r", inpath);
    char* outfile = (char*)malloc (1024);

    if (!file || !outfile) {
      fprintf (stderr, "Texture: Error: Could not open %s\n", infile);
      if (file) {
        fclose (file);
      }
      free (outfile);
      return NULL;
    }
    fclose (file);

    snprintf (outfile, 1024, "%s.ncmat", tmpnam (NULL));
    snprintf (cmd, sizeof (cmd), "ncrystal_cif2ncmat \"%s\" --output \"%s\" --quiet", inpath, outfile);
    if (system (cmd) != 0) {
      fprintf (stderr, "Texture: Error: Could not convert %s with ncrystal_cif2ncmat, which needs the Python modules gemmi and spglib\n", infile);
      free (outfile);
      return NULL;
    }
    return outfile;
  }

  // Fills a table with one row per family of reflections of an NCrystal material
  // and the header of a reflection file: h, k, l, |F|^2 in barns, multiplicity
  void
  read_hkl_table_ncrystal_texture (const char* cfgstr, t_Table* table) {
    unsigned spacegroup, n_atoms;
    double lattice_a, lattice_b, lattice_c, alpha, beta, gamma, cell_volume, d_spacing, F2_ncrystal, F2_scale;
    int i_hkl, h, k, l, multiplicity, n_hkl, nonoriented;
    ncrystal_scatter_t scat;
    ncrystal_info_t ncobj;

    mccode_setup_ncrystal_search_paths ();
    scat = ncrystal_create_scatter (cfgstr);
    nonoriented = ncrystal_isnonoriented (ncrystal_cast_scat2proc (scat));
    ncrystal_unref (&scat);
    if (!nonoriented) {
      fprintf (stderr, "Texture_process: The NCrystal cfg-string \"%s\" must not specify a crystal orientation. Exit!\n", cfgstr);
      exit (-1);
    }

    ncobj = ncrystal_create_info (cfgstr);
    n_hkl = ncrystal_info_nphases (ncobj) > 0 ? 0 : ncrystal_info_nhkl (ncobj);
    if (n_hkl <= 0 || !ncrystal_info_getstructure (ncobj, &spacegroup, &lattice_a, &lattice_b, &lattice_c, &alpha, &beta, &gamma, &cell_volume, &n_atoms)) {
      fprintf (stderr, "Texture_process: The NCrystal material \"%s\" must have one crystalline phase with reflections. Exit!\n", cfgstr);
      exit (-1);
    }

    // The cross sections assume the density implied by the unit cell
    F2_scale = ncrystal_info_getnumberdensity (ncobj) * cell_volume / n_atoms;

    if (!Table_Init (table, n_hkl, 5)) {
      fprintf (stderr, "Texture_process: Could not allocate reflection table for \"%s\". Exit!\n", cfgstr);
      exit (-1);
    }
    for (i_hkl = 0; i_hkl < n_hkl; i_hkl++) {
      ncrystal_info_gethkl (ncobj, i_hkl, &h, &k, &l, &multiplicity, &d_spacing, &F2_ncrystal);
      if (h == 0 && k == 0 && l == 0) {
        fprintf (stderr, "Texture_process: The NCrystal material \"%s\" does not provide hkl indices. Exit!\n", cfgstr);
        exit (-1);
      }
      table->data[i_hkl * 5 + 0] = h;
      table->data[i_hkl * 5 + 1] = k;
      table->data[i_hkl * 5 + 2] = l;
      table->data[i_hkl * 5 + 3] = F2_ncrystal * F2_scale;
      table->data[i_hkl * 5 + 4] = multiplicity;
    }

    table->header = (char*)malloc (1024);
    if (!table->header) {
      fprintf (stderr, "Texture_process: Failed malloc() reading \"%s\". Exit!\n", cfgstr);
      exit (-1);
    }
    snprintf (table->header, 1024,
              "# lattice_a %.17g\n# lattice_b %.17g\n# lattice_c %.17g\n"
              "# lattice_aa %.17g\n# lattice_bb %.17g\n# lattice_cc %.17g\n"
              "# column_h 1\n# column_k 2\n# column_l 3\n# column_F2 4\n# column_j 5\n",
              lattice_a, lattice_b, lattice_c, alpha, beta, gamma);

    ncrystal_unref (&ncobj);
  }

  // Right-handed orthonormal basis: basis[0] || v1, basis[1] in the plane of v1 and v2
  int
  directionBasis (Coords v1, Coords v2, Coords* basis) {
    Coords normal = coords_xp (v1, v2);
    if (coords_len (v1) == 0 || coords_len (normal) < 1e-12 * coords_len (v1) * coords_len (v2)) {
      return 0;
    }
    basis[0] = coords_scale (v1, 1.0 / coords_len (v1));
    basis[2] = coords_scale (normal, 1.0 / coords_len (normal));
    basis[1] = coords_xp (basis[2], basis[0]);
    return 1;
  }

  // Rotation that takes crystal_dir_1 onto component_dir_1, and crystal_dir_2 into the plane of component_dir_1 and component_dir_2
  void
  directionRotation (Coords crystal_dir_1, Coords crystal_dir_2, Coords component_dir_1, Coords component_dir_2, Rotation rotation) {
    Coords crystal_basis[3], component_basis[3];
    double crystal_matrix[3][3], component_matrix[3][3];
    int i, j, k;

    if (!directionBasis (crystal_dir_1, crystal_dir_2, crystal_basis) || !directionBasis (component_dir_1, component_dir_2, component_basis)) {
      fprintf (stderr, "Texture_process: the directions of the two lattice vectors must be nonzero and not parallel. Exit!\n");
      exit (-1);
    }
    for (k = 0; k < 3; k++) {
      coords_get (crystal_basis[k], crystal_matrix[k], crystal_matrix[k] + 1, crystal_matrix[k] + 2);
      coords_get (component_basis[k], component_matrix[k], component_matrix[k] + 1, component_matrix[k] + 2);
    }
    // rotation = sum_k component_basis_k crystal_basis_k^T
    for (i = 0; i < 3; i++) {
      for (j = 0; j < 3; j++) {
        rotation[i][j] = component_matrix[0][i] * crystal_matrix[0][j] + component_matrix[1][i] * crystal_matrix[1][j] + component_matrix[2][i] * crystal_matrix[2][j];
      }
    }
  }

  // Lattice vectors along the three directions lattice_directions, with the lengths of lattice_vectors. The angles between the directions
  // must be those between the lattice vectors, and the directions must be right-handed.
  void
  latticeAlongAxes (struct hkl_info_struct_texture* texture) {
    double angle_tolerance = 1e-4; // rad
    double angle_lat, angle_dir;
    Coords directions[3];
    int i, i_next, i_last;
    char axis_name[3] = { 'a', 'b', 'c' };

    for (i = 0; i < 3; i++) {
      directions[i] = coords_scale (texture->lattice_directions[i], 1.0 / coords_len (texture->lattice_directions[i]));
    }
    for (i = 0; i < 3; i++) {
      i_next = (i + 1) % 3;
      i_last = (i + 2) % 3;
      angle_lat = acos (coords_sp (texture->lattice_vectors[i_next], texture->lattice_vectors[i_last]) / (coords_len (texture->lattice_vectors[i_next]) * coords_len (texture->lattice_vectors[i_last])));
      angle_dir = acos (fmax (-1.0, fmin (1.0, coords_sp (directions[i_next], directions[i_last]))));
      if (fabs (angle_dir - angle_lat) > angle_tolerance) {
        fprintf (stderr, "Texture_process: the directions of %c and %c are %g deg apart, but %g deg in the lattice of crystal_fn. Exit!\n", axis_name[i_next],
                 axis_name[i_last], angle_dir * RAD2DEG, angle_lat * RAD2DEG);
        exit (-1);
      }
    }
    if (coords_sp (directions[0], coords_xp (directions[1], directions[2])) <= 0) {
      fprintf (stderr, "Texture_process: the directions of a, b and c must be right-handed. Exit!\n");
      exit (-1);
    }
    for (i = 0; i < 3; i++) {
      texture->lattice_vectors[i] = coords_scale (directions[i], coords_len (texture->lattice_vectors[i]));
    }
  }

  int
  read_hkl_data_texture (char* crystal_file, struct hkl_info_struct_texture* texture) {
    struct hkl_data_texture* hkl_list = NULL;
    int n_rows = 0;
    t_Table hkl_table; //
    int i = 0;
    double tmp_x, tmp_y, tmp_z;
    char** header_values;
    double h = 0, k = 0, l = 0, F2 = 0;
    double Gx, Gy, Gz;
    int multiplicity = -1;
    // columns of h, k, l, F, F2, j, counted from 1
    int column_order[6] = { 1, 2, 3, 0, 7, 4 };
    double m_a = 0, m_b = 0, m_c = 0;    // lattice parameter lengths
    double m_aa = 0, m_bb = 0, m_cc = 0; // lattice angles
    double m_ax, m_ay, m_az;             // First unit cell axis (direct space, AA)
    double m_bx, m_by, m_bz;             // Second unit cell axis
    double m_cx, m_cy, m_cz;             // Third unit cell axis
    double asx, asy, asz;                // First reciprocal lattice axis (1/AA)
    double bsx, bsy, bsz;                // Second reciprocal lattice axis
    double csx, csy, csz;                // Third reciprocal lattice axis
    char* filename;
    char* extension;
    int i_first, i_second; // the first two lattice vectors placed by lattice_directions
    int n_given;           // number of lattice vectors placed by lattice_directions
    Rotation rotation;

    if (!crystal_file || !strlen (crystal_file) || !strcmp (crystal_file, "NULL") || !strcmp (crystal_file, "0")) {
      texture->num_hkl = 0;
      return -1;
    }

    // Read the table

    extension = strrchr (crystal_file, '.');
    if (extension && !strcasecmp (extension, ".cif")) {
      filename = cif2ncmat_texture (crystal_file);
      if (!filename) {
        return 0;
      }
      read_hkl_table_ncrystal_texture (filename, &hkl_table);
      remove (filename);
      free (filename);
      texture->F2_in_barns = 1;
    } else if (strstr (crystal_file, ".ncmat") != NULL || strstr (crystal_file, "::") != NULL) {
      read_hkl_table_ncrystal_texture (crystal_file, &hkl_table);
      texture->F2_in_barns = 1;
    } else if (Table_Read (&hkl_table, crystal_file, 1) <= 0) { // read 1st block data from crystal_file into hkl_table
      fprintf (stderr, "Texture: Error: Could not read reflections from %s\n", crystal_file);
      return 0;
    }
    if (hkl_table.columns < 5) {
      fprintf (stderr, "Texture: Error: The number of columns in %s should be", crystal_file);
      fprintf (stderr, " at least %d for [h,k,l,F2,j]\n", 5);
      Table_Free (&hkl_table);
      return (0);
    }
    if (!hkl_table.rows) {
      fprintf (stderr, "Texture: Error: The number of rows in %s should be at least %d\n", crystal_file, 1);
      Table_Free (&hkl_table);
      return 0;
    } else {
      n_rows = hkl_table.rows;
    }

    // parsing of header
    header_values = Table_ParseHeader (hkl_table.header, "column_h", "column_k", "column_l", "column_F ", "column_F2", "column_j", "lattice_a ", "lattice_b ", "lattice_c ",
                                 "lattice_aa", "lattice_bb", "lattice_cc", NULL);

    if (header_values) {
      for (i = 0; i < 6; i++) {
        if (header_values[i])
          column_order[i] = atoi (header_values[i]);
      }
      if (header_values[6])
        m_a = atof (header_values[6]);
      if (header_values[7])
        m_b = atof (header_values[7]);
      if (header_values[8])
        m_c = atof (header_values[8]);
      if (header_values[9])
        m_aa = atof (header_values[9]);
      if (header_values[10])
        m_bb = atof (header_values[10]);
      if (header_values[11])
        m_cc = atof (header_values[11]);
      for (i = 0; i < 12; i++) {
        if (header_values[i]) {
          free (header_values[i]);
        }
      }
      free (header_values);
    }

    // parameters consistency checks
    if (!m_a) {
      fprintf (stderr, "Texture: Error: Wrong a lattice vector definition\n");
      Table_Free (&hkl_table);
      return (0);
    }

    // lengths and angles missing from the data file
    if (!m_b) {
      m_b = m_a;
    }
    if (!m_c) {
      m_c = m_b;
    }
    if (!m_aa) {
      m_aa = 90;
    }
    if (!m_bb) {
      m_bb = m_aa;
    }
    if (!m_cc) {
      m_cc = m_bb;
    }

    // NCrystal: x || a and b in the xy plane, so z || c*
    m_cx = m_c * cos (m_bb * DEG2RAD);
    m_cy = m_c * (cos (m_aa * DEG2RAD) - cos (m_bb * DEG2RAD) * cos (m_cc * DEG2RAD)) / sin (m_cc * DEG2RAD);
    texture->lattice_vectors[0] = coords_set (m_a, 0, 0);
    texture->lattice_vectors[1] = coords_set (m_b * cos (m_cc * DEG2RAD), m_b * sin (m_cc * DEG2RAD), 0);
    texture->lattice_vectors[2] = coords_set (m_cx, m_cy, sqrt (m_c * m_c - m_cx * m_cx - m_cy * m_cy));

    // place the lattice along the given directions of lattice_directions, or rotate it to the MTEX axes z || c and x || a*
    i_first = -1;
    i_second = -1;
    n_given = 0;
    for (i = 0; i < 3; i++) {
      if (coords_len (texture->lattice_directions[i]) > 0) {
        n_given++;
        if (i_first < 0) {
          i_first = i;
        } else if (i_second < 0) {
          i_second = i;
        }
      }
    }
    if (n_given == 3) {
      latticeAlongAxes (texture);
    } else if (texture->use_mtex_axes || n_given == 2) {
      if (texture->use_mtex_axes) {
        directionRotation (texture->lattice_vectors[2], coords_xp (texture->lattice_vectors[1], texture->lattice_vectors[2]), coords_set (0, 0, 1), coords_set (1, 0, 0), rotation);
      } else {
        directionRotation (texture->lattice_vectors[i_first], texture->lattice_vectors[i_second], texture->lattice_directions[i_first], texture->lattice_directions[i_second], rotation);
      }
      for (i = 0; i < 3; i++) {
        texture->lattice_vectors[i] = rot_apply (rotation, texture->lattice_vectors[i]);
      }
    }
    coords_get (texture->lattice_vectors[0], &m_ax, &m_ay, &m_az);
    coords_get (texture->lattice_vectors[1], &m_bx, &m_by, &m_bz);
    coords_get (texture->lattice_vectors[2], &m_cx, &m_cy, &m_cz);

    // Compute reciprocal lattice vectors.
    vec_prod (tmp_x, tmp_y, tmp_z, m_bx, m_by, m_bz, m_cx, m_cy, m_cz);
    texture->cell_volume = fabs (scalar_prod (m_ax, m_ay, m_az, tmp_x, tmp_y, tmp_z));
    asx = 2 * PI / texture->cell_volume * tmp_x;
    asy = 2 * PI / texture->cell_volume * tmp_y;
    asz = 2 * PI / texture->cell_volume * tmp_z;

    vec_prod (tmp_x, tmp_y, tmp_z, m_cx, m_cy, m_cz, m_ax, m_ay, m_az);
    bsx = 2 * PI / texture->cell_volume * tmp_x;
    bsy = 2 * PI / texture->cell_volume * tmp_y;
    bsz = 2 * PI / texture->cell_volume * tmp_z;

    vec_prod (tmp_x, tmp_y, tmp_z, m_ax, m_ay, m_az, m_bx, m_by, m_bz);
    csx = 2 * PI / texture->cell_volume * tmp_x;
    csy = 2 * PI / texture->cell_volume * tmp_y;
    csz = 2 * PI / texture->cell_volume * tmp_z;

    if (!column_order[0] || !column_order[1] || !column_order[2]) {
      fprintf (stderr, "Texture: Error: Wrong h,k,l column definition\n");
      Table_Free (&hkl_table);
      return (0);
    }
    if (!column_order[3] && !column_order[4]) {
      fprintf (stderr, "Texture: Error: Wrong F,F2 column definition\n");
      Table_Free (&hkl_table);
      return (0);
    }

    // allocate hkl_data array
    hkl_list = (struct hkl_data_texture*)malloc (n_rows * sizeof (struct hkl_data_texture));

    // write the data to data structures
    for (i = 0; i < n_rows; i++) {
      h = Table_Index (hkl_table, i, column_order[0] - 1);
      k = Table_Index (hkl_table, i, column_order[1] - 1);
      l = Table_Index (hkl_table, i, column_order[2] - 1);
      if (column_order[3]) {
        F2 = Table_Index (hkl_table, i, column_order[3] - 1);
        F2 *= F2;
      } else if (column_order[4]) {
        F2 = Table_Index (hkl_table, i, column_order[4] - 1);
      }
      multiplicity = Table_Index (hkl_table, i, column_order[5] - 1);
      hkl_list[i].h = h;
      hkl_list[i].k = k;
      hkl_list[i].l = l;
      hkl_list[i].F2 = F2;
      hkl_list[i].multiplicity = multiplicity;
      Gx = h * asx + k * bsx + l * csx;
      Gy = h * asy + k * bsy + l * csy;
      Gz = h * asz + k * bsz + l * csz;
      hkl_list[i].G = sqrt (Gx * Gx + Gy * Gy + Gz * Gz);
      hkl_list[i].G_cos_theta = Gz / hkl_list[i].G;
      hkl_list[i].G_phi = atan2 (Gy / hkl_list[i].G, Gx / hkl_list[i].G);
    }

    Table_Free (&hkl_table);

    // sort the list with increasing G
    qsort (hkl_list, i, sizeof (struct hkl_data_texture), SX_list_compare_texture);

    // Reflections with G > 2k cannot scatter
    while (texture->wavelength_min > 0 && i > 0 && hkl_list[i - 1].G > 4 * PI / texture->wavelength_min) {
      i--;
    }

    texture->hkl_list = hkl_list;
    texture->num_hkl = i;


    return texture->num_hkl;
  } // read_hkl_data

  void
  allocateFourierCoef (int lmax, struct odf_coefficients* odf) {
    int l, m;
    if (lmax >= 0) {
      odf->lmax = lmax;
      odf->coef_real = (double***)malloc ((lmax + 1) * sizeof (double**));
      odf->coef_imag = (double***)malloc ((lmax + 1) * sizeof (double**));
      for (l = 0; l <= lmax; l++) {
        (odf->coef_real)[l] = (double**)malloc ((2 * l + 1) * sizeof (double*));
        (odf->coef_imag)[l] = (double**)malloc ((2 * l + 1) * sizeof (double*));
        for (m = -l; m <= l; m++) {
          (odf->coef_real)[l][m + l] = (double*)malloc ((2 * l + 1) * sizeof (double));
          (odf->coef_imag)[l][m + l] = (double*)malloc ((2 * l + 1) * sizeof (double));
        }
      }
    } else {
      odf->lmax = -1;
      odf->coef_real = NULL;
      odf->coef_imag = NULL;
    }
  } // allocateFourierCoef

  // Fills table with the rows l m n Real(Clmn) Imag(Clmn) of a binary coefficient file, see fcoef_fn
  void
  readFourierCoefBinary (char* filename, t_Table* table) {
    long n_bytes, n_rows, i_row;
    size_t n_read; // doubles read for one row
    int lmax, l, n, m;
    FILE* file = Open_File (filename, "rb", NULL);

    if (!file) {
      fprintf (stderr, "Texture_process: Could not open %s. Exit!\n", filename);
      exit (-1);
    }
    fseek (file, 0, SEEK_END);
    n_bytes = ftell (file);
    rewind (file);
    n_rows = n_bytes / (2 * sizeof (double));
    lmax = 0;
    while ((lmax + 1) * (2 * lmax + 1) * (2 * lmax + 3) / 3 < n_rows) {
      lmax++;
    }
    if (n_rows < 1 || n_bytes != n_rows * 2 * (long)sizeof (double) || (lmax + 1) * (2 * lmax + 1) * (2 * lmax + 3) / 3 != n_rows) {
      fprintf (stderr, "Texture_process: %s has %ld bytes, which is not 16 (lmax + 1) (2 lmax + 1) (2 lmax + 3) / 3 for any lmax. Exit!\n", filename, n_bytes);
      exit (-1);
    }

    Table_Init (table, n_rows, 5);
    i_row = 0;
    for (l = 0; l <= lmax; l++) {
      for (n = -l; n <= l; n++) {
        for (m = -l; m <= l; m++) {
          table->data[i_row * table->columns + 0] = l;
          table->data[i_row * table->columns + 1] = n;
          table->data[i_row * table->columns + 2] = m;
          n_read = fread (table->data + i_row * table->columns + 3, sizeof (double), 2, file);
          if (n_read != 2) {
            fprintf (stderr, "Texture_process: Could not read %s. Exit!\n", filename);
            exit (-1);
          }
          i_row++;
        }
      }
    }
    fclose (file);
  }

  void
  readFourierCoef (char* filename, struct odf_coefficients* odf) {
    int i, lmax, n_rows, l, m, n, sign_mn, sign;
    double c_real, c_imag, c_real_mirror, c_imag_mirror, deviation, max_deviation;
    t_Table table;

    // Note: if the coeeficients have been obtained from mtex
    // with l2-normalization option, they have to be multiplied
    // by sqrt(2*l+1)

    char* extension = strrchr (filename, '.');
    if (extension && !strcmp (extension, ".bin")) {
      readFourierCoefBinary (filename, &table);
    } else {
      Table_Read (&table, filename, 1);
    }
    if (table.rows < 1 || table.columns != 5) {
      fprintf (stderr, "Texture_process: %s must have five columns: l m n Real(Clmn) Imag(Clmn). Exit!\n", filename);
      exit (-1);
    }

    lmax = (int)round (Table_Index (table, table.rows - 1, 0));
    n_rows = (lmax + 1) * (2 * lmax + 1) * (2 * lmax + 3) / 3;
    if (lmax < 0 || n_rows != table.rows) {
      fprintf (stderr, "Texture_process: %s has %ld rows, but lmax = %d needs %d. Exit!\n", filename, table.rows, lmax, n_rows);
      exit (-1);
    }

    if (odf->lmax >= 0 && lmax > odf->lmax) {
      lmax = odf->lmax;
    }

    allocateFourierCoef (lmax, odf);

    n_rows = (lmax + 1) * (2 * lmax + 1) * (2 * lmax + 3) / 3;
    for (i = 0; i < n_rows; i++) {
      l = (int)round (Table_Index (table, i, 0));
      n = (int)round (Table_Index (table, i, 1)); // TRANSPOSEE
      m = (int)round (Table_Index (table, i, 2)); // TRANSPOSEE
      sign_mn = ((m < 0 ? -m : 0) + (n < 0 ? -n : 0)) % 2 ? -1 : 1;
      (odf->coef_real)[l][l + m][l + n] = sign_mn * Table_Index (table, i, 3);
      (odf->coef_imag)[l][l + m][l + n] = sign_mn * -Table_Index (table, i, 4); // conjugate
    }
    Table_Free (&table);

    // check reality of ODF
    max_deviation = 0;
    for (l = 0; l <= lmax; l++) {
      for (m = -l; m <= l; m++) {
        for (n = -l; n <= l; n++) {
          c_real = (odf->coef_real)[l][l + m][l + n];
          c_imag = (odf->coef_imag)[l][l + m][l + n];
          c_real_mirror = (odf->coef_real)[l][l - m][l - n];
          c_imag_mirror = (odf->coef_imag)[l][l - m][l - n];
          if (abs (m - n) % 2) {
            c_real_mirror = -c_real_mirror;
            c_imag_mirror = -c_imag_mirror;
          }
          deviation = sqrt (pow (c_real - c_real_mirror, 2) + pow (-c_imag - c_imag_mirror, 2));
          if (deviation > max_deviation) {
            max_deviation = deviation;
          }
        }
      }
    }

    if (max_deviation > 1.0e-6) {
      printf ("Texture_process: %s does not satisfy the reality condition of the ODF (%.6e). Imposing it.\n", filename, max_deviation);
      for (l = 0; l <= lmax; l++) {
        (odf->coef_imag)[l][l][l] = 0;
        for (m = 0; m <= l; m++) {
          for (n = (m ? -l : 1); n <= l; n++) {
            sign = abs (m - n) % 2 ? -1 : 1;
            (odf->coef_real)[l][l - m][l - n] = sign * (odf->coef_real)[l][l + m][l + n];
            (odf->coef_imag)[l][l - m][l - n] = -sign * (odf->coef_imag)[l][l + m][l + n];
          }
        }
      }
    }
  } // readFourierCoef

  // end Input - Output

  // Cache entry of the wavevector k, moved to the front of texture->ki_cache. When k is not in the cache, the
  // least recently used entry is overwritten with the cross sections of k, and its sampling tables are reset.
  struct ki_cache_entry*
  kiEntry (double* k, struct hkl_info_struct_texture* texture) {
    int i, i_saved;
    int i_hit = -1; // entry of saved that holds k, -1 if none
    int i_entry;    // entry of saved that is used and moved to the front
    int m;
    double ki_modulus, ki_cos_theta, ki_phi, coherent_XS;
    struct ki_cache_entry used_entry;
    struct ki_cache_entry* cache = texture->ki_cache;
    struct ki_cache_entry* new_entry;
    struct hkl_data_texture* hkl_list = texture->hkl_list;

    for (i_saved = 0; i_saved < texture->n_cached; i_saved++) {
      if (k[0] == cache[i_saved].ki.x && k[1] == cache[i_saved].ki.y && k[2] == cache[i_saved].ki.z) {
        i_hit = i_saved;
        break;
      }
    }

    if (i_hit >= 0) {
      // k is in the cache: reuse its cross sections and sampling tables
      i_entry = i_hit;
    } else {
      i_entry = texture->n_cached - 1;
      new_entry = cache + i_entry;
      new_entry->ki = coords_set (k[0], k[1], k[2]);

      // polar coordinates of the wavevector
      ki_modulus = sqrt (k[0] * k[0] + k[1] * k[1] + k[2] * k[2]);
      ki_cos_theta = k[2] / ki_modulus;
      ki_phi = atan2 (k[1], k[0]);
      all_scaled_associated_legendre (texture->lmax, fmin (1.0, fmax (-1.0, ki_cos_theta)), texture->legendre_norm, texture->plm_ki);
      for (m = 0; m <= texture->lmax; m++) {
        texture->cos_m_phi[m] = cos (m * ki_phi);
        texture->sin_m_phi[m] = sin (m * ki_phi);
      }

      // reflections with G > 2 ki cannot scatter
      new_entry->last_hkl = -1;
      coherent_XS = 0;
      for (i = 0; i < texture->num_hkl && hkl_list[i].G <= 2 * ki_modulus; i++) {
        new_entry->last_hkl = i;
        new_entry->XS_ki[i] = total_hkl_XS (ki_modulus, hkl_list + i, texture);
        new_entry->phi_tables[i].built = 0;
        coherent_XS += new_entry->XS_ki[i];
      }

      // multiply by the appropriate factors to get the linear attenuation coefficient coherent_mu (in m^-1)
      new_entry->coherent_mu = coherent_XS * (texture->XS_to_mu) * pow ((2 * PI) / ki_modulus, 3) / (texture->cell_volume);
    }

    // move the used entry to the front
    used_entry = cache[i_entry];
    memmove (cache + 1, cache, i_entry * sizeof (struct ki_cache_entry));
    cache[0] = used_entry;

    return cache;
  }


  #endif /* !TEXTURE_PROCESS_DECL */

  // Very important to add a pointer to this struct in the union-lib.h file
  struct Texture_physics_storage_struct {
    // Variables that needs to be transfered between any of the following places:
    // The initialize in this component
    // The function for calculating my
    // The function for calculating scattering

    // Avoid duplicates of output parameters and setting parameters in naming

    struct hkl_info_struct_texture* hkl_info_storage; // struct containing all necessary info for SC
  };

  // Function for calculating my, the inverse penetration depth (for only this scattering process).
  // The input for this function and its order may not be changed, but the names may be updated.
  int
  Texture_physics_my (double* my, double* k_initial, union data_transfer_union data_transfer, struct focus_data_struct* focus_data, _class_particle* _particle) {
    // k_initial is a pointer to a simple vector with 3 doubles, k[0], k[1], k[2] (wavevector)
    struct hkl_info_struct_texture* texture = data_transfer.pointer_to_a_Texture_physics_storage_struct->hkl_info_storage;

    // with SPLIT, the copies of a neutron enter with the same wavevector: kiEntry reuses its cross sections
    *my = kiEntry (k_initial, texture)->coherent_mu;

    return 1;
  };

  // Function that provides description of a basic scattering event.
  int
  Texture_physics_scattering (double* k_final, double* k_initial, double* weight, union data_transfer_union data_transfer, struct focus_data_struct* focus_data,
                              _class_particle* _particle) {
    int i, i_selected;
    double random_number, XS_sum, accum; /* Locals */
    double kf[3];                       /* Final wave vector (local) */

    struct hkl_info_struct_texture* texture = data_transfer.pointer_to_a_Texture_physics_storage_struct->hkl_info_storage;

    struct hkl_data_texture* hkl_list = texture->hkl_list; // hkl list
    // cross sections of this wavevector, normally the front entry left by Texture_physics_my
    struct ki_cache_entry* cache_entry = kiEntry (k_initial, texture);

    // This can be removed, since this component deals only with coherent scattering
    // (instead here the Bragg cutoff may be implemented)
    if (cache_entry->last_hkl < 0 || cache_entry->coherent_mu <= 0) {
      k_final[0] = k_initial[0];
      k_final[1] = k_initial[1];
      k_final[2] = k_initial[2];
      return 0; // Return 0 will use ABSORB in main component (as it is not allowed in a function)
    }

    // cache_entry->last_hkl implements Bragg cutoff
    XS_sum = 0;
    for (i = 0; i <= cache_entry->last_hkl; i++) {
      XS_sum += cache_entry->XS_ki[i];
    }

    i_selected = -1;
    random_number = rand01 ();
    accum = 0;
    for (i = 0; i <= cache_entry->last_hkl; i++) {
      accum += cache_entry->XS_ki[i] / XS_sum;
      if (random_number < accum) {
        i_selected = i;
        break;
      }
    }

    if (i_selected == -1) {
      fprintf (stderr, "Texture_process: no plane selected for k = %g %g %g. Exit!\n", k_initial[0], k_initial[1], k_initial[2]);
      exit (-1);
    }

    // sampling kprime
    sampleKprime_hkl (kf, cache_entry->ki, cache_entry->phi_tables + i_selected, hkl_list + i_selected, texture);



    // return the scattered wave vector
    k_final[0] = kf[0];
    k_final[1] = kf[1];
    k_final[2] = kf[2];

    return 1;
  };

  #ifndef PROCESS_DETECTOR
  #define PROCESS_DETECTOR dummy
  #endif

  #ifndef PROCESS_TEXTURE_DETECTOR
  #define PROCESS_TEXTURE_DETECTOR dummy
  #endif

  // Register this process with the Union_master dispatch (see union-lib.h)
  #undef UNION_CASE_PHYSICS_MY_TEXTURE
  #define UNION_CASE_PHYSICS_MY_TEXTURE(out, ...) case Texture: out = Texture_physics_my(__VA_ARGS__); break;
  #undef UNION_CASE_PHYSICS_SCATTERING_TEXTURE
  #define UNION_CASE_PHYSICS_SCATTERING_TEXTURE(out, ...) case Texture: out = Texture_physics_scattering(__VA_ARGS__); break;
%}

DECLARE
%{
  // Declare for this component, to do calculations on the input / store in the transported data
  struct Texture_physics_storage_struct Texture_storage;

  // Texture data, filled in INITIALIZE; Union_master reaches it through the pointer in Texture_storage
  struct hkl_info_struct_texture texture;

  // Needed for transport to the main component, will be the same for all processes
  struct global_process_element_struct global_process_element;
  struct scattering_process_struct This_process;
%}

INITIALIZE
%{
  struct union_state_struct* union_state_p = union_acquire ();
  int n_axes, i_axis;
  int i, i_saved, nread, l, m;
  long j;
  struct odf_coefficients* odf;
  struct hkl_data_texture* hkl_list;
  struct ki_cache_entry* cache_entry;
  // Texture initialize

  texture.F2_in_barns = 0;
  texture.wavelength_min = lambda_min;
  texture.use_mtex_axes = mtex_axes;
  texture.lattice_directions[0] = coords_set (ax, ay, az);
  texture.lattice_directions[1] = coords_set (bx, by, bz);
  texture.lattice_directions[2] = coords_set (cx, cy, cz);
  n_axes = 0;
  for (i_axis = 0; i_axis < 3; i_axis++) {
    if (coords_len (texture.lattice_directions[i_axis]) > 0) {
      n_axes++;
    }
  }
  if (n_axes == 1) {
    fprintf (stderr, "Texture_process: %s: give the directions of two or three of the lattice vectors a, b and c, or none. Exit!\n", NAME_CURRENT_COMP);
    exit (-1);
  }
  if (n_axes && mtex_axes) {
    fprintf (stderr, "Texture_process: %s: the directions of the lattice vectors cannot be combined with mtex_axes = 1. Exit!\n", NAME_CURRENT_COMP);
    exit (-1);
  }

  // cut-off for l. If negative, take the cut-off provided in the Fourier coeff file
  texture.lmax = lmax_user;

  int use_coef = fcoef_fn && strlen (fcoef_fn) && strcmp (fcoef_fn, "0") && strcmp (fcoef_fn, "NULL");
  if (!use_coef) {
    fprintf (stderr, "Texture_process: give the Fourier coefficients of the texture in fcoef_fn. Exit!\n");
    exit (-1);
  }

  texture.V_tolerance = 1.0e-6;
  texture.n_phi_points = 120;
  texture.max_iter_reject = 3000;

  // crystallographic data
  nread = read_hkl_data_texture (crystal_fn, &texture);
  if (!nread) {
    fprintf (stderr, "Texture_process: %s: no reflections read from %s. Exit!\n", NAME_CURRENT_COMP, crystal_fn);
    exit (-1);
  }

  // get fourier coefficients of texture
  odf = (struct odf_coefficients*)malloc (sizeof (struct odf_coefficients));
  odf->lmax = texture.lmax;
  readFourierCoef (fcoef_fn, odf);
  texture.lmax = odf->lmax;

  // precompute legendre associated functions
  texture.legendre_ass_polynomial = initLegendre (odf->lmax);

  // below lmax = 20 the pole density of kf is read from pole_density at each try instead of tabulated for each wavevector
  texture.use_phi_table = texture.lmax >= 20;

  // cache of the wavevectors; an empty entry has ki = 0, which no neutron has
  texture.n_cached = 4;
  texture.ki_cache = (struct ki_cache_entry*)calloc (texture.n_cached, sizeof (struct ki_cache_entry));
  if (!texture.ki_cache) {
    fprintf (stderr, "Texture_process: Failed malloc() in INITIALIZE. Exit!\n");
    exit (-1);
  }
  for (i_saved = 0; i_saved < texture.n_cached; i_saved++) {
    cache_entry = texture.ki_cache + i_saved;
    cache_entry->ki = coords_set (0, 0, 0);
    cache_entry->XS_ki = (double*)calloc (texture.num_hkl, sizeof (double));
    cache_entry->phi_tables = (struct kf_phi_table*)calloc (texture.num_hkl, sizeof (struct kf_phi_table));
    if (texture.num_hkl > 0 && (!cache_entry->XS_ki || !cache_entry->phi_tables)) {
      fprintf (stderr, "Texture_process: Failed malloc() in INITIALIZE. Exit!\n");
      exit (-1);
    }
    for (i = 0; i < texture.num_hkl && texture.use_phi_table; i++) {
      cache_entry->phi_tables[i].prob_offset = (double*)malloc (texture.n_phi_points * sizeof (double));
      cache_entry->phi_tables[i].prob_slope = (double*)malloc (texture.n_phi_points * sizeof (double));
      if (!cache_entry->phi_tables[i].prob_offset || !cache_entry->phi_tables[i].prob_slope) {
        fprintf (stderr, "Texture_process: Failed malloc() in INITIALIZE. Exit!\n");
        exit (-1);
      }
    }
  }

  hkl_list = texture.hkl_list;
  for (i = 0; i < texture.num_hkl; i++) {
    hkl_list[i].n_negative_XS = 0;
  }

  // V matrices for cross sections
  hkl_list = texture.hkl_list;
  for (i = 0; i < texture.num_hkl; i++) {
    computeV (odf, hkl_list + i, texture.V_tolerance);
  }

  // precompute the probability distribution of Q
  hkl_list = texture.hkl_list;
  for (i = 0; i < texture.num_hkl; i++) {
    fillPoleTable (&hkl_list[i].pole_density, hkl_list + i, texture.legendre_ass_polynomial);
    hkl_list[i].pole_density_max = hkl_list[i].pole_density.data[0];
    for (j = 1; j < hkl_list[i].pole_density.rows * hkl_list[i].pole_density.columns; j++) {
      hkl_list[i].pole_density_max = fmax (hkl_list[i].pole_density_max, hkl_list[i].pole_density.data[j]);
    }
  }

  // coefficients of the total cross sections, and the harmonics of one wavevector
  hkl_list = texture.hkl_list;
  for (i = 0; i < texture.num_hkl; i++) {
    xsCoefficients (hkl_list + i, texture.lmax);
  }
  texture.legendre_norm = (double*)malloc ((texture.lmax + 1) * (texture.lmax + 1) * sizeof (double));
  texture.plm_ki = (double*)malloc ((texture.lmax + 1) * (texture.lmax + 1) * sizeof (double));
  texture.cos_m_phi = (double*)malloc ((texture.lmax + 1) * sizeof (double));
  texture.sin_m_phi = (double*)malloc ((texture.lmax + 1) * sizeof (double));
  if (!texture.legendre_norm || !texture.plm_ki || !texture.cos_m_phi || !texture.sin_m_phi) {
    fprintf (stderr, "Texture_process: Failed malloc() in INITIALIZE. Exit!\n");
    exit (-1);
  }
  legendre_scale_factors (texture.lmax, texture.legendre_norm);

  // Fourier coefficients of the ODF, not needed after initialization
  for (l = 0; l <= odf->lmax; l++) {
    for (m = -l; m <= l; m++) {
      free (odf->coef_real[l][m + l]);
      free (odf->coef_imag[l][m + l]);
    }
    free (odf->coef_real[l]);
    free (odf->coef_imag[l]);
  }
  free (odf->coef_real);
  free (odf->coef_imag);
  free (odf);

  // precomputed factors
  texture.XS_to_mu = packing_factor / texture.cell_volume;
  // Cross-sections are in barns = 10**-28 m**2, and unit cell volumes are
  // in AA**3 = 10**-30 m**3. Hence a factor of 100 is used to convert
  // scattering lengths to m**-1
  if (barns || texture.F2_in_barns) {
    texture.XS_to_mu *= 100;
  }

  if (texture.num_hkl) {
    printf ("Texture_process: %s: Read %d reflections from file '%s'\n", NAME_CURRENT_COMP, texture.num_hkl, crystal_fn);
  } else {
    printf ("Texture_process: %s: No reflections read from file. No scattering will take place.\n", NAME_CURRENT_COMP);
  }

  // Initialize done in the component
  Texture_storage.hkl_info_storage = &texture;

  // First initialise This_process with default values:
  scattering_process_struct_init (&This_process);

  // Need to specify if this process is isotropic
  This_process.non_isotropic_rot_index = 1; // No (single crystal or texture)

  // Need to specify if this process need to use focusing in calculation of inverse penetration depth (physics_my)
  This_process.needs_cross_section_focus = -1; // No

  // The type of the process must be saved in the global enum process
  This_process.eProcess = Texture;

  // Packing the data into a structure that is transported to the main component
  This_process.data_transfer.pointer_to_a_Texture_physics_storage_struct = &Texture_storage;
  This_process.probability_for_scattering_function = &Texture_physics_my;
  This_process.scattering_function = &Texture_physics_scattering;

  // This will be the same for all process's, and can thus be moved to an include.
  This_process.process_p_interact = interact_fraction;
  sprintf (This_process.name, "%s", NAME_CURRENT_COMP);
  rot_copy (This_process.rotation_matrix, ROT_A_CURRENT_COMP);
  sprintf (global_process_element.name, "%s", NAME_CURRENT_COMP);
  global_process_element.component_index = INDEX_CURRENT_COMP;
  global_process_element.p_scattering_process = &This_process;

  struct pointer_to_global_process_list* global_process_list = &union_state_p->u_process_list;
  add_element_to_process_list (global_process_list, global_process_element);
 %}

TRACE
%{
  // Trace should be empty, the simulation is done in Union_master
%}

FINALLY
%{
  int i_hkl, i_saved, l;
  double n_negative_XS = 0;
  for (i_hkl = 0; i_hkl < texture.num_hkl; i_hkl++) {
    n_negative_XS += texture.hkl_list[i_hkl].n_negative_XS;
  }
  if (n_negative_XS > 0) {
    printf ("Texture_process %s WARNING: the truncated series gave %g negative cross sections.\n", NAME_CURRENT_COMP, n_negative_XS);
  }

  // Legendre tables and axes of the pole density tables
  for (l = 0; l <= texture.legendre_ass_polynomial->lmax; l++) {
    Table_Free (texture.legendre_ass_polynomial->plm_tables + l);
  }
  free (texture.legendre_ass_polynomial->plm_tables);
  free (texture.legendre_ass_polynomial->cos_theta_axis);
  free (texture.legendre_ass_polynomial->phi_axis);
  free (texture.legendre_ass_polynomial);

  // reflections
  for (i_hkl = 0; i_hkl < texture.num_hkl; i_hkl++) {
    struct hkl_data_texture* hkl = texture.hkl_list + i_hkl;
    free (hkl->V_l);
    free (hkl->V_m);
    free (hkl->V_modulus);
    free (hkl->V_phase);
    Table_Free (&hkl->pole_density);
    free (hkl->XS_cos_coef);
    free (hkl->XS_sin_coef);
  }
  free (texture.hkl_list);

  // wavevector cache
  for (i_saved = 0; i_saved < texture.n_cached; i_saved++) {
    for (i_hkl = 0; i_hkl < texture.num_hkl; i_hkl++) {
      free (texture.ki_cache[i_saved].phi_tables[i_hkl].prob_offset);
      free (texture.ki_cache[i_saved].phi_tables[i_hkl].prob_slope);
    }
    free (texture.ki_cache[i_saved].phi_tables);
    free (texture.ki_cache[i_saved].XS_ki);
  }
  free (texture.ki_cache);

  // Legendre factors and work arrays of the wavevector
  free (texture.legendre_norm);
  free (texture.plm_ki);
  free (texture.cos_m_phi);
  free (texture.sin_m_phi);

  union_release (NAME_CURRENT_COMP);
%}

END
