/*******************************************************************************
*         McStas instrument definition URL=http://www.mcstas.org
*
* Instrument: Test_texture_Al_sphere
*
* %Identification
* Written by: Daniel Lomholt Christensen
* Date: 03/11/2026
* Origin: Niels Bohr Institute @ UCPH
* %INSTRUMENT_SITE: Tests_union
*
* Diffraction from a textured aluminium sphere with Texture_process
*
* %Description
* A 1 x 1 cm^2 Source_simple with a flat wavelength spectrum from 1 to 10 AA, a
* 1 x 1 cm^2 slit 2.5 cm before the sample, and the sample 100 m from the source.
* The sample is an aluminium sphere of radius 5 mm in a Union_sphere, with
* Texture_process reading Al_sg225.ncmat from the NCrystal data library, or the file
* given by crystal.
*
*  sphere_det: longitude and latitude of the scattered ray, over the whole sphere
*  sphere_det_single: the same for the rays scattered once
*
* q_logger, a Union_logger_2DQ, logs the scattering vector q = k_i - k_f of the rays
* scattered once, projected on the plane perpendicular to the beam (q_x, q_y). For the
* source band source_lmin = 4.05 AA to source_lmax = 4.68 AA, between 2 d(200) and
* 2 d(111), only Al (111) can scatter, so q_logger shows the (111) pole figure in an
* orthographic projection, out to 30 deg from the beam axis.
*
* With a fixed sample and a white beam, each direction on the detector sees the pole
* Q = k_f - k_i, which is independent of the wavelength, and the wavelength selects the
* reflection. The detector thus covers the hemisphere of poles facing the source.
*
* The texture is read from odf_file, by default Al_mtexdata_alu_ODF.txt in the McStas data
* folder: the Fourier coefficients of the polycrystalline aluminium EBSD map of MTEX
* (mtexdata alu, Al_mtexdata_alu_EBSD.txt), smoothed by a Gaussian kernel of 12 deg and cut
* at lmax = 12, computed with share/texture-coefficients.py:
*   python3 texture-coefficients.py --out Al_mtexdata_alu_ODF.txt --a 4.04958 --mtex_axes 1 --orientation_sigma 12 --lmax 12 --ebsd Al_mtexdata_alu_EBSD.txt
* lmax_user = 0 gives the untextured powder.
*
* use_powder=1 replaces the sphere by one of the same size with Powder_process reading
* crystal, which must then be a LAZ file. With crystal = "Al.laz", sphere_det_single of
* lmax_user=0 agrees within the statistical error with that of use_powder=1. Only single scattering compares: multiple scattering in a textured
* sample depends on the directions of the earlier scatterings.
*
* Union_sphere sets p_interact = 0.9.
*
* %Test: Detector: sphere_det_I=1.28146e-05
* %Test: use_powder=1 crystal=Al.laz Detector: sphere_det_single_I=1.18552e-05
* %Test: source_lmin=4.05 source_lmax=4.68 Detector: q_logger_I=2.34518e-06
*
* %Parameters
* odf_file:   [string] Fourier coefficients of the texture, fcoef_fn of Texture_process
* crystal:    [string] Crystal structure file of Texture_process, an NCrystal material or a LAZ file
* use_powder: [1]    1: Powder_process reading crystal instead of Texture_process
* lmax_user:  [1]    Cut-off of the Fourier series, see Texture_process
* lambda_min: [AA]   Reflections that only scatter below this wavelength are not used
* source_lmin: [AA]  Shortest wavelength of the source
* source_lmax: [AA]  Longest wavelength of the source
*
* %Link
*
* %End
*******************************************************************************/
DEFINE INSTRUMENT Test_texture_Al_sphere(string odf_file="Al_mtexdata_alu_ODF.txt", string crystal="Al_sg225.ncmat", int use_powder=0, int lmax_user=12, lambda_min=1, source_lmin=1, source_lmax=10)

DECLARE
%{
  double sample_r;
  char* powder_file;
  double det_r;
  int scattered;
%}

INITIALIZE
%{
  sample_r = 0.005;
  det_r = 1;

  // Powder_process only reads crystal for use_powder = 1, as it does not read NCrystal materials
  powder_file = "NULL";
  if (use_powder) {
    powder_file = crystal;
  }
%}

TRACE

COMPONENT Origin = Progress_bar()
  AT (0,0,0) ABSOLUTE
EXTEND %{
  scattered = 0;
%}

COMPONENT source = Source_simple(
    yheight = 0.01,
    xwidth = 0.01,
    dist = 99.975,
    focus_xw = 0.01,
    focus_yh = 0.01,
    lambda0 = (source_lmin + source_lmax) / 2,
    dlambda = (source_lmax - source_lmin) / 2,
    flux = 1e4
) AT (0, 0, 0) RELATIVE Origin

COMPONENT slit = Slit(
    xwidth = 0.01,
    yheight = 0.01
) AT (0, 0, 99.975) RELATIVE source

COMPONENT arm_sample = Arm(
) AT (0, 0, 0.025) RELATIVE slit

COMPONENT texture = Texture_process(
    crystal_fn = crystal, barns = 1,
    fcoef_fn = odf_file, lmax_user = lmax_user, lambda_min = lambda_min, mtex_axes = 1
) AT (0, 0, 0) RELATIVE arm_sample

COMPONENT texture_mat = Union_make_material(
    my_absorption = 0, process_string = "texture"
) AT (0, 0, 0) RELATIVE arm_sample

COMPONENT powder = Powder_process(
    reflections = powder_file, barns = 1, packing_factor = 1
) AT (0, 0, 0) RELATIVE arm_sample

COMPONENT powder_mat = Union_make_material(
    my_absorption = 0, process_string = "powder"
) AT (0, 0, 0) RELATIVE arm_sample

COMPONENT sample = Union_sphere(
    radius = sample_r, priority = 1, material_string = "texture_mat", p_interact = 0.9, number_of_activations = !use_powder
) AT (0, 0, 0) RELATIVE arm_sample

COMPONENT sample_powder = Union_sphere(
    radius = sample_r, priority = 2, material_string = "powder_mat", p_interact = 0.9, number_of_activations = use_powder
) AT (0, 0, 0) RELATIVE arm_sample

COMPONENT q_logger = Union_logger_2DQ(
    Q_direction_1 = "x", Q1_min = -3, Q1_max = 3, n1 = 120,
    Q_direction_2 = "y", Q2_min = -3, Q2_max = 3, n2 = 120,
    order_total = 1, filename = "q_logger"
) AT (0, 0, 0) RELATIVE arm_sample

COMPONENT union_master = Union_master(
) AT (0, 0, 0) RELATIVE arm_sample
EXTEND %{
  scattered = number_of_scattering_events;
%}

// =================== Detectors

COMPONENT sphere_det = Monitor_nD(
    xwidth = 2 * det_r,
    options = "sphere theta limits=[-180 180] bins=360 phi limits=[-90 90] bins=180",
    filename = "sphere_det",
    restore_neutron = 1
) WHEN (scattered >= 1)
AT (0, 0, 0) RELATIVE arm_sample

COMPONENT sphere_det_single = Monitor_nD(
    xwidth = 2 * det_r,
    options = "sphere theta limits=[-180 180] bins=360 phi limits=[-90 90] bins=180",
    filename = "sphere_det_single",
    restore_neutron = 1
) WHEN (scattered == 1)
AT (0, 0, 0) RELATIVE arm_sample

END
