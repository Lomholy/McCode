/*******************************************************************************
*         McStas instrument definition URL=http://www.mcstas.org
*
* Instrument: Test_texture_Al_sphere
*
* %Identification
* Written by: Daniel Lomholt Christensen
* Date: 03/11/2026
* Origin: Niels Bohr Institute @ UCPH
* %INSTRUMENT_SITE: Tests_union
*
* Diffraction from a textured aluminium sphere with Texture_process
*
* %Description
* A 1 x 1 cm^2 Source_simple with a flat wavelength spectrum from 1 to 10 AA, a
* 1 x 1 cm^2 slit 2.5 cm before the sample, and the sample 100 m from the source.
* The sample is an aluminium sphere of radius 5 mm in a Union_sphere, with
* Texture_process reading Al_sg225.ncmat from the NCrystal data library, or the file
* given by crystal.
*
*  sphere_det: longitude and latitude of the scattered ray, over the whole sphere
*  sphere_det_single: the same for the rays scattered once
*
* q_logger, a Union_logger_2DQ, logs the scattering vector q = k_i - k_f of the rays
* scattered once, projected on the plane perpendicular to the beam (q_x, q_y). For the
* source band source_lmin = 4.05 AA to source_lmax = 4.68 AA, between 2 d(200) and
* 2 d(111), only Al (111) can scatter, so q_logger shows the (111) pole figure in an
* orthographic projection, out to 30 deg from the beam axis.
*
* With a fixed sample and a white beam, each direction on the detector sees the pole
* Q = k_f - k_i, which is independent of the wavelength, and the wavelength selects the
* reflection. The detector thus covers the hemisphere of poles facing the source.
*
* The default texture is read directly from Al_mtexdata_alu_EBSD.txt in the McStas data
* folder, the polycrystalline aluminium EBSD map of MTEX (mtexdata alu), smoothed by a
* Gaussian kernel of orientation_sigma = 12 deg and cut at lmax_user = 12.
* use_odf=1 reads Al_mtexdata_alu_ODF.txt instead, the Fourier coefficients of the same map
* computed beforehand. lmax_user = 0 gives the untextured powder.
*
* use_expr=1 draws the orientations from the rotation expressions of Texture_process
* instead, as an aluminium powder: uniform rotations about x and y, and about z only
* over half a turn, rot_x_expr = "360*u1", rot_y_expr = "asin(2*u2-1)*180/pi",
* rot_z_expr = "180*u3". The angle about y has the density cos(ry) of uniform rotations,
* and the half turn about z is enough because the cubic lattice has a 2-fold axis along
* c. It gives the same intensity as lmax_user = 0, the untextured powder.
*
* use_expr=2 draws a texture that fills only the right half (x > 0) of the (111)
* Debye-Scherrer cone, with the intensity of the whole cone of the powder, for a
* monochromatic beam in the band where only (111) scatters, from 4.09 AA, e.g.
* source_lmin = source_lmax = 4.3. Only the direction of the {111} pole
* that scatters matters: the crystal axes (a along (-sqrt 2, sqrt 3, -1), b along
* (-sqrt 2, -sqrt 3, -1) in the process frame) put [111] along -x, and the process is
* placed at ROTATED (0, -90, 0), so that its x axis is the beam. rot_y_expr tilts [111] away
* from -beam evenly over the cap cos(ry) > 3/4 (41.4 deg), and rot_x_expr turns it about the
* beam over the right half. The (111) Bragg cone lies within 23 deg of -beam, and the other
* {111} poles of a grain are at least 70.5 deg from [111], so only [111] can scatter, with the
* pole density 2 on the right half of the cone and 0 on the left. This holds without the
* kernel: orientation_sigma smears the poles across the boundary to the left, and smears the
* other poles of the grain, which lie 29 deg from -beam at the edge of the cap, onto the cone.
* With orientation_sigma = 6 and lmax_user = -1, the cone has 1.21 times the intensity of the
* powder cone, 77% of it on the right; the excess vanishes for orientation_sigma <= 2.
*
* use_powder=1 replaces the sphere by one of the same size with Powder_process reading
* crystal, which must then be a LAZ file. With crystal = "Al.laz", sphere_det_single of
* use_expr=1 agrees within the statistical error with that of use_powder=1. Only single scattering compares: multiple scattering in a textured
* sample depends on the directions of the earlier scatterings.
*
* Union_sphere sets p_interact = 0.9.
*
* %Test: use_odf=0 Detector: sphere_det_I=1.28146e-05
* %Test: use_odf=1 Detector: sphere_det_I=1.28146e-05
* %Test: use_expr=1 Detector: sphere_det_I=1.30012e-05
* %Test: use_powder=1 crystal=Al.laz Detector: sphere_det_single_I=1.18552e-05
* %Test: use_expr=2 crystal=Al.laz source_lmin=4.3 source_lmax=4.3 orientation_sigma=6 lmax_user=-1 Detector: sphere_det_single_I=4.00468e-06
* %Test: source_lmin=4.05 source_lmax=4.68 Detector: q_logger_I=2.34518e-06
*
* %Parameters
* use_odf:    [1]    0: read the texture from Al_mtexdata_alu_EBSD.txt, 1: from Al_mtexdata_alu_ODF.txt
* use_expr:   [1]    1: draw an aluminium powder from the rotation expressions instead, 2: the right half of the (111) cone, see above
* crystal:    [string] Crystal structure file of Texture_process, an NCrystal material or a LAZ file
* use_powder: [1]    1: Powder_process reading crystal instead of Texture_process
* orientation_sigma: [deg]  Standard deviation of the Gaussian kernel for the EBSD file
* lmax_user:  [1]    Cut-off of the Fourier series, see Texture_process
* lambda_min: [AA]   Reflections that only scatter below this wavelength are not used
* source_lmin: [AA]  Shortest wavelength of the source
* source_lmax: [AA]  Longest wavelength of the source
*
* %Link
*
* %End
*******************************************************************************/
DEFINE INSTRUMENT Test_texture_Al_sphere(int use_odf=0, int use_expr=0, string crystal="Al_sg225.ncmat", int use_powder=0, orientation_sigma=12, int lmax_user=12, lambda_min=1, source_lmin=1, source_lmax=10)

DECLARE
%{
  double sample_r;
  char* rot_x;
  char* rot_y;
  char* rot_z;
  char* odf_file;
  char* ebsd_file;
  char* powder_file;
  double axis_a[3];
  double axis_b[3];
  double process_tilt;
  double det_r;
  int scattered;
%}

INITIALIZE
%{
  sample_r = 0.005;
  det_r = 1;

  // rotation expressions of use_expr = 1 (powder) and 2 (right half of the (111) cone, process frame with x along the beam)
  rot_x = "";
  rot_y = "";
  rot_z = "";
  if (use_expr == 1) {
    rot_x = "360*u1";
    rot_y = "asin(2*u2-1)*180/pi";
    rot_z = "180*u3";
  } else if (use_expr == 2) {
    rot_x = "-90-180*u1";
    rot_y = "acos(1-u2/4)*180/pi";
    rot_z = "0";
  }

  // texture input of Texture_process: rotation expressions, else the ODF file or the EBSD map
  odf_file = "0";
  ebsd_file = "0";
  if (!use_expr && use_odf) {
    odf_file = "Al_mtexdata_alu_ODF.txt";
  } else if (!use_expr) {
    ebsd_file = "Al_mtexdata_alu_EBSD.txt";
  }

  // crystal axes and process placement of use_expr = 2: [111] along -x of the process, whose x axis is the beam
  axis_a[0] = axis_a[1] = axis_a[2] = 0;
  axis_b[0] = axis_b[1] = axis_b[2] = 0;
  process_tilt = 0;
  if (use_expr == 2) {
    axis_a[0] = -sqrt (2);
    axis_a[1] = sqrt (3);
    axis_a[2] = -1;
    axis_b[0] = -sqrt (2);
    axis_b[1] = -sqrt (3);
    axis_b[2] = -1;
    process_tilt = -90;
  }

  // Powder_process only reads crystal for use_powder = 1, as it does not read NCrystal materials
  powder_file = "NULL";
  if (use_powder) {
    powder_file = crystal;
  }
%}

TRACE

COMPONENT Origin = Progress_bar()
  AT (0,0,0) ABSOLUTE
EXTEND %{
  scattered = 0;
%}

COMPONENT source = Source_simple(
    yheight = 0.01,
    xwidth = 0.01,
    dist = 99.975,
    focus_xw = 0.01,
    focus_yh = 0.01,
    lambda0 = (source_lmin + source_lmax) / 2,
    dlambda = (source_lmax - source_lmin) / 2,
    flux = 1e4
) AT (0, 0, 0) RELATIVE Origin

COMPONENT slit = Slit(
    xwidth = 0.01,
    yheight = 0.01
) AT (0, 0, 99.975) RELATIVE source

COMPONENT arm_sample = Arm(
) AT (0, 0, 0.025) RELATIVE slit

COMPONENT texture = Texture_process(
    crystal_fn = crystal, barns = 1,
    fcoef_fn = odf_file, ebsd_fn = ebsd_file,
    rot_x_expr = rot_x, rot_y_expr = rot_y, rot_z_expr = rot_z,
    orientation_sigma = orientation_sigma, lmax_user = lmax_user, lambda_min = lambda_min, mtex_axes = (use_expr != 2),
    ax = axis_a[0], ay = axis_a[1], az = axis_a[2], bx = axis_b[0], by = axis_b[1], bz = axis_b[2]
) AT (0, 0, 0) RELATIVE arm_sample
ROTATED (0, process_tilt, 0) RELATIVE arm_sample

COMPONENT texture_mat = Union_make_material(
    my_absorption = 0, process_string = "texture"
) AT (0, 0, 0) RELATIVE arm_sample

COMPONENT powder = Powder_process(
    reflections = powder_file, barns = 1, packing_factor = 1
) AT (0, 0, 0) RELATIVE arm_sample

COMPONENT powder_mat = Union_make_material(
    my_absorption = 0, process_string = "powder"
) AT (0, 0, 0) RELATIVE arm_sample

COMPONENT sample = Union_sphere(
    radius = sample_r, priority = 1, material_string = "texture_mat", p_interact = 0.9, number_of_activations = !use_powder
) AT (0, 0, 0) RELATIVE arm_sample

COMPONENT sample_powder = Union_sphere(
    radius = sample_r, priority = 2, material_string = "powder_mat", p_interact = 0.9, number_of_activations = use_powder
) AT (0, 0, 0) RELATIVE arm_sample

COMPONENT q_logger = Union_logger_2DQ(
    Q_direction_1 = "x", Q1_min = -3, Q1_max = 3, n1 = 120,
    Q_direction_2 = "y", Q2_min = -3, Q2_max = 3, n2 = 120,
    order_total = 1, filename = "q_logger"
) AT (0, 0, 0) RELATIVE arm_sample

COMPONENT union_master = Union_master(
) AT (0, 0, 0) RELATIVE arm_sample
EXTEND %{
  scattered = number_of_scattering_events;
%}

// =================== Detectors

COMPONENT sphere_det = Monitor_nD(
    xwidth = 2 * det_r,
    options = "sphere theta limits=[-180 180] bins=360 phi limits=[-90 90] bins=180",
    filename = "sphere_det",
    restore_neutron = 1
) WHEN (scattered >= 1)
AT (0, 0, 0) RELATIVE arm_sample

COMPONENT sphere_det_single = Monitor_nD(
    xwidth = 2 * det_r,
    options = "sphere theta limits=[-180 180] bins=360 phi limits=[-90 90] bins=180",
    filename = "sphere_det_single",
    restore_neutron = 1
) WHEN (scattered == 1)
AT (0, 0, 0) RELATIVE arm_sample

END
