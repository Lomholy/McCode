/*******************************************************************************
*         McStas instrument definition URL=http://www.mcstas.org
*
* Instrument: Test_texture_Al_sphere
*
* %Identification
* Written by: Daniel Lomholt Christensen
* Date: 03/11/2026
* Origin: Niels Bohr Institute @ UCPH
* %INSTRUMENT_SITE: Tests_union
*
* Diffraction from a textured aluminium sphere with Texture_process
*
* %Description
* A 1 x 1 cm^2 Source_simple with a flat wavelength spectrum from 1 to 10 AA, a
* 1 x 1 cm^2 slit 2.5 cm before the sample, and the sample 100 m from the source.
* The sample is an aluminium sphere of radius 5 mm in a Union_sphere, with
* Texture_process reading Al_sg225.ncmat from the NCrystal data library, or the file
* given by crystal.
*
*  sphere_det: longitude and latitude of the scattered ray, over the whole sphere
*
* reflection = 1, 2 or 3 selects the Al reflection (111), (200) or (220): sphere_det then
* only records rays scattered once, with the wavelength lambda = 2 d_hkl sin(theta) of that
* reflection at their own scattering angle 2 theta, within the relative tolerance
* dlambda_rel. reflection = 0 records all scattered rays.
*
* q_logger, a Union_logger_2DQ, logs the scattering vector q = k_i - k_f of the rays
* scattered once, projected on the plane perpendicular to the beam (q_x, q_y). For the
* source band source_lmin = 4.05 AA to source_lmax = 4.68 AA, between 2 d(200) and
* 2 d(111), only Al (111) can scatter, so q_logger shows the (111) pole figure in an
* orthographic projection, out to 30 deg from the beam axis.
*
* With a fixed sample and a white beam, each direction on the detector sees the pole
* Q = k_f - k_i, which is independent of the wavelength, and the wavelength selects the
* reflection. The detector thus covers the hemisphere of poles facing the source.
*
* The default texture is read directly from Al_mtexdata_alu_EBSD.txt in the McStas data
* folder, the polycrystalline aluminium EBSD map of MTEX (mtexdata alu), smoothed by a
* Gaussian kernel of orientation_sigma = 12 deg and cut at lmax_user = 12.
* use_odf=1 reads Al_mtexdata_alu_ODF.txt instead, the Fourier coefficients of the same map
* computed beforehand. lmax_user = 0 gives the untextured powder.
*
* use_expr=1 draws the orientations from the rotation expressions of Texture_process
* instead, as an aluminium powder: uniform rotations about x and y, and about z only
* over half a turn, rot_x_expr = "360*u1", rot_y_expr = "asin(2*u2-1)*180/pi",
* rot_z_expr = "180*u3". The angle about y has the density cos(ry) of uniform rotations,
* and the half turn about z is enough because the cubic lattice has a 2-fold axis along
* c. It gives the same intensity as lmax_user = 0, the untextured powder. With
* crystal = "Al.laz", the rays scattered once agree within the statistical error
* with Powder_process reading Al.laz in the same material, in total and in each
* reflection. Only single scattering compares: multiple scattering in a textured sample
* depends on the directions of the earlier scatterings.
*
* Union_sphere sets p_interact = 0.9.
*
* %Test: use_odf=0 Detector: sphere_det_I=1.28146e-05
* %Test: use_odf=1 Detector: sphere_det_I=1.28146e-05
* %Test: use_expr=1 Detector: sphere_det_I=1.30012e-05
* %Test: reflection=1 Detector: sphere_det_I=6.22617e-06
* %Test: reflection=2 Detector: sphere_det_I=2.60198e-06
* %Test: reflection=3 Detector: sphere_det_I=1.12426e-06
* %Test: source_lmin=4.05 source_lmax=4.68 Detector: q_logger_I=2.34518e-06
*
* %Parameters
* use_odf:    [1]    0: read the texture from Al_mtexdata_alu_EBSD.txt, 1: from Al_mtexdata_alu_ODF.txt
* use_expr:   [1]    1: draw an aluminium powder from the rotation expressions instead, see above
* crystal:    [string] Crystal structure file of Texture_process, an NCrystal material or a LAZ file
* orientation_sigma: [deg]  Standard deviation of the Gaussian kernel for the EBSD file
* lmax_user:  [1]    Cut-off of the Fourier series, see Texture_process
* lambda_min: [AA]   Reflections that only scatter below this wavelength are not used
* reflection: [1]    0: all scattered rays, 1: (111), 2: (200), 3: (220)
* dlambda_rel: [1]   Relative wavelength tolerance of the selected reflection
* source_lmin: [AA]  Shortest wavelength of the source
* source_lmax: [AA]  Longest wavelength of the source
*
* %Link
*
* %End
*******************************************************************************/
DEFINE INSTRUMENT Test_texture_Al_sphere(int use_odf=0, int use_expr=0, string crystal="Al_sg225.ncmat", orientation_sigma=12, int lmax_user=12, lambda_min=1, int reflection=0, dlambda_rel=0.01, source_lmin=1, source_lmax=10)

DECLARE
%{
  double sample_r;
  double det_r;
  double d_hkl;
  double lambda_tol;
  int scattered;
  int in_reflection;
%}

INITIALIZE
%{
  // lattice parameter of Al_sg225.ncmat (4.04932 in Al.laz)
  double a = 4.04958;
  sample_r = 0.005;
  det_r = 1;
  if (reflection < 0 || reflection > 3) {
    fprintf (stderr, "Unsupported instrument parameter value reflection=%d.\n", reflection);
    exit (-1);
  }
  lambda_tol = dlambda_rel;
  d_hkl = reflection == 1 ? a / sqrt (3) : reflection == 2 ? a / 2 : a / sqrt (8);
%}

TRACE

COMPONENT Origin = Progress_bar()
  AT (0,0,0) ABSOLUTE
EXTEND %{
  scattered = 0;
%}

COMPONENT source = Source_simple(
    yheight = 0.01,
    xwidth = 0.01,
    dist = 99.975,
    focus_xw = 0.01,
    focus_yh = 0.01,
    lambda0 = (source_lmin + source_lmax) / 2,
    dlambda = (source_lmax - source_lmin) / 2,
    flux = 1e4
) AT (0, 0, 0) RELATIVE Origin

COMPONENT slit = Slit(
    xwidth = 0.01,
    yheight = 0.01
) AT (0, 0, 99.975) RELATIVE source

COMPONENT arm_sample = Arm(
) AT (0, 0, 0.025) RELATIVE slit

COMPONENT texture = Texture_process(
    crystal_fn = crystal, barns = 1,
    fcoef_fn = (!use_expr && use_odf ? "Al_mtexdata_alu_ODF.txt" : "0"), ebsd_fn = (!use_expr && !use_odf ? "Al_mtexdata_alu_EBSD.txt" : "0"),
    rot_x_expr = (use_expr ? "360*u1" : ""), rot_y_expr = (use_expr ? "asin(2*u2-1)*180/pi" : ""), rot_z_expr = (use_expr ? "180*u3" : ""),
    orientation_sigma = orientation_sigma, lmax_user = lmax_user, lambda_min = lambda_min, mtex_axes = 1
) AT (0, 0, 0) RELATIVE arm_sample

COMPONENT texture_mat = Union_make_material(
    my_absorption = 0, process_string = "texture"
) AT (0, 0, 0) RELATIVE arm_sample

COMPONENT sample = Union_sphere(
    radius = sample_r, priority = 1, material_string = "texture_mat", p_interact = 0.9
) AT (0, 0, 0) RELATIVE arm_sample

COMPONENT q_logger = Union_logger_2DQ(
    Q_direction_1 = "x", Q1_min = -3, Q1_max = 3, n1 = 120,
    Q_direction_2 = "y", Q2_min = -3, Q2_max = 3, n2 = 120,
    order_total = 1, filename = "q_logger"
) AT (0, 0, 0) RELATIVE arm_sample

COMPONENT union_master = Union_master(
) AT (0, 0, 0) RELATIVE arm_sample
EXTEND %{
  scattered = number_of_scattering_events;
  // the beam is along z: lambda = 2 d sin(theta), with cos(2 theta) = vz / v
  double speed = sqrt (vx * vx + vy * vy + vz * vz);
  double sin_theta = sqrt (0.5 * (1 - vz / speed));
  in_reflection = scattered == 1 && fabs (2 * PI / (V2K * speed) / (2 * d_hkl * sin_theta) - 1) < lambda_tol;
%}

// =================== Detectors

COMPONENT sphere_det = Monitor_nD(
    xwidth = 2 * det_r,
    options = "sphere theta limits=[-180 180] bins=360 phi limits=[-90 90] bins=180",
    filename = "sphere_det",
    restore_neutron = 1
) WHEN (reflection == 0 ? scattered >= 1 : in_reflection)
AT (0, 0, 0) RELATIVE arm_sample

END
