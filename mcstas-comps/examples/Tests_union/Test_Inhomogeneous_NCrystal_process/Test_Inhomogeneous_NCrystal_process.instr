/*******************************************************************************
*         McStas instrument definition URL=http://www.mcstas.org
*
* Instrument: Test_Inhomogeneous_NCrystal_process
*
* %Identification
* Written by: Daniel Lomholt Christensen
* Date: 29/09/2026
* Origin: Niels Bohr Institute @ UCPH
* %INSTRUMENT_SITE: Test_samples
*
* Compares Inhomogeneous_NCrystal_process with NCrystal_process for aluminium
*
* %Description
* A 2-3 AA beam hits a 10x20x10 mm box of aluminium, described by Al_sg225.ncmat from
* the NCrystal data library. The scattered rays are recorded on a 4pi sphere, a 0.4 m
* high banana detector (2theta pattern) and an energy monitor. NCrystal samples the
* full sphere, so there is no focusing.
*
* NCrystal_process references:
*   sample_choice=0:  Al powder, 300 K
*   sample_choice=12: Al powder, 600 K
*   sample_choice=8:  Al single crystal, 300 K, mosaicity 0.5 deg
*   sample_choice=2:  Al powder at 300 K, with a higher priority box over x > 0 at 600 K.
*                     The inner box is 20 um larger in y, z and +x, so no faces coincide.
*   sample_choice=4:  as 2, but the inner box has gamma = 92 deg (lower symmetry)
*   sample_choice=11: as 2, but single crystals with mosaicity 0.5 deg and 1.5 deg
*
* Inhomogeneous_NCrystal_process in one box:
*   sample_choice=1:  Al powder, 300 K, no templates (no cache axes); should equal 0
*   sample_choice=3:  temperature steps from 300 to 600 K at x = 0 (cfg template); should equal 2
*   sample_choice=5:  gamma steps from 90 to 92 deg at x = 0 (.ncmat template keeping
*                     @SPACEGROUP 225, which the process removes); should equal 4
*   sample_choice=7:  Al powder with cfg comp=coh_elas (Bragg only); should equal 6
*   sample_choice=9:  single crystal, no templates; should equal 8
*   sample_choice=10: single crystal, mosaicity steps from 0.5 to 1.5 deg at x = 0; should equal 11
*   sample_choice=13: temperature steps from 300 to 600 K at time t0, the median arrival
*                     time; sphere_early should equal choice 0 and sphere_late choice 12
*   sample_choice=14: as 3, but the pool only holds 39 of the 41 NCrystal objects, so
*                     objects are evicted and rebuilt; should equal 3. Rebuilding is
*                     slow (about 8 minutes at 1e7 rays), so it has no %Example line.
*
* Inhomogeneous_PowderN_process, in the same instrument to check that the two components
* can be used together:
*   sample_choice=6:  Al powder, 300 K
*
* The steps are resolved with 41 nodes over x in [-1, 1] mm and t in [0.97, 1.03] t0.
* Points outside these ranges use the nearest edge node, which is exact for a step.
*
* The detectors count all scattered rays. sphere_early and sphere_late split them by
* the time the ray reached the sample.
*
* %Example: sample_choice=0 Detector: sphere_I=1.69814e-06
* %Example: sample_choice=1 Detector: sphere_I=1.69817e-06
* %Example: sample_choice=2 Detector: sphere_I=1.73874e-06
* %Example: sample_choice=3 Detector: sphere_I=1.73678e-06
* %Example: sample_choice=4 Detector: sphere_I=1.70058e-06
* %Example: sample_choice=5 Detector: sphere_I=1.69874e-06
* %Example: sample_choice=6 Detector: sphere_I=1.48906e-06
* %Example: sample_choice=7 Detector: sphere_I=1.48906e-06
* %Example: sample_choice=8 Detector: sphere_I=1.28769e-06
* %Example: sample_choice=9 Detector: sphere_I=1.28769e-06
* %Example: sample_choice=10 Detector: sphere_I=1.44145e-06
* %Example: sample_choice=11 Detector: sphere_I=1.44372e-06
* %Example: sample_choice=12 Detector: sphere_late_I=8.44915e-07
* %Example: sample_choice=13 Detector: sphere_early_I=9.11987e-07
* %Example: sample_choice=13 Detector: sphere_late_I=8.44687e-07
*
* %Parameters
* lambda0: [AA] Mean wavelength of the source.
* dlambda: [AA] Half width of the wavelength band.
* sample_choice: [1] Sample to use, see the description.
*
* %Link
*
* %End
*******************************************************************************/
DEFINE INSTRUMENT Test_Inhomogeneous_NCrystal_process(lambda0=2.5, dlambda=0.5, int sample_choice=0)

DECLARE
%{
  double samp_w;
  double samp_h;
  double samp_d;
  double t0;
  char hom_cfg[512];
  char outer_cfg[512];
  char inner_cfg[512];
  char inh_template[256];
  char inh_cfg[512];
  double pool_object_mb;
  int scattered;
  double t_sample;
%}

INITIALIZE
%{
  samp_w = 0.01;
  samp_h = 0.02;
  samp_d = 0.01;
  /* Median arrival time at the sample, 10.5 m at the speed of lambda0 */
  t0 = 10.5 * lambda0 / 3956.0346;

  const char* crystal = "mos=0.5deg;dir1=@crys_hkl:1,1,2@lab:0,0,1;dir2=@crys_hkl:1,-1,0@lab:1,0,0";
  const char* crystal_mos_step = "mos=${hvs(x,0,1.5,0.5)}deg;dir1=@crys_hkl:1,1,2@lab:0,0,1;dir2=@crys_hkl:1,-1,0@lab:1,0,0";

  sprintf (hom_cfg, "Al_sg225.ncmat;temp=%s", sample_choice == 12 ? "600K" : "300K");
  if (sample_choice == 8)
    sprintf (hom_cfg, "Al_sg225.ncmat;temp=300K;%s", crystal);

  sprintf (outer_cfg, "Al_sg225.ncmat;temp=300K");
  sprintf (inner_cfg, "%s", sample_choice == 4 ? "Al_gamma92.ncmat;temp=300K" : "Al_sg225.ncmat;temp=600K");
  if (sample_choice == 11) {
    sprintf (outer_cfg, "Al_sg225.ncmat;temp=300K;%s", crystal);
    sprintf (inner_cfg, "Al_sg225.ncmat;temp=300K;mos=1.5deg;dir1=@crys_hkl:1,1,2@lab:0,0,1;dir2=@crys_hkl:1,-1,0@lab:1,0,0");
  }

  sprintf (inh_template, "%s", sample_choice == 5 ? "Al_angle_x.ncmat" : "Al_sg225.ncmat");
  sprintf (inh_cfg, "temp=300K");
  /* 39 objects of 100 MB fit in the 3900 MB pool */
  pool_object_mb = (sample_choice == 14) ? 100 : 0;
  if (sample_choice == 3 || sample_choice == 14)
    sprintf (inh_cfg, "temp=${hvs(x,0,600,300)}K");
  else if (sample_choice == 7)
    sprintf (inh_cfg, "temp=300K;comp=coh_elas");
  else if (sample_choice == 9)
    sprintf (inh_cfg, "temp=300K;%s", crystal);
  else if (sample_choice == 10)
    sprintf (inh_cfg, "temp=300K;%s", crystal_mos_step);
  else if (sample_choice == 13)
    sprintf (inh_cfg, "temp=${hvs(t,p3,600,300)}K");
%}

TRACE

COMPONENT Origin = Progress_bar()
  AT (0,0,0) ABSOLUTE
EXTEND %{
  scattered = 0;
%}

COMPONENT init = Union_init()
  AT (0,0,0) ABSOLUTE

COMPONENT source = Source_simple(
    radius = 0.02,
    dist = 10.5,
    focus_xw = samp_w,
    focus_yh = samp_h,
    lambda0 = lambda0,
    dlambda = dlambda,
    flux = 1
) AT (0, 0, 0) RELATIVE Origin

COMPONENT arm_sample = Arm(
) AT (0, 0, 10.5) RELATIVE source
EXTEND %{
  /* The Arm does not move the ray, so extrapolate to the sample plane */
  t_sample = t - z / vz;
%}

// NCrystal_process in one box, sample_choice 0, 8, 12

COMPONENT hom_proc = NCrystal_process(
    cfg = hom_cfg
) AT (0, 0, 0) RELATIVE arm_sample

COMPONENT hom_material = Union_make_material(
    my_absorption = 0, process_string = "hom_proc"
) AT (0, 0, 0) RELATIVE arm_sample

COMPONENT hom_box = Union_box(
    xwidth = samp_w, yheight = samp_h, zdepth = samp_d,
    priority = 1, material_string = "hom_material"
) AT (0, 0, 0) RELATIVE arm_sample

COMPONENT hom_master = Union_master(
) WHEN (sample_choice == 0 || sample_choice == 8 || sample_choice == 12)
AT (0, 0, 0) RELATIVE arm_sample
EXTEND %{
  scattered = number_of_scattering_events;
%}

// NCrystal_process with a different material at x > 0, sample_choice 2, 4, 11

COMPONENT outer_proc = NCrystal_process(
    cfg = outer_cfg
) AT (0, 0, 0) RELATIVE arm_sample

COMPONENT inner_proc = NCrystal_process(
    cfg = inner_cfg
) AT (0, 0, 0) RELATIVE arm_sample

COMPONENT outer_material = Union_make_material(
    my_absorption = 0, process_string = "outer_proc"
) AT (0, 0, 0) RELATIVE arm_sample

COMPONENT inner_material = Union_make_material(
    my_absorption = 0, process_string = "inner_proc"
) AT (0, 0, 0) RELATIVE arm_sample

COMPONENT outer_box = Union_box(
    xwidth = samp_w, yheight = samp_h, zdepth = samp_d,
    priority = 1, material_string = "outer_material"
) AT (0, 0, 0) RELATIVE arm_sample

COMPONENT inner_box = Union_box(
    xwidth = samp_w / 2 + 2e-5, yheight = samp_h + 2e-5, zdepth = samp_d + 2e-5,
    priority = 2, material_string = "inner_material"
) AT (samp_w / 4 + 1e-5, 0, 0) RELATIVE arm_sample

COMPONENT split_master = Union_master(
) WHEN (sample_choice == 2 || sample_choice == 4 || sample_choice == 11)
AT (0, 0, 0) RELATIVE arm_sample
EXTEND %{
  scattered = number_of_scattering_events;
%}

// Inhomogeneous_NCrystal_process in one box, sample_choice 1, 3, 5, 7, 9, 10, 13, 14

COMPONENT inh_proc = Inhomogeneous_NCrystal_process(
    ncmat_template = inh_template, cfg = inh_cfg, p3 = t0,
    n_x = 41, x_min = -1e-3, x_max = 1e-3,
    n_t = 41, t_min = t0 * 0.97, t_max = t0 * 1.03,
    object_mb = pool_object_mb, max_pool_mb = (sample_choice == 14) ? 3900 : 2000
) AT (0, 0, 0) RELATIVE arm_sample

COMPONENT inh_material = Union_make_material(
    my_absorption = 0, process_string = "inh_proc"
) AT (0, 0, 0) RELATIVE arm_sample

COMPONENT inh_box = Union_box(
    xwidth = samp_w, yheight = samp_h, zdepth = samp_d,
    priority = 1, material_string = "inh_material"
) AT (0, 0, 0) RELATIVE arm_sample

COMPONENT inh_master = Union_master(
) WHEN (sample_choice == 1 || sample_choice == 3 || sample_choice == 5 || sample_choice == 7 || sample_choice == 9 || sample_choice == 10
        || sample_choice == 13 || sample_choice == 14)
AT (0, 0, 0) RELATIVE arm_sample
EXTEND %{
  scattered = number_of_scattering_events;
%}

// Inhomogeneous_PowderN_process in one box, sample_choice 6

COMPONENT powder_proc = Inhomogeneous_PowderN_process(
    ncmat_template = "Al_sg225.ncmat", cfg = "temp=300K"
) AT (0, 0, 0) RELATIVE arm_sample

COMPONENT powder_material = Union_make_material(
    my_absorption = 0, process_string = "powder_proc"
) AT (0, 0, 0) RELATIVE arm_sample

COMPONENT powder_box = Union_box(
    xwidth = samp_w, yheight = samp_h, zdepth = samp_d,
    priority = 1, material_string = "powder_material"
) AT (0, 0, 0) RELATIVE arm_sample

COMPONENT powder_master = Union_master(
) WHEN (sample_choice == 6)
AT (0, 0, 0) RELATIVE arm_sample
EXTEND %{
  scattered = number_of_scattering_events;
%}

COMPONENT sphere = PSD_monitor_4PI(
    nx = 180, ny = 90, radius = 1.5,
    filename = "sphere", restore_neutron = 1
) WHEN (scattered >= 1)
AT (0, 0, 0) RELATIVE arm_sample

COMPONENT sphere_early = PSD_monitor_4PI(
    nx = 180, ny = 90, radius = 1.5,
    filename = "sphere_early", restore_neutron = 1
) WHEN (scattered >= 1 && t_sample < t0)
AT (0, 0, 0) RELATIVE arm_sample

COMPONENT sphere_late = PSD_monitor_4PI(
    nx = 180, ny = 90, radius = 1.5,
    filename = "sphere_late", restore_neutron = 1
) WHEN (scattered >= 1 && t_sample >= t0)
AT (0, 0, 0) RELATIVE arm_sample

COMPONENT banana = Monitor_nD(
    radius = 1, yheight = 0.4,
    options = "banana, theta limits=[-170 170] bins=680",
    filename = "banana", restore_neutron = 1
) WHEN (scattered >= 1)
AT (0, 0, 0) RELATIVE arm_sample

COMPONENT energy = Monitor_nD(
    radius = 1.4,
    options = "sphere, energy limits=[0 60] bins=240",
    filename = "energy", restore_neutron = 1
) WHEN (scattered >= 1)
AT (0, 0, 0) RELATIVE arm_sample

COMPONENT stop = Union_stop()
AT (0, 0, 0) ABSOLUTE

END
