/*******************************************************************************
*         McStas instrument definition URL=http://www.mcstas.org
*
* Instrument: Test_inhomogeneous_absorption
*
* %Identification
* Written by: Daniel Lomholt Christensen
* Date: 30/09/2026
* Origin: Niels Bohr Institute @ UCPH
* %INSTRUMENT_SITE: Tests_union
*
* Tests mu_absorption_expr in Union_make_material against 10 boxes of constant absorption
*
* %Description
* A 3.5 x 3.5 cm^2 Source_simple with neutrons of 25.3 +- 0.1 meV (2200 m/s, so the
* 2200/v scaling of the absorption is 1) illuminates a 3 x 3 cm^2 slit 10.475 m
* downstream. Behind it is a 3 x 3 cm^2 (width x height), 1 cm deep absorbing box,
* which does not overlap the slit.
*
* The absorption rises linearly from 10 /m to 100 /m, either along the beam (z) or
* across it (x). The box with mu_absorption_expr is compared with 10 boxes of constant
* my_absorption that follow the rise at their centers (10, 20, ..., 100 /m).
*
*   sample_choice=0: absorption along z, mu_absorption_expr, 100 sampling points
*   sample_choice=1: absorption along z, 10 boxes
*   sample_choice=2: absorption along x, mu_absorption_expr, 100 sampling points
*   sample_choice=3: absorption along x, 10 boxes
*   sample_choice=4: absorption along z, mu_absorption_expr with the steps of the 10
*                    boxes as a sum of hvs functions, 100 sampling points
*
* Along z the absorption is recorded where it happens, by the Union_abs_logger_2D_space
* abs_zx; along x the transmitted intensity is recorded by the PSD_monitor trans_x
* behind the box. Along z both samples give every ray the same integrated absorption, so
* 0 and 1 agree in total. Along x the absorption varies across each 3 mm box in sample
* 2, and the transmission averaged over such a box is slightly higher than at its
* center, so 2 transmits about 5e-5 more than 3. The steps of 4 lie on the boundaries of
* its 0.1 mm sampling segments, so 4 reproduces the absorption of 1 along z as well.
*
* The source, the slit and arm_sample, with E_i = 25.3 meV, are shared by the
* inhomogeneous tests, which include this instrument with
*   %include "Tests_union/Test_inhomogeneous_absorption/Test_inhomogeneous_absorption.instr"
* at the start of their TRACE. The sample and the detectors here are REMOVABLE, so they
* are left out there; the tests also get the parameter sample_choice and the variables
* declared here, E_i and the abs_ ones.
*
* %Test: sample_choice=0 Detector: abs_zx_I=0.0845871
* %Test: sample_choice=1 Detector: abs_zx_I=0.0845873
* %Test: sample_choice=2 Detector: trans_x_I=0.119781
* %Test: sample_choice=3 Detector: trans_x_I=0.119734
* %Test: sample_choice=4 Detector: abs_zx_I=0.0845874
*
* %Parameters
* sample_choice: [1] Sample to use, see the description.
*
* %Link
*
* %End
*******************************************************************************/
DEFINE INSTRUMENT Test_inhomogeneous_absorption(int sample_choice=0)

DECLARE
%{
  double E_i;
  double abs_thick;
  double abs_width;
  double abs_height;
  double abs_eps;
  int abs_z_expr;
  int abs_z_boxes;
  int abs_x_expr;
  int abs_x_boxes;
  int abs_z_steps;
%}

INITIALIZE
%{
  E_i = 25.3;
  abs_thick = 0.01;
  abs_width = 0.03;
  abs_height = 0.03;
  abs_eps = 1e-9;

  abs_z_expr = sample_choice == 0;
  abs_z_boxes = sample_choice == 1;
  abs_x_expr = sample_choice == 2;
  abs_x_boxes = sample_choice == 3;
  abs_z_steps = sample_choice == 4;
%}

TRACE

COMPONENT Origin = Progress_bar()
  AT (0,0,0) ABSOLUTE

COMPONENT source = Source_simple(
    yheight = 0.035,
    xwidth = 0.035,
    dist = 10.475,
    focus_xw = 0.03,
    focus_yh = 0.03,
    E0 = E_i,
    dE = 0.1,
    flux = 1e4
) AT (0, 0, 0) RELATIVE Origin

COMPONENT slit = Slit(
    xwidth = 0.03,
    yheight = 0.03
) AT (0, 0, 10.475) RELATIVE source

COMPONENT arm_sample = Arm(
) AT (0, 0, 0.025) RELATIVE slit

// Unused material, not REMOVABLE. The code generator embeds union-lib in the SHARE of the
// first Union component it reads, also when that component is REMOVABLE; this one puts it
// ahead of the Union components of the instruments that include this one.
COMPONENT union_lib_first = Union_make_material(
    absorber = 1,
    my_absorption = 1
) AT (0, 0, 0) RELATIVE arm_sample

// =================== Absorption along z, mu_absorption_expr
// 10 /m at z = -abs_thick/2 + abs_thick/20 rising by 10 /m every abs_thick/10, as the boxes below

REMOVABLE COMPONENT z_expr_mat = Union_make_material(
    absorber = 1,
    mu_absorption_expr = "10 + 10*((z + 0.0045)/0.001)",
    absorption_sampling_points = 100
) AT (0, 0, 0) RELATIVE arm_sample

REMOVABLE COMPONENT z_expr_box = Union_box(
    priority = 10,
    xwidth = abs_width,
    yheight = abs_height,
    zdepth = abs_thick,
    material_string = "z_expr_mat",
    number_of_activations = abs_z_expr
) AT (0, 0, 0) RELATIVE arm_sample

// =================== Absorption along z, mu_absorption_expr with steps
// The steps of the 10 boxes below, at their boundaries

REMOVABLE COMPONENT z_steps_mat = Union_make_material(
    absorber = 1,
    mu_absorption_expr = "10 + 10*(hvs(z,-0.004,1,0) + hvs(z,-0.003,1,0) + hvs(z,-0.002,1,0) + hvs(z,-0.001,1,0) + hvs(z,0,1,0) + hvs(z,0.001,1,0) + hvs(z,0.002,1,0) + hvs(z,0.003,1,0) + hvs(z,0.004,1,0))",
    absorption_sampling_points = 100
) AT (0, 0, 0) RELATIVE arm_sample

REMOVABLE COMPONENT z_steps_box = Union_box(
    priority = 12,
    xwidth = abs_width,
    yheight = abs_height,
    zdepth = abs_thick,
    material_string = "z_steps_mat",
    number_of_activations = abs_z_steps
) AT (0, 0, 0) RELATIVE arm_sample

// =================== Absorption along z, 10 boxes
// Neighbouring boxes are abs_eps apart, so no faces coincide

REMOVABLE COMPONENT z_mat_0 = Union_make_material(
    absorber = 1,
    my_absorption = 10
) AT (0, 0, 0) RELATIVE arm_sample

REMOVABLE COMPONENT z_box_0 = Union_box(
    priority = 20,
    xwidth = abs_width,
    yheight = abs_height,
    zdepth = abs_thick/10 - abs_eps,
    material_string = "z_mat_0",
    number_of_activations = abs_z_boxes
) AT (0, 0, -abs_thick/2 + abs_thick/20 + abs_thick/10*0) RELATIVE arm_sample

REMOVABLE COMPONENT z_mat_1 = Union_make_material(
    absorber = 1,
    my_absorption = 20
) AT (0, 0, 0) RELATIVE arm_sample

REMOVABLE COMPONENT z_box_1 = Union_box(
    priority = 21,
    xwidth = abs_width,
    yheight = abs_height,
    zdepth = abs_thick/10 - abs_eps,
    material_string = "z_mat_1",
    number_of_activations = abs_z_boxes
) AT (0, 0, -abs_thick/2 + abs_thick/20 + abs_thick/10*1) RELATIVE arm_sample

REMOVABLE COMPONENT z_mat_2 = Union_make_material(
    absorber = 1,
    my_absorption = 30
) AT (0, 0, 0) RELATIVE arm_sample

REMOVABLE COMPONENT z_box_2 = Union_box(
    priority = 22,
    xwidth = abs_width,
    yheight = abs_height,
    zdepth = abs_thick/10 - abs_eps,
    material_string = "z_mat_2",
    number_of_activations = abs_z_boxes
) AT (0, 0, -abs_thick/2 + abs_thick/20 + abs_thick/10*2) RELATIVE arm_sample

REMOVABLE COMPONENT z_mat_3 = Union_make_material(
    absorber = 1,
    my_absorption = 40
) AT (0, 0, 0) RELATIVE arm_sample

REMOVABLE COMPONENT z_box_3 = Union_box(
    priority = 23,
    xwidth = abs_width,
    yheight = abs_height,
    zdepth = abs_thick/10 - abs_eps,
    material_string = "z_mat_3",
    number_of_activations = abs_z_boxes
) AT (0, 0, -abs_thick/2 + abs_thick/20 + abs_thick/10*3) RELATIVE arm_sample

REMOVABLE COMPONENT z_mat_4 = Union_make_material(
    absorber = 1,
    my_absorption = 50
) AT (0, 0, 0) RELATIVE arm_sample

REMOVABLE COMPONENT z_box_4 = Union_box(
    priority = 24,
    xwidth = abs_width,
    yheight = abs_height,
    zdepth = abs_thick/10 - abs_eps,
    material_string = "z_mat_4",
    number_of_activations = abs_z_boxes
) AT (0, 0, -abs_thick/2 + abs_thick/20 + abs_thick/10*4) RELATIVE arm_sample

REMOVABLE COMPONENT z_mat_5 = Union_make_material(
    absorber = 1,
    my_absorption = 60
) AT (0, 0, 0) RELATIVE arm_sample

REMOVABLE COMPONENT z_box_5 = Union_box(
    priority = 25,
    xwidth = abs_width,
    yheight = abs_height,
    zdepth = abs_thick/10 - abs_eps,
    material_string = "z_mat_5",
    number_of_activations = abs_z_boxes
) AT (0, 0, -abs_thick/2 + abs_thick/20 + abs_thick/10*5) RELATIVE arm_sample

REMOVABLE COMPONENT z_mat_6 = Union_make_material(
    absorber = 1,
    my_absorption = 70
) AT (0, 0, 0) RELATIVE arm_sample

REMOVABLE COMPONENT z_box_6 = Union_box(
    priority = 26,
    xwidth = abs_width,
    yheight = abs_height,
    zdepth = abs_thick/10 - abs_eps,
    material_string = "z_mat_6",
    number_of_activations = abs_z_boxes
) AT (0, 0, -abs_thick/2 + abs_thick/20 + abs_thick/10*6) RELATIVE arm_sample

REMOVABLE COMPONENT z_mat_7 = Union_make_material(
    absorber = 1,
    my_absorption = 80
) AT (0, 0, 0) RELATIVE arm_sample

REMOVABLE COMPONENT z_box_7 = Union_box(
    priority = 27,
    xwidth = abs_width,
    yheight = abs_height,
    zdepth = abs_thick/10 - abs_eps,
    material_string = "z_mat_7",
    number_of_activations = abs_z_boxes
) AT (0, 0, -abs_thick/2 + abs_thick/20 + abs_thick/10*7) RELATIVE arm_sample

REMOVABLE COMPONENT z_mat_8 = Union_make_material(
    absorber = 1,
    my_absorption = 90
) AT (0, 0, 0) RELATIVE arm_sample

REMOVABLE COMPONENT z_box_8 = Union_box(
    priority = 28,
    xwidth = abs_width,
    yheight = abs_height,
    zdepth = abs_thick/10 - abs_eps,
    material_string = "z_mat_8",
    number_of_activations = abs_z_boxes
) AT (0, 0, -abs_thick/2 + abs_thick/20 + abs_thick/10*8) RELATIVE arm_sample

REMOVABLE COMPONENT z_mat_9 = Union_make_material(
    absorber = 1,
    my_absorption = 100
) AT (0, 0, 0) RELATIVE arm_sample

REMOVABLE COMPONENT z_box_9 = Union_box(
    priority = 29,
    xwidth = abs_width,
    yheight = abs_height,
    zdepth = abs_thick/10 - abs_eps,
    material_string = "z_mat_9",
    number_of_activations = abs_z_boxes
) AT (0, 0, -abs_thick/2 + abs_thick/20 + abs_thick/10*9) RELATIVE arm_sample

// =================== Absorption along x, mu_absorption_expr
// 10 /m at x = -abs_width/2 + abs_width/20 rising by 10 /m every abs_width/10, as the boxes below

REMOVABLE COMPONENT x_expr_mat = Union_make_material(
    absorber = 1,
    mu_absorption_expr = "10 + 10*((x + 0.0135)/0.003)",
    absorption_sampling_points = 100
) AT (0, 0, 0) RELATIVE arm_sample

REMOVABLE COMPONENT x_expr_box = Union_box(
    priority = 11,
    xwidth = abs_width,
    yheight = abs_height,
    zdepth = abs_thick,
    material_string = "x_expr_mat",
    number_of_activations = abs_x_expr
) AT (0, 0, 0) RELATIVE arm_sample

// =================== Absorption along x, 10 boxes
// Neighbouring boxes are abs_eps apart, so no faces coincide

REMOVABLE COMPONENT x_mat_0 = Union_make_material(
    absorber = 1,
    my_absorption = 10
) AT (0, 0, 0) RELATIVE arm_sample

REMOVABLE COMPONENT x_box_0 = Union_box(
    priority = 30,
    xwidth = abs_width/10 - abs_eps,
    yheight = abs_height,
    zdepth = abs_thick,
    material_string = "x_mat_0",
    number_of_activations = abs_x_boxes
) AT (-abs_width/2 + abs_width/20 + abs_width/10*0, 0, 0) RELATIVE arm_sample

REMOVABLE COMPONENT x_mat_1 = Union_make_material(
    absorber = 1,
    my_absorption = 20
) AT (0, 0, 0) RELATIVE arm_sample

REMOVABLE COMPONENT x_box_1 = Union_box(
    priority = 31,
    xwidth = abs_width/10 - abs_eps,
    yheight = abs_height,
    zdepth = abs_thick,
    material_string = "x_mat_1",
    number_of_activations = abs_x_boxes
) AT (-abs_width/2 + abs_width/20 + abs_width/10*1, 0, 0) RELATIVE arm_sample

REMOVABLE COMPONENT x_mat_2 = Union_make_material(
    absorber = 1,
    my_absorption = 30
) AT (0, 0, 0) RELATIVE arm_sample

REMOVABLE COMPONENT x_box_2 = Union_box(
    priority = 32,
    xwidth = abs_width/10 - abs_eps,
    yheight = abs_height,
    zdepth = abs_thick,
    material_string = "x_mat_2",
    number_of_activations = abs_x_boxes
) AT (-abs_width/2 + abs_width/20 + abs_width/10*2, 0, 0) RELATIVE arm_sample

REMOVABLE COMPONENT x_mat_3 = Union_make_material(
    absorber = 1,
    my_absorption = 40
) AT (0, 0, 0) RELATIVE arm_sample

REMOVABLE COMPONENT x_box_3 = Union_box(
    priority = 33,
    xwidth = abs_width/10 - abs_eps,
    yheight = abs_height,
    zdepth = abs_thick,
    material_string = "x_mat_3",
    number_of_activations = abs_x_boxes
) AT (-abs_width/2 + abs_width/20 + abs_width/10*3, 0, 0) RELATIVE arm_sample

REMOVABLE COMPONENT x_mat_4 = Union_make_material(
    absorber = 1,
    my_absorption = 50
) AT (0, 0, 0) RELATIVE arm_sample

REMOVABLE COMPONENT x_box_4 = Union_box(
    priority = 34,
    xwidth = abs_width/10 - abs_eps,
    yheight = abs_height,
    zdepth = abs_thick,
    material_string = "x_mat_4",
    number_of_activations = abs_x_boxes
) AT (-abs_width/2 + abs_width/20 + abs_width/10*4, 0, 0) RELATIVE arm_sample

REMOVABLE COMPONENT x_mat_5 = Union_make_material(
    absorber = 1,
    my_absorption = 60
) AT (0, 0, 0) RELATIVE arm_sample

REMOVABLE COMPONENT x_box_5 = Union_box(
    priority = 35,
    xwidth = abs_width/10 - abs_eps,
    yheight = abs_height,
    zdepth = abs_thick,
    material_string = "x_mat_5",
    number_of_activations = abs_x_boxes
) AT (-abs_width/2 + abs_width/20 + abs_width/10*5, 0, 0) RELATIVE arm_sample

REMOVABLE COMPONENT x_mat_6 = Union_make_material(
    absorber = 1,
    my_absorption = 70
) AT (0, 0, 0) RELATIVE arm_sample

REMOVABLE COMPONENT x_box_6 = Union_box(
    priority = 36,
    xwidth = abs_width/10 - abs_eps,
    yheight = abs_height,
    zdepth = abs_thick,
    material_string = "x_mat_6",
    number_of_activations = abs_x_boxes
) AT (-abs_width/2 + abs_width/20 + abs_width/10*6, 0, 0) RELATIVE arm_sample

REMOVABLE COMPONENT x_mat_7 = Union_make_material(
    absorber = 1,
    my_absorption = 80
) AT (0, 0, 0) RELATIVE arm_sample

REMOVABLE COMPONENT x_box_7 = Union_box(
    priority = 37,
    xwidth = abs_width/10 - abs_eps,
    yheight = abs_height,
    zdepth = abs_thick,
    material_string = "x_mat_7",
    number_of_activations = abs_x_boxes
) AT (-abs_width/2 + abs_width/20 + abs_width/10*7, 0, 0) RELATIVE arm_sample

REMOVABLE COMPONENT x_mat_8 = Union_make_material(
    absorber = 1,
    my_absorption = 90
) AT (0, 0, 0) RELATIVE arm_sample

REMOVABLE COMPONENT x_box_8 = Union_box(
    priority = 38,
    xwidth = abs_width/10 - abs_eps,
    yheight = abs_height,
    zdepth = abs_thick,
    material_string = "x_mat_8",
    number_of_activations = abs_x_boxes
) AT (-abs_width/2 + abs_width/20 + abs_width/10*8, 0, 0) RELATIVE arm_sample

REMOVABLE COMPONENT x_mat_9 = Union_make_material(
    absorber = 1,
    my_absorption = 100
) AT (0, 0, 0) RELATIVE arm_sample

REMOVABLE COMPONENT x_box_9 = Union_box(
    priority = 39,
    xwidth = abs_width/10 - abs_eps,
    yheight = abs_height,
    zdepth = abs_thick,
    material_string = "x_mat_9",
    number_of_activations = abs_x_boxes
) AT (-abs_width/2 + abs_width/20 + abs_width/10*9, 0, 0) RELATIVE arm_sample

// =================== Detectors

REMOVABLE COMPONENT abs_zx = Union_abs_logger_2D_space(
    D_direction_1 = "z", D1_min = -abs_thick/2, D1_max = abs_thick/2, n1 = 200,
      D_direction_2 = "x", D2_min = -abs_width/2, D2_max = abs_width/2, n2 = 200,
    filename = "abs_zx"
) AT (0, 0, 0) RELATIVE arm_sample

REMOVABLE COMPONENT Sample_environment = Union_master(
) AT (0, 0, 0) RELATIVE arm_sample

REMOVABLE COMPONENT trans_x = PSD_monitor(
    nx = 300,
    ny = 1,
    xwidth = 0.03,
    yheight = 0.03,
    filename = "trans_x",
    restore_neutron = 1
) AT (0, 0, 0.02) RELATIVE arm_sample

END
