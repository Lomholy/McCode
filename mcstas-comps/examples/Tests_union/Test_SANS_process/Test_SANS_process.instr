/*******************************************************************************
*         McStas instrument definition URL=http://www.mcstas.org
*
* Instrument: Test_SANS_process
*
* %Identification
* Written by: Daniel Lomholt Christensen
* Date: 29/09/2026
* Origin: Niels Bohr Institute @ UCPH
* %INSTRUMENT_SITE: Test_samples
*
* Compares the Union SANS_process with Sans_spheres and Sans_expr for dilute hard spheres
*
* %Description
* A small SANS instrument with interchangeable samples, all describing the same
* dilute monodisperse hard spheres (R = 100 AA, volume fraction 1e-2, excess
* scattering length density 5 fm/AA^3) in a 10x10x1 mm box:
*
*   sample_choice=0: Sans_spheres
*   sample_choice=1: Sans_expr
*   sample_choice=2: Union SANS_process with the form factor written in q
*   sample_choice=3: Union SANS_process with the form factor written in qx, qy, qz
*   sample_choice=4: Sans_expr with an anisotropic Gaussian form factor
*   sample_choice=5: Union SANS_process with the same anisotropic Gaussian
*
* Choices 0-3 should give the same intensity, and so should choices 4 and 5.
* Choices 4 and 5 check that qx, qy, qz are in the same frame in both components.
*
* The spheres scatter strongly (mu*l ~ 0.3), and Union also simulates multiple
* scattering, which Sans_spheres and Sans_expr do not. psd_det counts all
* scattered rays, while psd_det_single and q_det only count rays scattered
* exactly once, which is what choices 0-3 are compared on.
*
* %Example: sample_choice=0 Detector: psd_det_single_I=9.68036e+06
* %Example: sample_choice=1 Detector: psd_det_single_I=9.68036e+06
* %Example: sample_choice=2 Detector: psd_det_single_I=9.56954e+06
* %Example: sample_choice=3 Detector: psd_det_single_I=9.56954e+06
* %Example: sample_choice=4 Detector: psd_det_single_I=1.08252e+07
* %Example: sample_choice=5 Detector: psd_det_single_I=1.09268e+07
*
* %Parameters
* E_i: [meV] Energy of the simulated neutrons.
* sample_choice: [1] Sample to use: 0 Sans_spheres, 1 Sans_expr, 2 SANS_process (q), 3 SANS_process (qx, qy, qz), 4 Sans_expr anisotropic, 5 SANS_process anisotropic.
* flux_mult: [1] Factor multiplied onto the source flux.
*
* %Link
*
* %End
*******************************************************************************/
DEFINE INSTRUMENT Test_SANS_process(E_i=5, int sample_choice=0, flux_mult=0.5512)

DECLARE
%{
  double focus_w;
  double focus_h;
  double samp_w;
  double samp_h;
  double samp_d;
  double sphere_R;
  double sphere_phi;
  double sphere_drho;
  double sphere_scale;
  char form_factor[512];
  int scattered;
%}

INITIALIZE
%{
  focus_w = 1;
  focus_h = 1;
  samp_w = 0.01;
  samp_h = 0.01;
  samp_d = 0.001;
  sphere_R = 100;
  sphere_phi = 1e-2;
  sphere_drho = 5;
  /* Phi * Delta_rho^2 * V in fm^2/AA^3 = m^-1 */
  sphere_scale = sphere_phi * sphere_drho * sphere_drho * 4.0 * PI / 3.0 * pow (sphere_R, 3);
  if (sample_choice == 4 || sample_choice == 5)
    sprintf (form_factor, "exp(-((qx*60)^2+(qy*20)^2)/2)");
  else if (sample_choice == 3)
    sprintf (form_factor, "3*(sin(sqrt(qx^2+qy^2+qz^2)*p1)-sqrt(qx^2+qy^2+qz^2)*p1*cos(sqrt(qx^2+qy^2+qz^2)*p1))/(sqrt(qx^2+qy^2+qz^2)*p1)^3");
  else
    sprintf (form_factor, "3*(sin(q*p1)-q*p1*cos(q*p1))/(q*p1)^3");
%}

TRACE

COMPONENT Origin = Progress_bar()
  AT (0,0,0) ABSOLUTE
EXTEND %{
  scattered = 0;
%}

COMPONENT init = Union_init()
  AT (0,0,0) ABSOLUTE

COMPONENT source = Source_simple(
    radius = 0.05,
    dist = 10.495,
    focus_xw = samp_w,
    focus_yh = samp_h,
    E0 = E_i,
    dE = 0.475,
    flux = 1e14*flux_mult
) AT (0, 0, 0) RELATIVE Origin

COMPONENT post_source_slit = Slit(
    radius = 0.005
) AT (0, 0, 0.025) RELATIVE source

COMPONENT pre_samp_arm = Arm(
) AT (0, 0, 10.495) RELATIVE source

COMPONENT pre_samp_slit = Slit(
    radius = 0.005
) AT (0, 0, 0) RELATIVE pre_samp_arm

COMPONENT arm_sample = Arm(
) AT (0, 0, 0.005) RELATIVE pre_samp_arm

COMPONENT sans_spheres = Sans_spheres(
    R = sphere_R, Phi = sphere_phi, Delta_rho = sphere_drho, sigma_abs = 0,
    xwidth = samp_w, yheight = samp_h, zdepth = samp_d,
    focus_xw = focus_w, focus_yh = focus_h,
    target_index = 7
) WHEN (sample_choice == 0)
AT (0, 0, 0) RELATIVE arm_sample
EXTEND %{
  if (SCATTERED)
    scattered = 1;
%}

COMPONENT sans_expr = Sans_expr(
    form_factor = form_factor,
    structure_factor = "1",
    p1 = sphere_R, scale = sphere_scale, sigma_abs = 0,
    xwidth = samp_w, yheight = samp_h, zdepth = samp_d,
    focus_xw = focus_w, focus_yh = focus_h,
    target_index = 6
) WHEN (sample_choice == 1 || sample_choice == 4)
AT (0, 0, 0) RELATIVE arm_sample
EXTEND %{
  if (SCATTERED)
    scattered = 1;
%}

COMPONENT sans_proc = SANS_process(
    form_factor = form_factor,
    structure_factor = "1",
    p1 = sphere_R, scale = sphere_scale
) AT (0, 0, 0) RELATIVE arm_sample

COMPONENT sans_material = Union_make_material(
    my_absorption = 0,
    process_string = "sans_proc"
) AT (0, 0, 0) RELATIVE arm_sample

COMPONENT sans_box = Union_box(
    xwidth = samp_w, yheight = samp_h, zdepth = samp_d,
    priority = 1, material_string = "sans_material",
    focus_xw = focus_w, focus_xh = focus_h,
    target_index = 3
) AT (0, 0, 0) RELATIVE arm_sample

COMPONENT union_master = Union_master(
) WHEN (sample_choice == 2 || sample_choice == 3 || sample_choice == 5)
AT (0, 0, 0) RELATIVE arm_sample
EXTEND %{
  scattered = number_of_scattering_events;
%}

COMPONENT arm_det = Arm(
) AT (0, 0, 0) RELATIVE arm_sample

COMPONENT psd_det = PSD_monitor(
    nx = 200,
    ny = 200,
    filename = "psd_det",
    xwidth = 1,
    yheight = 1,
    restore_neutron = 1
) WHEN (scattered >= 1)
AT (0, 0, 5) RELATIVE arm_det

COMPONENT psd_det_single = PSD_monitor(
    nx = 200,
    ny = 200,
    filename = "psd_det_single",
    xwidth = 1,
    yheight = 1,
    restore_neutron = 1
) WHEN (scattered == 1)
AT (0, 0, 5) RELATIVE arm_det

COMPONENT q_det = Monitor_nD(
    xwidth = 1,
    yheight = 1,
    options = "square, kxy limits=[0 0.15] bins=150",
    filename = "q_det",
    restore_neutron = 1
) WHEN (scattered == 1)
AT (0, 0, 5) RELATIVE arm_det

COMPONENT stop = Union_stop()
AT (0, 0, 0) ABSOLUTE

END
