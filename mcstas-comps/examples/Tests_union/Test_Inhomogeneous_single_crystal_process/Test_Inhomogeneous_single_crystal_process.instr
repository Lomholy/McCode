/*******************************************************************************
*         McStas instrument definition URL=http://www.mcstas.org
*
* Instrument: Test_Inhomogeneous_single_crystal_process
*
* %Identification
* Written by: Daniel Lomholt Christensen
* Date: 29/09/2026
* Origin: Niels Bohr Institute @ UCPH
* %INSTRUMENT_SITE: Test_samples
*
* Compares Inhomogeneous_single_crystal_process with Single_crystal_process for aluminium
*
* %Description
* A 2-3 AA beam hits a 10x20x10 mm aluminium single crystal (Al_sg225.ncmat from the
* NCrystal data library), with mosaicity 30 arc minutes and delta_d_d 1e-4 (FWHM), in the
* orientation ROTATED (10, 20, 5). The scattered rays are recorded on 4pi spheres.
*
* The Single_crystal_process references read .lau files made by NCrystal from the same
* materials (see make_reference_files.sh), with the lattice vectors a along x and b in
* the xy plane, and are rotated with ROTATED (10, 20, 5). The inhomogeneous process
* uses rot_x = 10, rot_y = 20, rot_z = 5 instead, so every comparison also checks that
* its rotation matches ROTATED.
*
* Single_crystal_process references:
*   sample_choice=0:  Al, 300 K
*   sample_choice=14: Al, 600 K
*   sample_choice=12: Al, 300 K, anisotropic mosaicity 20, 30, 40 arc minutes around a, b, c
*   sample_choice=2:  Al at 300 K, with a higher priority box over x > 0 whose lattice
*                     parameter is 1% larger. The inner box is 20 um larger in y, z and +x,
*                     so no faces coincide.
*   sample_choice=4:  as 2, but the inner box has mosaicity 60 arc minutes
*   sample_choice=6:  as 2, but the inner box is rotated by ROTATED (10, 20, 7)
*   sample_choice=8:  as 2, but the inner box is at 600 K
*   sample_choice=10: as 2, but the inner box has gamma = 92 deg (lower symmetry)
*
* Inhomogeneous_single_crystal_process in one box:
*   sample_choice=1:  no templates or expressions depending on x, y, z, t; should equal 0
*   sample_choice=3:  lattice parameter steps by 1% at x = 0 (.ncmat template); should equal 2
*   sample_choice=5:  mosaicity steps from 30 to 60 arc minutes at x = 0; should equal 4
*   sample_choice=7:  rot_z steps from 5 to 7 deg at x = 0; should equal 6
*   sample_choice=9:  temperature steps from 300 to 600 K at x = 0 (cfg template); should equal 8
*   sample_choice=11: gamma steps from 90 to 92 deg at x = 0 (.ncmat template keeping
*                     @SPACEGROUP 225, which the process removes); should equal 10
*   sample_choice=13: anisotropic mosaicity 20, 30, 40 arc minutes; should equal 12
*   sample_choice=15: temperature steps from 300 to 600 K at time t0, the median arrival
*                     time; sphere_early should equal choice 0 and sphere_late choice 14
*
* The steps are resolved with 41 nodes over x in [-1, 1] mm and t in [0.97, 1.03] t0.
* Points outside these ranges use the nearest edge node, which is exact for a step.
*
* %Example: sample_choice=0 Detector: sphere_I=1.43602e-06
* %Example: sample_choice=1 Detector: sphere_I=1.43595e-06
* %Example: sample_choice=2 Detector: sphere_I=1.43225e-06
* %Example: sample_choice=3 Detector: sphere_I=1.43103e-06
* %Example: sample_choice=4 Detector: sphere_I=1.53265e-06
* %Example: sample_choice=5 Detector: sphere_I=1.53063e-06
* %Example: sample_choice=6 Detector: sphere_I=1.43797e-06
* %Example: sample_choice=7 Detector: sphere_I=1.43798e-06
* %Example: sample_choice=8 Detector: sphere_I=1.37915e-06
* %Example: sample_choice=9 Detector: sphere_I=1.37829e-06
* %Example: sample_choice=10 Detector: sphere_I=1.40734e-06
* %Example: sample_choice=11 Detector: sphere_I=1.40675e-06
* %Example: sample_choice=12 Detector: sphere_I=1.54232e-06
* %Example: sample_choice=13 Detector: sphere_I=1.54228e-06
* %Example: sample_choice=14 Detector: sphere_late_I=6.89854e-07
* %Example: sample_choice=15 Detector: sphere_early_I=6.9728e-07
* %Example: sample_choice=15 Detector: sphere_late_I=6.89854e-07
*
* %Parameters
* lambda0: [AA] Mean wavelength of the source.
* dlambda: [AA] Half width of the wavelength band.
* sample_choice: [1] Sample to use, see the description.
*
* %Link
*
* %End
*******************************************************************************/
DEFINE INSTRUMENT Test_Inhomogeneous_single_crystal_process(lambda0=2.5, dlambda=0.5, int sample_choice=0)

DECLARE
%{
  double samp_w;
  double samp_h;
  double samp_d;
  double t0;
  double a_al;
  double a_large;
  double gamma92;
  char hom_lau[256];
  double hom_a;
  double hom_mosaic;
  double hom_mosaic_abc;
  char inner_lau[256];
  double inner_a;
  double inner_bx;
  double inner_by;
  double inner_mosaic;
  double inner_rot_z;
  char inh_template[256];
  char inh_cfg[256];
  char inh_mosaic[64];
  char inh_mosaic_abc[3][16];
  char inh_rot_z[64];
  int scattered;
  double t_sample;
%}

INITIALIZE
%{
  samp_w = 0.01;
  samp_h = 0.02;
  samp_d = 0.01;
  /* Median arrival time at the sample, 10.5 m at the speed of lambda0 */
  t0 = 10.5 * lambda0 / 3956.0346;
  a_al = 4.04958;
  a_large = a_al * 1.01;
  gamma92 = 92 * DEG2RAD;

  sprintf (hom_lau, "%s", sample_choice == 14 ? "Al_600K.lau" : "Al_300K.lau");
  hom_a = a_al;
  hom_mosaic = sample_choice == 12 ? -1 : 30;
  hom_mosaic_abc = sample_choice == 12 ? 1 : -1;

  sprintf (inner_lau, "Al_300K.lau");
  inner_a = a_al;
  inner_bx = 0;
  inner_by = a_al;
  inner_mosaic = 30;
  inner_rot_z = 5;
  if (sample_choice == 2) {
    sprintf (inner_lau, "Al_a101_300K.lau");
    inner_a = a_large;
    inner_by = a_large;
  } else if (sample_choice == 4)
    inner_mosaic = 60;
  else if (sample_choice == 6)
    inner_rot_z = 7;
  else if (sample_choice == 8)
    sprintf (inner_lau, "Al_600K.lau");
  else if (sample_choice == 10) {
    sprintf (inner_lau, "Al_gamma92_300K.lau");
    inner_bx = a_al * cos (gamma92);
    inner_by = a_al * sin (gamma92);
  }

  sprintf (inh_template, "Al_sg225.ncmat");
  sprintf (inh_cfg, "temp=300K");
  sprintf (inh_mosaic, "30");
  sprintf (inh_mosaic_abc[0], "%s", "");
  sprintf (inh_mosaic_abc[1], "%s", "");
  sprintf (inh_mosaic_abc[2], "%s", "");
  sprintf (inh_rot_z, "5");
  if (sample_choice == 3)
    sprintf (inh_template, "Al_lattice_x.ncmat");
  else if (sample_choice == 5)
    sprintf (inh_mosaic, "hvs(x,0,60,30)");
  else if (sample_choice == 7)
    sprintf (inh_rot_z, "hvs(x,0,7,5)");
  else if (sample_choice == 9)
    sprintf (inh_cfg, "temp=${hvs(x,0,600,300)}K");
  else if (sample_choice == 11)
    sprintf (inh_template, "Al_angle_x.ncmat");
  else if (sample_choice == 13) {
    sprintf (inh_mosaic, "%s", "");
    sprintf (inh_mosaic_abc[0], "20");
    sprintf (inh_mosaic_abc[1], "30");
    sprintf (inh_mosaic_abc[2], "40");
  } else if (sample_choice == 15)
    sprintf (inh_cfg, "temp=${hvs(t,p3,600,300)}K");
%}

TRACE

COMPONENT Origin = Progress_bar()
  AT (0,0,0) ABSOLUTE
EXTEND %{
  scattered = 0;
%}

COMPONENT init = Union_init()
  AT (0,0,0) ABSOLUTE

COMPONENT source = Source_simple(
    radius = 0.02,
    dist = 10.5,
    focus_xw = samp_w,
    focus_yh = samp_h,
    lambda0 = lambda0,
    dlambda = dlambda,
    flux = 1
) AT (0, 0, 0) RELATIVE Origin

COMPONENT arm_sample = Arm(
) AT (0, 0, 10.5) RELATIVE source
EXTEND %{
  /* The Arm does not move the ray, so extrapolate to the sample plane */
  t_sample = t - z / vz;
%}

// Single_crystal_process in one box, sample_choice 0, 12, 14

COMPONENT hom_proc = Single_crystal_process(
    reflections = hom_lau, barns = 1, delta_d_d = 1e-4,
    mosaic = hom_mosaic, mosaic_a = 20 * hom_mosaic_abc, mosaic_b = 30 * hom_mosaic_abc, mosaic_c = 40 * hom_mosaic_abc,
    ax = hom_a, ay = 0, az = 0, bx = 0, by = hom_a, bz = 0, cx = 0, cy = 0, cz = hom_a
) AT (0, 0, 0) RELATIVE arm_sample
ROTATED (10, 20, 5) RELATIVE arm_sample

COMPONENT hom_material = Union_make_material(
    my_absorption = 0, process_string = "hom_proc"
) AT (0, 0, 0) RELATIVE arm_sample

COMPONENT hom_box = Union_box(
    xwidth = samp_w, yheight = samp_h, zdepth = samp_d,
    priority = 1, material_string = "hom_material"
) AT (0, 0, 0) RELATIVE arm_sample

COMPONENT hom_master = Union_master(
) WHEN (sample_choice == 0 || sample_choice == 12 || sample_choice == 14)
AT (0, 0, 0) RELATIVE arm_sample
EXTEND %{
  scattered = number_of_scattering_events;
%}

// Single_crystal_process with a different crystal at x > 0, sample_choice 2, 4, 6, 8, 10

COMPONENT outer_proc = Single_crystal_process(
    reflections = "Al_300K.lau", barns = 1, delta_d_d = 1e-4, mosaic = 30,
    ax = a_al, ay = 0, az = 0, bx = 0, by = a_al, bz = 0, cx = 0, cy = 0, cz = a_al
) AT (0, 0, 0) RELATIVE arm_sample
ROTATED (10, 20, 5) RELATIVE arm_sample

COMPONENT inner_proc = Single_crystal_process(
    reflections = inner_lau, barns = 1, delta_d_d = 1e-4, mosaic = inner_mosaic,
    ax = inner_a, ay = 0, az = 0, bx = inner_bx, by = inner_by, bz = 0, cx = 0, cy = 0, cz = inner_a
) AT (0, 0, 0) RELATIVE arm_sample
ROTATED (10, 20, inner_rot_z) RELATIVE arm_sample

COMPONENT outer_material = Union_make_material(
    my_absorption = 0, process_string = "outer_proc"
) AT (0, 0, 0) RELATIVE arm_sample

COMPONENT inner_material = Union_make_material(
    my_absorption = 0, process_string = "inner_proc"
) AT (0, 0, 0) RELATIVE arm_sample

COMPONENT outer_box = Union_box(
    xwidth = samp_w, yheight = samp_h, zdepth = samp_d,
    priority = 1, material_string = "outer_material"
) AT (0, 0, 0) RELATIVE arm_sample

COMPONENT inner_box = Union_box(
    xwidth = samp_w / 2 + 2e-5, yheight = samp_h + 2e-5, zdepth = samp_d + 2e-5,
    priority = 2, material_string = "inner_material"
) AT (samp_w / 4 + 1e-5, 0, 0) RELATIVE arm_sample

COMPONENT split_master = Union_master(
) WHEN (sample_choice == 2 || sample_choice == 4 || sample_choice == 6 || sample_choice == 8 || sample_choice == 10)
AT (0, 0, 0) RELATIVE arm_sample
EXTEND %{
  scattered = number_of_scattering_events;
%}

// Inhomogeneous_single_crystal_process in one box, sample_choice 1, 3, 5, 7, 9, 11, 13, 15

COMPONENT inh_proc = Inhomogeneous_single_crystal_process(
    ncmat_template = inh_template, cfg = inh_cfg,
    mosaic = inh_mosaic, mosaic_a = inh_mosaic_abc[0], mosaic_b = inh_mosaic_abc[1], mosaic_c = inh_mosaic_abc[2],
    delta_d_d = "1e-4", rot_x = "10", rot_y = "20", rot_z = inh_rot_z,
    p1 = a_al, p2 = a_large, p3 = t0,
    n_x = 41, x_min = -1e-3, x_max = 1e-3,
    n_t = 41, t_min = t0 * 0.97, t_max = t0 * 1.03
) AT (0, 0, 0) RELATIVE arm_sample

COMPONENT inh_material = Union_make_material(
    my_absorption = 0, process_string = "inh_proc"
) AT (0, 0, 0) RELATIVE arm_sample

COMPONENT inh_box = Union_box(
    xwidth = samp_w, yheight = samp_h, zdepth = samp_d,
    priority = 1, material_string = "inh_material"
) AT (0, 0, 0) RELATIVE arm_sample

COMPONENT inh_master = Union_master(
) WHEN (sample_choice == 1 || sample_choice == 3 || sample_choice == 5 || sample_choice == 7 || sample_choice == 9 || sample_choice == 11
        || sample_choice == 13 || sample_choice == 15)
AT (0, 0, 0) RELATIVE arm_sample
EXTEND %{
  scattered = number_of_scattering_events;
%}

COMPONENT sphere = PSD_monitor_4PI(
    nx = 180, ny = 90, radius = 1.5,
    filename = "sphere", restore_neutron = 1
) WHEN (scattered >= 1)
AT (0, 0, 0) RELATIVE arm_sample

COMPONENT sphere_early = PSD_monitor_4PI(
    nx = 180, ny = 90, radius = 1.5,
    filename = "sphere_early", restore_neutron = 1
) WHEN (scattered >= 1 && t_sample < t0)
AT (0, 0, 0) RELATIVE arm_sample

COMPONENT sphere_late = PSD_monitor_4PI(
    nx = 180, ny = 90, radius = 1.5,
    filename = "sphere_late", restore_neutron = 1
) WHEN (scattered >= 1 && t_sample >= t0)
AT (0, 0, 0) RELATIVE arm_sample

COMPONENT stop = Union_stop()
AT (0, 0, 0) ABSOLUTE

END
